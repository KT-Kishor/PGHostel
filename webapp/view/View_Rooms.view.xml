<mvc:View controllerName="sap.ui.com.project1.controller.View_Rooms"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:c="sap.ui.core"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:uxap="sap.uxap"
	xmlns:fb="sap.ui.comp.filterbar"
	displayBlock="true"
	height="100%"
	class="hideVendorReg"
	busyIndicatorDelay="0">
	<VBox height="100%">
		<Page
			showHeader="true"
			enableScrolling="true"
			class="RoomsPage roomsBgPage">
<layoutData>
    <FlexItemData growFactor="1" />
</layoutData>

			<headerContent >
				<core:Fragment
					fragmentName="sap.ui.com.project1.fragment.BookingHeader"
					type="XML" />
			</headerContent>
			<content>
				<uxap:ObjectPageLayout
					id="VR_id_ObjectPageLayout"
					useIconTabBar="false"
					showTitleInHeaderContent="true"
					class="vrObjectPageLayout roomsBgLayout">

					<uxap:headerTitle>
						<uxap:ObjectPageDynamicHeaderTitle visible="false">
							<uxap:expandedHeading>
								<HBox />
							</uxap:expandedHeading>
							<uxap:snappedHeading>
								<FlexBox
									fitContainer="true"
									alignItems="Center"
									class="vrSnappedHeader">
									<Avatar
										src="{= ${BranchModel>/Photo1} ? 'data:image/jpeg;base64,' + ${BranchModel>/Photo1} : '' }"
										initials="{= ${BranchModel>/Name} ? ${BranchModel>/Name}.charAt(0).toUpperCase() : '' }"
										displaySize="L"
										displayShape="Square"
										class="vrSquareAvatarSmall vrSnappedAvatar sapUiAvatarImageContain" />
									<VBox class="vrSnappedTitleBlock">
										<Title
											text="{BranchModel>/Name}"
											wrapping="true"
											class="vrHeaderTitle vrSnappedTitle" />
										<Text
											text="{BranchModel>/PropertyType}"
											class="vrHeaderSubtitle vrSnappedSubtitle" />
									</VBox>
								</FlexBox>
							</uxap:snappedHeading>
						</uxap:ObjectPageDynamicHeaderTitle>
					</uxap:headerTitle>

					<uxap:headerContent>
						<FlexBox
							wrap="Wrap"
							fitContainer="true"
							alignItems="Start"
							justifyContent="Start"
							class="sapUiTinyMarginTop vrHeaderRow">
							<HBox class="vrIdentityRow sapUiMediumMarginEnd sapUiSmallMarginBottom" alignItems="Start">
								<Avatar
									src="{= ${BranchModel>/Photo1} ? 'data:image/jpeg;base64,' + ${BranchModel>/Photo1} : '' }"
									initials="{= ${BranchModel>/Name} ? ${BranchModel>/Name}.charAt(0).toUpperCase() : '' }"
									displaySize="XL"
									displayShape="Square"
									class="vrSquareAvatarLarge sapUiMediumMarginEnd sapUiAvatarImageContain vrHeaderAvatar" />
								<VBox class="vrTitleBlock">
									<Title
										text="{BranchModel>/Name}"
										wrapping="true"
										class="vrHeaderTitle" />
									<Text
										text="{BranchModel>/PropertyType}"
										class="vrHeaderSubtitle sapUiTinyMarginTop" />
								</VBox>
							</HBox>
<VBox
    class="sapUiMediumMarginEnd sapUiSmallMarginBottom vrHeaderSection vrHeaderSectionPrimary"
>
    <HBox
        alignItems="Center"
        class="sapUiTinyMarginBottom vrHeaderFieldRow"
    >
        <Label
            text="{i18n>RoomEmail}"
            design="Bold"
            class="vrHeaderLabel"
        />
        <Link
            text="{BranchModel>/EmailID}"
            href="{= 'mailto:' + ${BranchModel>/EmailID} }"
            wrapping="true"
            class="vrHeaderValueLink tealTextLink"
        />
    </HBox>
    <HBox
        alignItems="Center"
        class="sapUiTinyMarginBottom vrHeaderFieldRow"
    >
        <Label
            text="{i18n>RoomContact}"
            design="Bold"
            class="vrHeaderLabel"
        />
        <Link
            text="{BranchModel>/STD} {BranchModel>/Contact}"
            href="{= 'tel:' + ${BranchModel>/Contact} }"
            wrapping="true"
            class="vrHeaderValueLink tealTextLink"
        />
    </HBox>
    <HBox
        alignItems="Center"
        class="sapUiTinyMarginBottom vrHeaderFieldRow"
        visible="{= !!${BranchModel>/GSTIN} }"
    >
        <Label
            text="{i18n>RoomGSTIN}"
            design="Bold"
            class="vrHeaderLabel"
        />
        <Text
            text="{BranchModel>/GSTIN}"
            class="vrHeaderValueText tealTextLink"
        />
    </HBox>
</VBox>

							<VBox class="sapUiSmallMarginBottom vrHeaderSection vrHeaderSectionSecondary">
								<HBox alignItems="Center" class="sapUiTinyMarginBottom vrHeaderFieldRow">
									<Label text="{i18n>RoomAddress}" design="Bold" class="vrHeaderLabel" />
									<Link
										text="{BranchModel>/Address}"
										href="{BranchModel>/GeoLocation}"
										target="_blank"
										wrapping="true"
										class="vrHeaderValueLink tealTextLink" />
								</HBox>
								<HBox alignItems="Center" class="sapUiTinyMarginBottom vrHeaderFieldRow vrRatingRow">
									<Label text="{i18n>UserRating}" design="Bold" class="vrHeaderLabel" />
									<HBox id="VR_id_RatingClickable" alignItems="Center" class="vrHeaderValueBox vrRatingClickable">
										<RatingIndicator
											value="{= Number(${VisibilityModel>/AverageRating}) || 0 }"
											maxValue="5"
										    editable="false"
 										    enabled="true"
											iconSize="1.1rem"
											class="vrRatingStars sapUiTinyMarginEnd" />
										<Text
											text="{= '(' + (${VisibilityModel>/TotalFeedbacks} || 0) + ')' }"
											class="vrRatingCount" />
									</HBox>
								</HBox>
							</VBox>
						</FlexBox>
					</uxap:headerContent>

					<uxap:sections>
						<uxap:ObjectPageSection
							id="VR_id_DateFilterSection"
							title=""
							titleUppercase="false"
							class="vrDateFilterSection vrRoomsSidebarSection"
						>
							<uxap:subSections>
								<uxap:ObjectPageSubSection id="VR_id_DateFilterSubSection">
									<uxap:blocks>
										<VBox
											id="VR_id_RoomsSidebar"
											width="300px"
											renderType="Bare"
											class="stickyFilterContainer roomsFilterAdSection vrRoomsSidebar"
										>
										<Title
											text="{i18n>searchByDate}"
											level="H4"
											class="roomsFilterTitle vrDateFilterTitle"
										/>
										<fb:FilterBar
											id="VR_id_DateFilterBar"
											persistencyKey="viewRoomsDateFilter"
											useToolbar="false"
											clear="onClearRoomDateFilter"
											showClearOnFB="true"
											search="onApplyRoomDateFilter"
											showFilterConfiguration="false"
											filterContainerWidth="100%"
											class="sapUiContentPadding HostelRooms filterBarTheme vrRoomDateFilterBar"
											busyIndicatorDelay="0"
										>
											<fb:filterGroupItems>
												<fb:FilterGroupItem
													name="StartDate"
													label="{i18n>CheckinDate}"
													groupName="Group1"
													visibleInFilterBar="true"
												>
													<fb:control>
														<DatePicker
															id="VR_id_StartDate"
															value="{RoomFilterModel>/StartDate}"
															displayFormat="dd/MM/yyyy"
											valueFormat="yyyy-MM-dd"
															minDate="{RoomFilterModel>/TodayDate}"
															change="onRoomFilterDateChange"
															busy="{VisibilityModel>/isLoading}"
															busyIndicatorDelay="0"
															width="100%"
														/>
													</fb:control>
												</fb:FilterGroupItem>
												<fb:FilterGroupItem
													name="EndDate"
													label="{i18n>CheckoutDate}"
													groupName="Group1"
													visibleInFilterBar="true"
												>
													<fb:control>
														<DatePicker
															id="VR_id_EndDate"
															value="{RoomFilterModel>/EndDate}"
															displayFormat="dd/MM/yyyy"
											valueFormat="yyyy-MM-dd"
															minDate="{RoomFilterModel>/EndDateMinDate}"
															change="onRoomFilterDateChange"
															busy="{VisibilityModel>/isLoading}"
															busyIndicatorDelay="0"
															width="100%"
														/>
													</fb:control>
												</fb:FilterGroupItem>
											</fb:filterGroupItems>
										</fb:FilterBar>

										<VBox
											id="VR_id_AdWrap"
											renderType="Bare"
											class="roomsAdWrap"
										>
											<Title
												text="{i18n>advertisements}"
												class="roomsAdTitle"
											/>
											<Panel
												class="adPanel"
												busy="{AdvertisementModel>/isLoading}"
												busyIndicatorDelay="0"
											>
												<VBox class="sapUiTinyMargin">
													<Carousel
														id="AdvertisementCarouselEven"
														height="215px"
														showPageIndicator="false"
														arrowsPlacement="Content"
														loop="true"
														pages="{
															path: 'AdvertisementModel>/Advertisements',
															filters: [{ path: 'positionParity', operator: 'EQ', value1: 'Even' }],
															templateShareable: false
														}"
													>
														<pages>
															<Image
																src="{AdvertisementModel>image}"
																alt="{AdvertisementModel>title}"
																width="100%"
																height="100%"
																press="onAdvertisementImagePress"
															/>
														</pages>
													</Carousel>
												</VBox>
											</Panel>
											<Panel
												class="adPanel vrAdPanelGap"
												busy="{AdvertisementModel>/isLoading}"
												busyIndicatorDelay="0"
											>
												<VBox class="sapUiTinyMargin">
													<Carousel
														id="AdvertisementCarouselOdd"
														height="215px"
														showPageIndicator="false"
														arrowsPlacement="Content"
														loop="true"
														pages="{
															path: 'AdvertisementModel>/Advertisements',
															filters: [{ path: 'positionParity', operator: 'EQ', value1: 'Odd' }],
															templateShareable: false
														}"
													>
														<pages>
															<Image
																src="{AdvertisementModel>image}"
																alt="{AdvertisementModel>title}"
																width="100%"
																height="100%"
																press="onAdvertisementImagePress"
															/>
														</pages>
													</Carousel>
												</VBox>
											</Panel>
										</VBox>
										</VBox>
									</uxap:blocks>
								</uxap:ObjectPageSubSection>
							</uxap:subSections>
						</uxap:ObjectPageSection>

						<uxap:ObjectPageSection
							id="VR_id_ACSection"
							title="{i18n>ACRooms}"
							titleUppercase="false"
							class="vrRoomContentSection"
							visible="{= ${VisibilityModel>/isDataLoaded} &amp;&amp; ${VisibilityModel>/ACRooms}.length > 0 }">
							<uxap:subSections>
								<uxap:ObjectPageSubSection
									id="VR_id_ACSubSection"
									visible="{= ${VisibilityModel>/isDataLoaded} &amp;&amp; ${VisibilityModel>/ACRooms}.length > 0 }">
									<uxap:blocks>
										<VBox width="100%">
													<l:Grid
														id="idBedTypeFlex2"
														defaultSpan="XL4 L4 M6 S12"
														containerQuery="true"
														hSpacing="0"
														vSpacing="0"
														class="vrRoomCardsGrid"
														content="{path: 'VisibilityModel>/ACRooms'}"
													>
														<VBox class="bedCard">
															<Carousel
																height="300px"
																width="100%"
																loop="true"
																showPageIndicator="false"
																backgroundDesign="Transparent"
																class="roomCardCarousel"
																pages="{path: 'VisibilityModel>Images', templateShareable: false}"
															>
																<pages>
																	<VBox class="imageWrapper">
																		<HBox class="areaTagBox">
																			<core:Icon
																				src="sap-icon://building"
																				size="0.9rem"
																				color="black"
																				class="sapUiTinyMarginEnd"
																			/>
																			<Text text="{VisibilityModel>Area}" />
																		</HBox>
																		<Image
																			src="{VisibilityModel>src}"
																			width="100%"
																			height="300px"
																			class="bedCardImage"
																			decorative="false"
																		/>
																	</VBox>
																</pages>
															</Carousel>
															<VBox class="bedCardContent">
																<Text
																	text="{= ${VisibilityModel>Name} + ' (' + ${VisibilityModel>ACType} + ')' }"
																	class="bedCardTitle"
																/>
																<Text
																	text="{VisibilityModel>Description}"
																	class="bedCardDesc"
																	maxLines="4"
																	wrapping="true"
																/>
																<Text
																	text="{
																		parts: ['VisibilityModel>Currency','VisibilityModel>BasicPrice'],
																		formatter: '.Formatter.formatStartingPrice'
																	}"
																	class="bedCardPrice"
																/>
																<HBox justifyContent="Center" alignItems="Center" class="sapUiTinyMarginTop">
																	<Link
																		text="{= ${VisibilityModel>Visible} ? ${i18n>bookRoom} : ${i18n>occupied} }"
																		enabled="{VisibilityModel>Visible}"
																		press="onViewDetailsPress"
																		class="pillActionBtn pillLeft"
																	/>
																	<Link
																		text="{i18n>enquiry}"
																		press="onEnquiryPress"
																		class="pillActionBtn pillRight"
																	/>
																</HBox>
															</VBox>
													</VBox>
												</l:Grid>
									</VBox>
									</uxap:blocks>
								</uxap:ObjectPageSubSection>
							</uxap:subSections>
						</uxap:ObjectPageSection>

						<uxap:ObjectPageSection
							id="VR_id_NonACSection"
							title="{i18n>NonACRooms}"
							titleUppercase="false"
							class="vrRoomContentSection"
							visible="{= ${VisibilityModel>/isDataLoaded} &amp;&amp; ${VisibilityModel>/NonACRooms}.length > 0 }">
							<uxap:subSections>
								<uxap:ObjectPageSubSection
									id="VR_id_NonACSubSection"
									visible="{= ${VisibilityModel>/isDataLoaded} &amp;&amp; ${VisibilityModel>/NonACRooms}.length > 0 }">
									<uxap:blocks>
										<VBox width="100%">
													<l:Grid
														id="idBedTypeFlex1"
														defaultSpan="XL4 L4 M6 S12"
														containerQuery="true"
														hSpacing="0"
														vSpacing="0"
														class="vrRoomCardsGrid"
														content="{path: 'VisibilityModel>/NonACRooms'}"
													>
														<VBox class="bedCard">
															<Carousel
																height="300px"
																width="100%"
																loop="true"
																showPageIndicator="false"
																backgroundDesign="Transparent"
																class="roomCardCarousel"
																pages="{path: 'VisibilityModel>Images', templateShareable: false}"
															>
																<pages>
																	<VBox class="imageWrapper">
																		<HBox class="areaTagBox">
																			<core:Icon
																				src="sap-icon://building"
																				size="0.9rem"
																				color="black"
																				class="sapUiTinyMarginEnd"
																			/>
																			<Text text="{VisibilityModel>Area}" />
																		</HBox>
																		<Image
																			src="{VisibilityModel>src}"
																			width="100%"
																			height="300px"
																			class="bedCardImage"
																			decorative="false"
																		/>
																	</VBox>
																</pages>
															</Carousel>
															<VBox class="bedCardContent">
																<Text
																	text="{= ${VisibilityModel>Name} + ' (' + ${VisibilityModel>ACType} + ')' }"
																	class="bedCardTitle"
																/>
																<Text
																	text="{VisibilityModel>Description}"
																	class="bedCardDesc"
																	maxLines="4"
																	wrapping="true"
																/>
																<Text
																	text="{
																		parts: ['VisibilityModel>Currency','VisibilityModel>BasicPrice'],
																		formatter: '.Formatter.formatStartingPrice'
																	}"
																	class="bedCardPrice"
																/>
																<HBox justifyContent="Center" alignItems="Center" class="sapUiTinyMarginTop">
																	<Link
																		text="{= ${VisibilityModel>Visible} ? ${i18n>bookRoom} : ${i18n>occupied} }"
																		enabled="{VisibilityModel>Visible}"
																		press="onViewDetailsPress"
																		class="pillActionBtn pillLeft"
																	/>
																	<Link
																		text="{i18n>enquiry}"
																		press="onEnquiryPress"
																		class="pillActionBtn pillRight"
																	/>
																</HBox>
															</VBox>
													</VBox>
												</l:Grid>
									</VBox>
									</uxap:blocks>
								</uxap:ObjectPageSubSection>
							</uxap:subSections>
						</uxap:ObjectPageSection>

						<uxap:ObjectPageSection
							id="VR_id_NoDataSection"
							title=""
							titleUppercase="false"
							class="vrRoomContentSection vrNoDataSection"
							visible="{= ${VisibilityModel>/isDataLoaded} &amp;&amp; ${VisibilityModel>/NonACRooms}.length === 0 &amp;&amp; ${VisibilityModel>/ACRooms}.length === 0 }">
							<uxap:subSections>
								<uxap:ObjectPageSubSection id="VR_id_NoDataSubSection">
									<uxap:blocks>
										<VBox
											width="100%"
											height="300px"
											justifyContent="Center"
											alignItems="Center"
											visible="{= ${VisibilityModel>/isDataLoaded} &amp;&amp; ${VisibilityModel>/NonACRooms}.length === 0 &amp;&amp; ${VisibilityModel>/ACRooms}.length === 0 }">
											<Text text="{i18n>noRoomsFound}" class="cssNoDataMessage" />
											<Text text="{i18n>pleaseselectanotherCity}" class="cssNoDataSubMessage" />
										</VBox>
									</uxap:blocks>
								</uxap:ObjectPageSubSection>
							</uxap:subSections>
						</uxap:ObjectPageSection>
						<uxap:ObjectPageSection
							id="VR_id_FooterSection"
							title=""
							titleUppercase="false"
							class="vrFooterSection">
							<uxap:subSections>
								<uxap:ObjectPageSubSection id="VR_id_FooterSubSection">
									<uxap:blocks>
										<VBox class="footer-shell">
											<core:Fragment
												fragmentName="sap.ui.com.project1.fragment.quicklinks"
												type="XML" />
										</VBox>
									</uxap:blocks>
								</uxap:ObjectPageSubSection>
							</uxap:subSections>
						</uxap:ObjectPageSection>
					</uxap:sections>
				</uxap:ObjectPageLayout>
			</content>
		</Page>
	</VBox>
</mvc:View>

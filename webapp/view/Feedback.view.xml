    <mvc:View controllerName="sap.ui.com.project1.controller.Feedback"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m"
        xmlns:f="sap.ui.layout.form"
        xmlns:core="sap.ui.core"
        displayBlock="true">
        <Page title="{i18n>feedbackPageTitle}"
            showHeader="true"
            enableScrolling="true"
            class="feedbackPageWrapper sapUiNoContentPadding"
            navButtonPress="BI_onButtonPress"
            showNavButton="true"
        >
            <content>
             <VBox class="Feedbackpage">
                <VBox class="sapUiSmallMargin">
                    <Title text="{i18n>feedbackStayQuestion}"
                        level="H2" wrapping="true"
                        class="custom-feedback sapUiTinyMarginBottom heroFeedBox"
                    />
                    <VBox class="feedbackFormContainer  ">
                        <f:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="3"
                        labelSpanM="4"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                    >
                            <f:content>
                                <!-- Ratings Section -->
                                <Title text="{i18n>feedbackRatingPrompt}" wrapping="true"
                                titleStyle="H4" level="H4" class="sapUiSmallMarginBottom"/>
                                <Label
                                text="{i18n>feedbackOverallLabel}"
                                required="true"
                            />
                                <RatingIndicator
                                id="ratingOverall"
                                maxValue="5"
                                value="0"
                                iconSize="1.5rem"
                                change="onOverallRatingChange"
                            />
                                <Label
                                text="{i18n>feedbackCleanlinessLabel}"
                                required="true"
                            />
                                <RatingIndicator
                                id="ratingCleanliness"
                                maxValue="5"
                                value="0"
                                iconSize="1.5rem"
                                change="onCleanlinessRatingChange"
                            />
                                <Label
                                text="{i18n>feedbackStaffLabel}"
                                required="true"
                            />
                                <RatingIndicator
                                id="ratingStaff"
                                maxValue="5"
                                value="0"
                                iconSize="1.5rem"
                                change="onStaffRatingChange"
                            />
                                <Label
                                text="{i18n>feedbackAmenitiesLabel}"
                                required="true"
                            />
                                <RatingIndicator
                                id="ratingAmenities"
                                maxValue="5"
                                value="0"
                                iconSize="1.5rem"
                                change="onAmenitiesRatingChange"
                            />

                                <Label
                                text="{i18n>feedbackValueLabel}"
                                required="true"
                            />
                                <RatingIndicator
                                id="ratingValue"
                                maxValue="5"
                                value="0"
                                iconSize="1.5rem"
                                change="onValueRatingChange"
                                class="sapUiSmallMarginBottom"

                            />
                                <Label
                                text="{i18n>feedbackRecommendQuestion}"
                                required="true" 
                            />
                                <RadioButtonGroup
                                id="rgRecommend"
                                columns="2"
                                select="onRecommendChange"
                            >

                                    <buttons>
                                        <RadioButton
                                        id="rbYes"
                                        text="{i18n>yes}"
                                    />
                                        <RadioButton
                                        id="rbNo"
                                        text="{i18n>no}"
                                    />
                                    </buttons>
                                </RadioButtonGroup>
                                <Label text="{i18n>feedbackVisitAgainQuestion}" />
                                <RadioButtonGroup
                                id="rgVisitAgain"
                                columns="2"
                                select="onVisitAgainChange"
                            >
                                    <buttons>
                                        <RadioButton
                                        id="rbAgainYes"
                                        text="{i18n>yes}"
                                    />
                                        <RadioButton
                                        id="rbAgainNo"
                                class="sapUiTinyMarginBottom"
                                        text="{i18n>no}"
                                    />
                                    </buttons>
                                </RadioButtonGroup>


                                <Label text="{i18n>feedbackAdditionalComments}" />
                                <TextArea
                                id="feedbackComments"
                                width="100%"
                                rows="3"
                                placeholder="{i18n>feedbackCommentsPlaceholder}"
                                growing="true"
                                liveChange="onCommentsChange"
                                class="sapUiSmallMarginBottom"
                                maxLength="300"
                            />
                                <Label text=""/>
                                <Button
                        text="{i18n>feedbackSubmit}"
                        class="myUnifiedBtn"
                        type="Emphasized"
                        press="onSubmitFeedback"
                    />
                                <Button
                        text="{i18n>actionCancel}"
                        press="BI_onButtonPress"
                        class="myUnifiedBtn"
                    />
                            </f:content>
                        </f:SimpleForm>
                    </VBox>
                </VBox>
             </VBox>
            </content>
        </Page>
    </mvc:View>

<mvc:View
    controllerName="sap.ui.com.project1.controller.Hostel"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:svm="sap.ui.comp.smartvariants"
    height="100%"
    busyIndicatorDelay="0"
>
    <tnt:ToolPage class="sapUiTinyMarginTop">
        <tnt:header>
            <tnt:ToolHeader>
                <Image
                    src="./image/3 log 1.0.png"
                    height="110px"
                    tooltip="{i18n>companyLogo}"
                    class="sapUiSmallMarginTop"
                />
                <!-- <Title level="H1" text="SHAH HOSTEL" class="custom-text"/> -->
                <ToolbarSpacer />
                <Button
                    text="{i18n>sIGNINUP}"
                    id="loginButton"
                    tooltip="{i18n>signInorSignUp}"
                    class="sapUiSmallMarginTop loginButton"
                    press="onpressLogin"
                    visible="{= !${UIModel>/isLoggedIn} }"
                >
                    <layoutData>
                        <OverflowToolbarLayoutData priority="NeverOverflow" />
                    </layoutData>
                </Button>
                <Avatar
                    visible="{UIModel>/isLoggedIn}"
                    id="ProfileAvatar"
                    src="{LoginModel>/Photo}"
                    initials="{= ${LoginModel>/EmployeeName} ? ${LoginModel>/EmployeeName}.charAt(0).toUpperCase() : '' }"
                    tooltip="{= ${LoginModel>/UserName} || ${i18n>profilePic} }"
                    press="onPressAvatar"
                    class="profileAvatar"
                />
            </tnt:ToolHeader>
        </tnt:header>
        <tnt:subHeader>
            <tnt:ToolHeader>
                <!-- <ToolbarSpacer /> -->
                <IconTabHeader
                    id="mainTabHeader"
                    select="onTabSelect"
                >
                    <items>
                        <IconTabFilter
                            key="idHome"
                            tooltip="{i18n>home}"
                            text="{i18n>home}"
                        />
                        <IconTabFilter
                            key="idRooms"
                            tooltip="{i18n>rooms}"
                            text="{i18n>rooms}"
                        />
                        <!-- <IconTabFilter key="idFacilities" text="Facilities" /> -->
                        <IconTabFilter
                            key="idContact"
                            tooltip="{i18n>contact}"
                            text="{i18n>contact}"
                        />
                        <!-- <IconTabFilter key="idAdddata" text="Add Data"/> -->
                    </items>
                </IconTabHeader>
            </tnt:ToolHeader>
        </tnt:subHeader>
        <tnt:mainContents>
            <VBox
                height="100%"
                renderType="Bare"
                justifyContent="Start"
            >
                <items>
                    <NavContainer
                        id="pageContainer"
                        height="auto"
                    >
                        <!-- <layoutData>
	<FlexItemData growFactor="1" baseSize="0" />
</layoutData> -->
                        <layoutData>
                            <FlexItemData growFactor="1" />
                        </layoutData>
                        <pages>
                             <Page
                                id="idHome"

                                showHeader="false"
                                enableScrolling="true"
                            >
                            <ScrollContainer
                                horizontal="false"
                                vertical="true"
                                class="sapUiContentPadding Homepage sapUiTinyMargin"
                            >
                                <l:Grid
                                    defaultSpan="XL12 L12 M12 S12"
                                    width="100%"
                                    class="position-welcome fullHeightGrid"
                                >
                                    <VBox class="heroTextBox">
                                        <Text
                                            class="custom-welcome"
                                            text="{i18n>welcomeTo}"
                                        />
                                        <Text
                                            class="custom-welcome"
                                            text="{i18n>companynameKT}"
                                        />
                                        <Text
                                            class="custom-tagline"
                                            text="{i18n>yourNewHomeAwayFromHome}"
                                        />
                                    </VBox>

                                    <!-- <Button text="Explore Now" tooltip="Book Room" class="exploreBtn  sapUiLargeMarginBegin " press="onpressBookrooms" /> -->
                                    <HBox
                                        id="exploreWrapper"
                                        width="100%"
                                        class="exploreBtnWrapper explore-enter"
                                    >
                                        <Button
                                            text="{i18n>exploreNow}"
                                            class="exploreBtn"
                                            press="onpressBookrooms"
                                        />
                                    </HBox>
                                </l:Grid>
                                
                            </ScrollContainer>
                  
                            
<!-- Find the Right Stay - Single Card -->
<!-- <VBox class="stayMainCard" width="100%"> -->


<VBox class="stayTypesMainCard" width="100%">

  
   <FormattedText
    htmlText="Find the right &lt;strong&gt;stay&lt;/strong&gt; for you"
    class="stayTypesTitle"/>

    <Text
        text="Hotels, hostels, PGs, service apartments and rented apartments, all in one place."
        class="stayTypesDescription"/>

   <FlexBox
    width="100%"
    wrap="Wrap"
    justifyContent="SpaceAround"
    alignItems="Center"
    class="stayTypesFlex">

    <Button
        id="btnHotels"
        text="Hotels"
        icon="sap-icon://building"
        press="onStayTypePress"
        class="stayTypeButton selected-stay-btn myUnifiedBtn"/>

    <Button
        id="btnHostels"
        text="Hostels"
        icon="sap-icon://group"
        press="onStayTypePress"
        class="stayTypeButton myUnifiedBtn"/>

    <Button
        id="btnPG"
        text="PG"
        icon="sap-icon://home"
        press="onStayTypePress"
        class="stayTypeButton myUnifiedBtn"/>

    <Button
        id="btnServiceApartments"
        text="Service Apartments"
        icon="sap-icon://building"
        press="onStayTypePress"
        class="stayTypeButton myUnifiedBtn serviceApartmentsBtn"/>

    <Button
        id="btnRentedApartments"
        text="Rented Apartments"
        icon="sap-icon://key"
        press="onStayTypePress"
        class="stayTypeButton myUnifiedBtn serviceApartmentsBtn"/>

</FlexBox>

<!-- Lower Section Container -->
<!-- Lower Section Container -->
   <HBox  

   width="100%" class="stayDetailsContainer" binding="{view>/currentStay}">

        <!-- Left Graphic Card -->
        <VBox class="hotelPreviewCard">
            <!-- Top Badge -->
            <HBox class="hotelCardBadge">
                <core:Icon src="{view>icon}" class="badgeIcon"/>
                <Text text="{view>badge}" class="badgeText"/>
            </HBox>

            <!-- Center Icon -->
            <VBox class="hotelCardIconWrapper" justifyContent="Center" alignItems="Center">
                <core:Icon src="{view>icon}" class="hotelCardMainIcon"/>
            </VBox>

            <!-- Bottom Graphic Area -->
            <VBox class="hotelCardBottom" alignItems="Center" justifyContent="Center">
                <VBox class="skeletonLineLong"/>
                <VBox class="skeletonLineShort"/>

                <Text text="Starting at INR —" class="hotelPriceText"/>

                <Button text="View Rooms" class="myUnifiedBtn "/>
            </VBox>
        </VBox>

        <!-- Right Content Area -->
        <VBox class="hotelDetailsContent" width="100%">
            <!-- Title & Subtitle -->
            <Title text="{view>id}" level="H2" class="hotelDetailTitle"/>
            <Text text="{view>blurb}" class="hotelDetailSubtitle"/>

            <!-- BEST FOR Section -->
            <Label text="BEST FOR" class="sectionHeaderLabel"/>
            <HBox class="tagsContainer" items="{view>best}">
                <Text text="{view>}" class="stayTag"/>
            </HBox>

            <!-- WHAT YOU'LL SEE Section -->
            <Label text="WHAT YOU'LL SEE BEFORE YOU BOOK" class="sectionHeaderLabel"/>
            <VBox class="featureList" items="{view>see}">
                <HBox alignItems="Center" class="featureItem">
                    <core:Icon src="sap-icon://accept" class="featureIconround"/>
                    <Text text="{view>}" class="featureText"/>
                </HBox>
            </VBox>

            <!-- Action Button -->
            <Button text="Browse {view>id}" press="onBrowseHotelsPress" class="myUnifiedBtn browscss"/>
        </VBox>

    </HBox>
</VBox>

<VBox class="whyBookMainCard" width="100%">

    <!-- Header Section -->
    <FormattedText htmlText="Why Book With &lt;strong&gt;StayVriksha&lt;/strong&gt;?"  class="stayTypesTitle"/>
    <Text text="Simple, clear and built around guests." class="stayTypesDescription"/>

   

    <!-- Responsive FlexBox Grid -->
    <FlexBox width="100%" wrap="Wrap" justifyContent="Center" class="featuresFlexGrid">

        <!-- Item 1: Easy Booking -->
        <VBox class="featureGridItem" alignItems="Center" justifyContent="Center">
            <core:Icon src="sap-icon://calendar" class="featureGridIcon"/>
            <Title text="Easy Booking" level="H3" class="featureGridTitle"/>
            <Text text="Search by city, property type and locality, compare rooms and book in a few taps." class="featureGridDesc" textAlign="Center"/>
        </VBox>

        <!-- Item 2: Transparent Prices -->
        <VBox class="featureGridItem Transparenttext" alignItems="Center" justifyContent="Center" >
            <core:Icon src="sap-icon://money-bills" class="featureGridIcon"/>
            <Title text="Transparent Prices" level="H3" class="featureGridTitle"/>
            <Text text="See the starting price up front. Taxes and platform charges are shown before you pay." class="featureGridDesc" textAlign="Center"/>
        </VBox>

        <!-- Item 3: Clear Refund Rules -->
        <VBox class="featureGridItem" alignItems="Center" justifyContent="Center">
            <core:Icon src="sap-icon://refresh" class="featureGridIcon"/>
            <Title text="Clear Refund Rules" level="H3" class="featureGridTitle"/>
            <Text text="Every listing shows its cancellation and refund policy before you confirm." class="featureGridDesc" textAlign="Center"/>
        </VBox>

        <!-- Item 4: Support That Helps -->
        <VBox class="featureGridItem" alignItems="Center" justifyContent="Center">
            <core:Icon src="sap-icon://headset" class="featureGridIcon"/>
            <Title text="Support That Helps" level="H3" class="featureGridTitle"/>
            <Text text="Raise a request any time and our team will help with bookings, issues and refunds." class="featureGridDesc" textAlign="Center"/>
        </VBox>

        <!-- Item 5: Deals & Coupons -->
        <VBox class="featureGridItem" alignItems="Center" justifyContent="Center">
            <core:Icon src="sap-icon://sales-order-item" class="featureGridIcon"/>
            <Title text="Deals &amp; Coupons" level="H3" class="featureGridTitle"/>
            <Text text="Apply coupons on hotels, hostels, PGs and apartments and save on your stay." class="featureGridDesc" textAlign="Center"/>
        </VBox>

    </FlexBox>

</VBox>
<VBox class="bookingStepsSection" width="100%">

    <!-- Heading -->
    <VBox class="bookingStepsHeader" alignItems="Center">
        <Title
            text="Book in three steps"
            level="H2"
            class="bookingStepsTitle"/>

        <Text
            text="From search to confirmation, no hassle."
            class="bookingStepsSubtitle"/>
    </VBox>

    <!-- Three Cards -->
    <HBox
        class="bookingStepsContainer"
        width="100%"
        alignItems="Stretch"
        justifyContent="SpaceBetween"
        wrap="Wrap">

        <!-- Step 1 -->
        <VBox class="bookingStepCard" width="32%">
            <Text text="1" class="bookingStepNumber"/>
            <Title text="Search" level="H4" class="bookingStepCardTitle"/>
            <Text
                text="Choose your city, property type, property name or locality, then tap Go."
                class="bookingStepDescription"/>
        </VBox>

        <!-- Step 2 -->
        <VBox class="bookingStepCard" width="32%">
            <Text text="2" class="bookingStepNumber"/>
            <Title text="Compare &amp; choose" level="H4" class="bookingStepCardTitle"/>
            <Text
                text="View rooms, amenities, starting prices, house rules and the cancellation policy."
                class="bookingStepDescription"/>
        </VBox>

        <!-- Step 3 -->
        <VBox class="bookingStepCard" width="32%">
            <Text text="3" class="bookingStepNumber"/>
            <Title text="Book &amp; stay" level="H4" class="bookingStepCardTitle"/>
            <Text
                text="Confirm your booking, keep your confirmation and reference number, and enjoy your stay."
                class="bookingStepDescription"/>
        </VBox>

    </HBox>
</VBox>
<VBox class="aboutUsContainer" width="100%">
        
        <!-- Inner Responsive Splitter / Container using HBox with wrap -->
        <HBox class="aboutUsInner" width="100%" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
            
            <!-- Left Side: Information & CTAs -->
            <VBox class="aboutContent" width="48%">
                <Text text="ABOUT US" class="aboutTag"/>
                <Title text="India’s first booking platform for every kind of stay" level="H1" class="aboutTitle"/>
                <Text text="StayVriksha brings hotels, hostels, PGs, service apartments and rented apartments together in one place, so guests can find and book with confidence." class="aboutDescription"/>
                <Text text="For property owners, we provide an end-to-end solution to advertise properties and manage branches, rooms, beds, bookings, invoices, staff and reviews." class="aboutDescription"/>
                
                <!-- Action Buttons -->
                <HBox class="aboutActions"   width="100%"
    alignItems="Center"
    justifyContent="Start"
    wrap="Wrap" >
                    <Button text="Learn more" type="Emphasized" class="btnPrimary" press="onUsermanualPress"/>
                    <Button text="Contact us" type="Default" class="btnOutline" press="onfootercontacttabselect"/>
                </HBox>
            </VBox>

            <!-- Right Side: 2x2 Feature Cards Grid -->
            <VBox class="featuresGrid" width="48%">
                
                <!-- Row 1 -->
                <HBox width="100%" justifyContent="SpaceBetween" class="featureRow">
                    <!-- Card 1: Every kind of stay -->
                    <VBox class="featureCard" width="48%">
                        <core:Icon src="sap-icon://grid" class="featureIcon"/>
                        <Title text="Every kind of stay" level="H4" class="featureTitle"/>
                        <Text text="Five property types, one platform." class="featureDesc"/>
                    </VBox>

                    <!-- Card 2: Easy to find -->
                    <VBox class="featureCard" width="48%">
                        <core:Icon src="sap-icon://search" class="featureIcon"/>
                        <Title text="Easy to find" level="H4" class="featureTitle"/>
                        <Text text="Search by city, type and locality." class="featureDesc"/>
                    </VBox>
                </HBox>

                <!-- Row 2 -->
                <HBox width="100%" justifyContent="SpaceBetween" class="featureRow">
                    <!-- Card 3: Clear policies -->
                    <VBox class="featureCard" width="48%">
                        <core:Icon src="sap-icon://shield" class="featureIcon"/>
                        <Title text="Clear policies" level="H4" class="featureTitle"/>
                        <Text text="Rules and refunds shown upfront." class="featureDesc"/>
                    </VBox>

                    <!-- Card 4: Guest-first -->
                    <VBox class="featureCard" width="48%">
                        <core:Icon src="sap-icon://favorite" class="featureIcon"/>
                        <Title text="Guest-first" level="H4" class="featureTitle"/>
                        <Text text="Reviews and support when you need it." class="featureDesc"/>
                    </VBox>
                </HBox>

            </VBox>

        </HBox>
    </VBox>
    <HBox class="listPropertyBanner" width="100%" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
        
        <!-- Left Content Area -->
        <VBox class="bannerContent">
            <Title 
                text="Own a property? List it on StayVriksha." 
                level="H2" 
                wrapping="true" 
                class="bannerTitle"/>
            <Text 
                text="Reach more guests and manage multiple branches from one dashboard." 
                class="bannerSubtitle"/>
        </VBox>

        <!-- Right Action Button Area -->
        <HBox class="bannerAction sapUiTinyMarginBottom">
            <Button 
                text="Register your property" 
                class="btnRegister"/>
        </HBox>

    </HBox>
            <!-- </VBox> -->

                               <VBox class="sapUiTinyMarginTop">
                                                    <core:Fragment
                                                        fragmentName="sap.ui.com.project1.fragment.quicklinks"
                                                        type="XML"
                                                    />
                                                </VBox>
                                                        </Page>

                            <Page
                                id="idRooms"
                                showHeader="false"
                                enableScrolling="true"
                                class="RoomsPage"
                            >
                                <VBox
                                    height="100%"
                                    renderType="Bare"
                                >
                                    <ScrollContainer
                                        id="idRoomsScroll"
                                        height="100%"
                                        vertical="true"
                                        horizontal="false"
                                        class="stickyPageContent"
                                    >
                                        <layoutData>
                                            <FlexItemData
                                                growFactor="1"
                                                baseSize="0%"
                                            />
                                        </layoutData>
                                        <content>
                                            <VBox
                                                class="minHeight100 flexGrow1"
                                                justifyContent="SpaceBetween"
                                            >
                                                <VBox width="100%">
                                                    <!-- <HBox justifyContent="End"><Button text="Filter" icon="sap-icon://map" press="onpressFilter" width="200px" class="sapUiTinyMargin"/></HBox> -->
                                                   
    
                                                    <fb:FilterBar
                                                        id="filterbar"
                                                        persistencyKey="myPersKey"
                                                        useToolbar="false"
                                                        clear="FC_onPressClear"
                                                        showClearOnFB="true"
                                                        search="onSearchRooms"
                                                        filterChange="IA_.onFilterChange"
                                                        afterVariantLoad="IA_.onAfterVariantLoad"
                                                        showFilterConfiguration="false"
                                                        filterContainerWidth="auto"
                                                        class="sapUiContentPadding HostelRooms sapUiTinyMargin filterBarTheme"
                                                        busyIndicatorDelay="0"
                                                    >
                                                        <fb:filterGroupItems>
                                                            <!--  Branch Name -->
                                                            <fb:FilterGroupItem
                                                                name="Branch"
                                                                label="{i18n>city}"
                                                                groupName="Group1"
                                                                visibleInFilterBar="true"
                                                                mandatory="true"
                                                            >
                                                                <fb:control>
                                                                    <ComboBox
                                                                        id="id_Branch"
                                                                        placeholder="{i18n>cityValueText}"
                                                                        valueStateText="{i18n>pleaseSelectCity}"
                                                                        showClearIcon="true"
                                                                        busyIndicatorDelay="0"
                                                                        enabled="true"
                                                                        items="{path:'sBRModel>/'}"
                                                                        selectionChange=".onBranchSelectionChange"
                                                                    >
                                                                        <core:ListItem
                                                                            key="{sBRModel>city}"
                                                                            text="{sBRModel>city}"
                                                                        />
                                                                    </ComboBox>
                                                                </fb:control>
                                                            </fb:FilterGroupItem>
                                                            <!--  Property Type -->
                                                            <fb:FilterGroupItem
                                                                name="PropertyType"
                                                                label="{i18n>propertyType}"
                                                                groupName="Group1"
                                                                visibleInFilterBar="true"
                                                            >
                                                                <fb:control>
                                                                    <MultiComboBox
                                                                        id="id_PropertyType"
                                                                        placeholder="{i18n>selectPropertyType}"
                                                                        showClearIcon="true"
                                                                        busyIndicatorDelay="0"
                                                                        items="{PropertyType>/}"
                                                                        selectionChange=".onPropertyTypeChange"
                                                                    >
                                                                        <core:ListItem
                                                                            key="{PropertyType>PropertyType}"
                                                                            text="{PropertyType>PropertyType}"
                                                                        />
                                                                    </MultiComboBox>
                                                                </fb:control>
                                                            </fb:FilterGroupItem>
                                                            <fb:FilterGroupItem
                                                                name="Property Name"
                                                                label="{i18n>sheetBranchName}"
                                                                groupName="Group1"
                                                                visibleInFilterBar="true"
                                                            >
                                                                <fb:control>
                                                                    <ComboBox
                                                                        id="id_Roomtype"
                                                                        placeholder="{i18n>SelectBranchname}"
                                                                        showClearIcon="true"
                                                                        busyIndicatorDelay="0"
                                                                        items="{AreaModel>/}"
                                                                    >
                                                                        <core:ListItem
                                                                            key="{AreaModel>Name}"
                                                                            text="{AreaModel>Name}"
                                                                        />
                                                                    </ComboBox>
                                                                </fb:control>
                                                            </fb:FilterGroupItem>
                                                            <!-- Area -->
                                                            <fb:FilterGroupItem
                                                                name="Area"
                                                                label="{i18n>locality}"
                                                                groupName="Group1"
                                                                visibleInFilterBar="true"
                                                            >
                                                                <fb:control>
                                                                    <ComboBox
                                                                        id="id_Area"
                                                                        placeholder="{i18n>selectLocality}"
                                                                        showClearIcon="true"
                                                                        enabled="false"
                                                                        valueStateText="{i18n>selectArea}"
                                                                        items="{AreaModel>/}"
                                                                        selectionChange=".onAreaSelectionChange"
                                                                        busyIndicatorDelay="0"
                                                                    >
                                                                        <core:ListItem
                                                                            key="{AreaModel>LandMark}"
                                                                            text="{AreaModel>LandMark}"
                                                                        />
                                                                    </ComboBox>
                                                                </fb:control>
                                                            </fb:FilterGroupItem>
                                                            <!--  Room Type -->
                                                        </fb:filterGroupItems>
                                                    </fb:FilterBar>

                                                    <VBox
                                                        height="100%"
                                                        justifyContent="Center"
                                                    >
                                                        <l:Grid
                                                            id="idBedTypeFlex"
                                                            defaultSpan="XL3 L4 M6 S12"
                                                            containerQuery="true"
                                                            hSpacing="1"
                                                            vSpacing="1"
                                                            content="{path: 'VisibilityModel>/Branches'}"
                                                            visible="{= !${VisibilityModel>/NoData} }"
                                                             class="sapUiSmallMarginTop"

                                                        >
                                                            <VBox
                                                                class="BranchCard sapUiTinyMargin sapUiTinyMargin"
                                                            >
                                                                <!-- ===== IMAGE CAROUSEL ===== -->
                                                                <Carousel
                                                                    height="200px"
                                                                    width="100%"
                                                                    loop="true"
                                                                    showPageIndicator="false"
                                                                    backgroundDesign="Transparent"
                                                                >
                                                                    <pages>
                                                                        <VBox
                                                                            class="imageWrapper"
                                                                        >
                                                                            <HBox
                                                                                class="areaTagBox"
                                                                            >
                                                                                <core:Icon
                                                                                    src="sap-icon://building"
                                                                                    size="0.9rem"
                                                                                    color="black"
                                                                                    class="sapUiTinyMarginEnd"
                                                                                />
                                                                                <Text
                                                                                    text="{VisibilityModel>PropertyType}"
                                                                                />
                                                                            </HBox>
                                                                            <!-- Image -->
                                                                            <Image
                                                                                src="{VisibilityModel>Image}"
                                                                                width="100%"
                                                                                height="200px"
                                                                                class="BranchCardImage"
                                                                                decorative="false"
                                                                            />
                                                                            
                                                                        </VBox>
                                                                    </pages>
                                                                </Carousel>
                                                                <!-- ===== CARD CONTENT ===== -->
                                                                <VBox
                                                                    class="BranchCardContent"
                                                                >
                                                                    <Text
                                                                        text="{= ${VisibilityModel>Name} + ' - ' + ${VisibilityModel>LandMark}}"
                                                                        class="BranchCardTitle"
                                                                    />
                                                                    <!-- ? Rating row EXACT like screenshot -->
                                                                    <VBox alignItems="Center">
                                                                    <List
                                                                        class="ratingList"
                                                                        showSeparators="None"
                                                                        backgroundDesign="Transparent"
                                                                        visible="{= !!${VisibilityModel>TotalFeedbacks} &amp;&amp; Number(${VisibilityModel>TotalFeedbacks}) > 0 }"
                                                                    >
                                                                        <CustomListItem
                                                                            type="Active"
                                                                            press=".onRatingPress"
                                                                            tooltip="Tap to See Reviews"
                                                                        >
                                                                            <HBox
                                                                                class="ratingInline"
                                                                                justifyContent="Center"
                                                                                alignItems="Center"
                                                                            >
                                                                                <RatingIndicator
                                                                                    value="{= Number(${VisibilityModel>AverageRating}) || 0 }"
                                                                                    maxValue="5"
                                                                                    enabled="true"
                                                                                    editable="false"
                                                                                    iconSize="1.35rem"
                                                                                    class="ratingStars"
                                                                                />
                                                                                <Text
                                                                                    text="{= '(' + ${VisibilityModel>TotalFeedbacks} + ')' }"
                                                                                    class="ratingCountInline"
                                                                                />
                                                                            </HBox>
                                                                        </CustomListItem>
                                                                    </List>
                                                                 
<Title
                                                                               text="{
                                                                                   parts: ['VisibilityModel>Currency','VisibilityModel>StartingPrice'],
                                                                                   formatter: '.Formatter.formatStartingPrice'
                                                                                     }"
                                                                                        visible="{= !(${VisibilityModel>TotalFeedbacks} ? Number(${VisibilityModel>TotalFeedbacks}) > 0 : false) }"
                                                                                        class="branchCardPrice"
                                                                                  />
<Title
                                                                               text="{
                                                                                   parts: ['VisibilityModel>Currency','VisibilityModel>StartingPrice'],
                                                                                   formatter: '.Formatter.formatStartingPrice'
                                                                                     }"
                                                                                        visible="{= ${VisibilityModel>TotalFeedbacks} ? Number(${VisibilityModel>TotalFeedbacks}) > 0 : false }"
                                                                                  />
                                                                       </VBox>
                                                                    <HBox
                                                                        justifyContent="Center"
                                                                        alignItems="Center"
                                                                    >
                                                                        <Link
                                                                            text="{i18n>ViewRooms}"
                                                                            tooltip="{i18n>ViewRooms}"
                                                                            press="viewRooms"
                                                                            class="btnViewDetails"
                                                                        />
                                                                    </HBox>
                                                                </VBox>
                                                            </VBox>
                                                        </l:Grid>
                                                        <VBox
                                                            height="400px"
                                                            justifyContent="Center"
                                                            alignItems="Center"
                                                            visible="{VisibilityModel>/NoData}"
                                                        >
                                                            <Text
                                                                text="{i18n>noRoomsFound}"
                                                                class="cssNoDataMessage"
                                                            />
                                                            <Text
                                                                text="{i18n>pleaseselectanotherCity}"
                                                                class="cssNoDataSubMessage"
                                                            />
                                                        </VBox>
                                                    </VBox>

                                                    <VBox
                                                        alignItems="Center"
                                                        class="sapUiTinyMarginTop"
                                                        visible="{VisibilityModel>/ShowViewMore}"
                                                    >
                                                        <Link
                                                            id="idViewMoreBusy"
                                                            text="{i18n>viewmorerooms}"

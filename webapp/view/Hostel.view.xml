<mvc:View
    controllerName="sap.ui.com.project1.controller.Hostel"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:svm="sap.ui.comp.smartvariants"
    height="100%"
    busyIndicatorDelay="0"
>
    <tnt:ToolPage class="sapUiTinyMarginTop">
        <tnt:header>
            <tnt:ToolHeader id="hostelTopHeader">
    <Image
        src="./image/3 log 1.0.png"
        width="110px"
        height="110px"
        tooltip="{i18n>companyLogo}"
        class="sapUiSmallMarginTop"
    />
    
    <ToolbarSpacer />

    <!-- Register Property Button -->
    <Button
        text="{i18n>Registeryourpropertycap}"
        id="Vendor"
        tooltip="{i18n>Registeryourproperty}"
        class="loginButton"
        press="onAdminSIGNUP"
    >
        <layoutData>
            <!-- Phones always use the overflow menu, including the first load. -->
            <OverflowToolbarLayoutData
                priority="{= ${device>/system/phone} ? 'AlwaysOverflow' : 'High' }"
                shrinkable="false"
            />
        </layoutData>
    </Button>

    <!-- Sign In / Sign Up Button -->
    <Button
        text="{i18n>sIGNINUP}"
        id="loginButton"
        tooltip="{i18n>signInorSignUp}"
        class="loginButton"
        press="onpressLogin"
        visible="{= !${UIModel>/isLoggedIn} }"
    >
        <layoutData>
            <OverflowToolbarLayoutData
                priority="{= ${device>/system/phone} ? 'AlwaysOverflow' : 'High' }"
                shrinkable="false"
            />
        </layoutData>
    </Button>

    <!-- Profile Avatar -->
    <Avatar
        visible="{UIModel>/isLoggedIn}"
        id="ProfileAvatar"
        src="{LoginModel>/Photo}"
        initials="{= ${LoginModel>/EmployeeName} ? ${LoginModel>/EmployeeName}.charAt(0).toUpperCase() : '' }"
        tooltip="{= ${LoginModel>/UserName} || ${i18n>profilePic} }"
        press="onPressAvatar"
        class="profileAvatar"
    >
        <layoutData>
            <!-- Keep avatar always visible outside the 3 dots -->
            <OverflowToolbarLayoutData priority="NeverOverflow" />
        </layoutData>
    </Avatar>
</tnt:ToolHeader>
        </tnt:header>
        <tnt:subHeader>
            <tnt:ToolHeader>
                <!-- <ToolbarSpacer /> -->
                <IconTabHeader
                    id="mainTabHeader"
                    select="onTabSelect"
                >
                    <items>
                        <IconTabFilter
                            key="idHome"
                            tooltip="{i18n>home}"
                            text="{i18n>home}"
                        />
                        <IconTabFilter
                            key="idRooms"
                            tooltip="{i18n>rooms}"
                            text="{i18n>rooms}"
                        />
                        <IconTabFilter
                            key="idVendor"
                            tooltip="{i18n>vrTabTitle}"
                            text="{i18n>vrTabTitle}"
                            visible="false"
                        />
                        <!-- <IconTabFilter key="idFacilities" text="Facilities" /> -->
                        <IconTabFilter
                            key="idContact"
                            tooltip="{i18n>contact}"
                            text="{i18n>contact}"
                        />
                        <!-- <IconTabFilter key="idAdddata" text="Add Data"/> -->
                    </items>
                </IconTabHeader>
            </tnt:ToolHeader>
        </tnt:subHeader>
        <tnt:mainContents>
            <VBox
                height="100%"
                renderType="Bare"
                justifyContent="Start"
            >
                <items>
                    <NavContainer
                        id="pageContainer"
                        height="auto"
                    >
                        <!-- <layoutData>
	<FlexItemData growFactor="1" baseSize="0" />
</layoutData> -->
                        <layoutData>
                            <FlexItemData growFactor="1" />
                        </layoutData>
                        <pages>
                             <Page
                                id="idHome"
                                class="hostelHomePage"
                                showHeader="false"
                                enableScrolling="true"
                            >
                            <ScrollContainer
                                horizontal="false"
                                vertical="true"
                                class="sapUiContentPadding Homepage sapUiTinyMargin"
                            >
                                <l:Grid
                                    defaultSpan="XL12 L12 M12 S12"
                                    width="100%"
                                    class="position-welcome fullHeightGrid"
                                >
                                    <VBox class="heroTextBox">
                                        <Text
                                            class="custom-welcome"
                                            text="{i18n>welcomeTo}"
                                        />
                                        <Text
                                            class="custom-welcome"
                                            text="{i18n>companynameKT}"
                                        />
                                        <Text
                                            class="custom-tagline"
                                            text="{i18n>yourNewHomeAwayFromHome}"
                                        />
                                    </VBox>

                                    <!-- <Button text="Explore Now" tooltip="Book Room" class="exploreBtn  sapUiLargeMarginBegin " press="onpressBookrooms" /> -->
                                    <HBox
                                        id="exploreWrapper"
                                        width="100%"
                                        class="exploreBtnWrapper explore-enter"
                                    >
                                        <Button
                                            text="{i18n>exploreNow}"
                                            class="exploreBtn"
                                            press="onpressBookrooms"
                                        />
                                    </HBox>
                                </l:Grid>
                                
                            </ScrollContainer>
                  
                            
<!-- Find the Right Stay - Single Card -->


<VBox class="stayTypesMainCard" width="100%">

  
   <FormattedText
    htmlText="{i18n>findRightStay}"
    class="stayTypesTitle"/>

    <Text
        text="{i18n>Allstays}"
        class="stayTypesDescription"/>

 <FlexBox
    width="100%"
    wrap="Wrap"
    justifyContent="SpaceAround"
    alignItems="Center"
    class="stayTypesFlex">

    <!-- 1. Hotels Button -->
    <Button
        id="btnHotels"
        text="{i18n>cardHotels}"
        icon="sap-icon://bed"
        press="onStayTypePress"
        class="stayTypeButton selected-stay-btn myUnifiedBtn">
        <customData>
            <core:CustomData key="stayId" value="Hotels"/>
        </customData>
    </Button>

    <!-- 2. Hostels Button (Fixed stayId value) -->
    <Button 
        id="btnHostels"
        text="{i18n>cardhostels}"
        icon="sap-icon://home-share"
        press="onStayTypePress"
        class="stayTypeButton myUnifiedBtn">
        <customData>
            <core:CustomData key="stayId" value="Hostels" />
        </customData>
    </Button>

    <!-- 3. PG Button (Added missing customData) -->
    <Button
        id="btnPG"
        text="{i18n>CardPG}"
        icon="sap-icon://home"
        press="onStayTypePress"
        class="stayTypeButton myUnifiedBtn">
        <customData>
            <core:CustomData key="stayId" value="PG" />
        </customData>
    </Button>

    <!-- 4. Service Apartments Button (Added missing customData) -->
    <Button
        id="btnServiceApartments"
        text="{i18n>cardServiceApartments}"
        icon="sap-icon://building"
        press="onStayTypePress"
        class="stayTypeButton myUnifiedBtn serviceApartmentsBtn">
        <customData>
            <core:CustomData key="stayId" value="Service Apartments" />
        </customData>
    </Button>

    <!-- 5. Rented Apartments Button (Added missing customData) -->
    <Button
        id="btnRentedApartments"
        text="{i18n>stayRentedApartments}"
        icon="sap-icon://key"
        press="onStayTypePress"
        class="stayTypeButton myUnifiedBtn serviceApartmentsBtn">
        <customData>
            <core:CustomData key="stayId" value="Rented Apartments" />
        </customData>
    </Button>

</FlexBox>

<!-- Lower Section Container -->
<!-- Lower Section Container -->
   <HBox  

   width="100%" class="stayDetailsContainer" binding="{view>/currentStay}">

        <!-- Left Graphic Card -->
        <!-- <VBox class="hotelPreviewCard"> -->
            <!-- Top Badge -->
             <VBox class="hotelPreviewCard" visible="{TopModel>/Branch}">
            <!-- Top Badge -->
            <HBox class="hotelCardBadge">
                <core:Icon src="{view>icon}" class="badgeIcon"/>
                <Text text="{view>badge}" class="badgeText"/>
            </HBox>

            <!-- Center Icon -->
            <VBox class="hotelCardIconWrapper" justifyContent="Center" alignItems="Center">
                <core:Icon src="{view>icon}" class="hotelCardMainIcon"/>
            </VBox>

            <!-- Bottom Graphic Area -->
            <VBox class="hotelCardBottom" alignItems="Center" justifyContent="Center">
                <VBox class="skeletonLineLong"/>
                <VBox class="skeletonLineShort"/>

                <Text text="{i18n>StartingatINR}" class="hotelPriceText"/>

                <Button text="{i18n>ViewRooms}" class="myUnifiedBtn "/>
            </VBox>
        </VBox>

            
                 <l:Grid
            defaultSpan="XL4 L4 M6 S12"
            containerQuery="true"
            hSpacing="1"
            vSpacing="1"
            class="stayBranchesGrid"
            content="{path: 'TopModel>/Branches'}"
        >
            <VBox class="BranchCard sapUiLargeMarginTop">
                <!-- ===== IMAGE CAROUSEL ===== -->
                <Carousel
                    height="200px"
                    width="100%"
                    loop="true"
                    showPageIndicator="false"
                    backgroundDesign="Transparent"
                >
                    <pages>
                        <VBox class="imageWrapper">
                            <HBox class="areaTagBox">
                                <core:Icon
                                    src="sap-icon://building"
                                    size="0.9rem"
                                    color="black"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Text text="{TopModel>PropertyType}" />
                            </HBox>
                            <Image
                                src="{TopModel>Image}"
                                width="100%"
                                height="200px"
                                class="BranchCardImage"
                                decorative="false"
                            />
                        </VBox>
                    </pages>
                </Carousel>

                <!-- ===== CARD CONTENT ===== -->
                <VBox class="BranchCardContent">
                    <Text text="{= ${TopModel>Name} + ' - ' + ${TopModel>LandMark}}" class="BranchCardTitle" />
                    
                    <VBox alignItems="Center">
                        <List
                            class="ratingList"
                            showSeparators="None"
                            backgroundDesign="Transparent"
                            visible="{= !!${TopModel>TotalFeedbacks} &amp;&amp; Number(${TopModel>TotalFeedbacks}) > 0 }"
                        >
                            <CustomListItem type="Active" press=".onRatingPress" tooltip="Tap to See Reviews">
                                <HBox class="ratingInline" justifyContent="Center" alignItems="Center">
                                    <RatingIndicator
                                        value="{= Number(${TopModel>AverageRating}) || 0 }"
                                        maxValue="5"
                                        enabled="true"
                                        editable="false"
                                        iconSize="1.35rem"
                                        class="ratingStars"
                                    />
                                    <Text text="{= '(' + ${TopModel>TotalFeedbacks} + ')' }" class="ratingCountInline" />
                                </HBox>
                            </CustomListItem>
                        </List>
                        
                        <Title
                            text="{parts: ['TopModel>Currency','TopModel>StartingPrice'], formatter: '.Formatter.formatStartingPrice'}"
                            visible="{= !(${TopModel>TotalFeedbacks} ? Number(${TopModel>TotalFeedbacks}) > 0 : false) }"
                            class="branchCardPrice"
                        />
                        <Title
                            text="{parts: ['TopModel>Currency','TopModel>StartingPrice'], formatter: '.Formatter.formatStartingPrice'}"
                            visible="{= ${TopModel>TotalFeedbacks} ? Number(${TopModel>TotalFeedbacks}) > 0 : false }"
                        />
                    </VBox>

                    <HBox justifyContent="Center" alignItems="Center">
                        <Link
                            text="{i18n>ViewRooms}"
                            tooltip="{i18n>ViewRooms}"
                            press="viewRooms"
                            class="btnViewDetails"
                        />
                    </HBox>
                </VBox>
            </VBox>
        </l:Grid>
        <!-- </VBox> -->


        <!-- Right Content Area -->
        <VBox class="hotelDetailsContent" width="100%">
            <!-- Title & Subtitle -->
            <Title text="{view>badge}" level="H2" class="hotelDetailTitle"/>
            <Title text="{view>Subtitle}" level="H3" class="hotelDetailcardsubTitle"/>

            <Text text="{view>blurb}" class="hotelDetailSubtitle"/>

            <!-- BEST FOR Section -->
            <Label text="{i18n>BESTFOR}" class="sectionHeaderLabel"/>
            <HBox class="tagsContainer" items="{view>best}">
                <Text text="{view>}" class="stayTag"/>
            </HBox>

            <!-- WHAT YOU'LL SEE Section -->
            <Label text="{i18n>WHATYOUSEEBEFOREYOUBOOK}" class="sectionHeaderLabel"/>
       <VBox class="featureList" items="{view>see}">
    <HBox alignItems="Start" class="featureItem">
        <core:Icon
            src="sap-icon://accept"
            class="featureIconround"
        />

        <Text
            text="{view>title}"
            class="featureTitlecard"
        />

        <Text text="–" class="featureTextcard sapUiTinyMarginBegin sapUiTinyMarginEnd"/>

        <Text
            text="{view>description}"
            class="featureTextcard"
        />
    </HBox>
</VBox>

            <!-- Action Button -->
            <Button text="{i18n>Browse} {view>badge}" press="onBrowseHotelsPress" class="myUnifiedBtn browscss wrapButtonText"/>
        </VBox>

    </HBox>
</VBox>

<VBox class="whyBookMainCard" width="100%">

    <!-- Header Section -->
    <FormattedText htmlText="{i18n>whyBookWith}"  class="stayTypesTitle"/>
    <Text text="{i18n>Simpleclearandbuiltaroundguests}" class="stayTypesDescription"/>

   

    <!-- Responsive FlexBox Grid -->
    <FlexBox width="100%" wrap="Wrap" justifyContent="Center" class="featuresFlexGrid">

        <!-- Item 1: Easy Booking -->
        <VBox class="featureGridItem" alignItems="Center" justifyContent="Center">
            <core:Icon src="sap-icon://calendar" class="featureGridIcon"/>
            <Title text="{i18n>EasyBooking}" level="H3" class="featureGridTitle"/>
            <Text text="{i18n>Searchtaps}" class="featureGridDesc" textAlign="Center"/>
        </VBox>

        <!-- Item 2: Transparent Prices -->
        <VBox class="featureGridItem Transparenttext" alignItems="Center" justifyContent="Center" >
            <core:Icon src="sap-icon://money-bills" class="featureGridIcon"/>
            <Title text="{i18n>TransparentPrices}" level="H3" class="featureGridTitle"/>
            <Text text="{i18n>Seethepay}" class="featureGridDesc" textAlign="Center"/>
        </VBox>

        <!-- Item 3: Clear Refund Rules -->
        <VBox class="featureGridItem" alignItems="Center" justifyContent="Center">
            <core:Icon src="sap-icon://refresh" class="featureGridIcon"/>
            <Title text="{i18n>ClearRefundRules}" level="H3" class="featureGridTitle"/>
            <Text text="{i18n>Everylistingconfirm}" class="featureGridDesc" textAlign="Center"/>
        </VBox>

        <!-- Item 4: Support That Helps -->
        <VBox class="featureGridItem" alignItems="Center" justifyContent="Center">
            <core:Icon src="sap-icon://headset" class="featureGridIcon"/>
            <Title text="{i18n>SupportThatHelps}" level="H3" class="featureGridTitle"/>
            <Text text="{i18n>Raisearequestanytimeandourteamwillhelpwithbookingsissuesandrefunds}" class="featureGridDesc" textAlign="Center"/>
        </VBox>

        <!-- Item 5: Deals & Coupons -->
        <VBox class="featureGridItem" alignItems="Center" justifyContent="Center">
            <core:Icon src="sap-icon://sales-order-item" class="featureGridIcon"/>
            <Title text="{i18n>DealsCoupons}" level="H3" class="featureGridTitle"/>
            <Text text="{i18n>ApplycouponsonhotelshostelsPGsandapartmentsandsaveonyourstay}" class="featureGridDesc" textAlign="Center"/>
        </VBox>

    </FlexBox>

</VBox>
<VBox class="bookingStepsSection" width="100%">

    <!-- Heading -->
    <VBox class="bookingStepsHeader" alignItems="Center">
        <Title
            text="{i18n>Bookinthreesteps}"
            class="bookingStepsTitle"/>

        <Text
            text="{i18n>Fromsearchtoconfirmationnohassle}"
            class="bookingStepsSubtitle"/>
    </VBox>

    <!-- Three Cards -->
    <HBox
        class="bookingStepsContainer"
        width="100%"
        alignItems="Stretch"
        justifyContent="SpaceBetween"
        wrap="Wrap">

        <!-- Step 1 -->
        <VBox class="bookingStepCard" width="32%">
            <Text text="1" class="bookingStepNumber"/>
            <Title text="{i18n>cardSearch}" level="H4" class="bookingStepCardTitle"/>
            <Text
                text="{i18n>ChoosetapGo}"
                class="bookingStepDescription"/>
        </VBox>

        <!-- Step 2 -->
        <VBox class="bookingStepCard" width="32%">
            <Text text="2" class="bookingStepNumber"/>
            <Title text="{i18n>Comparechoose}" level="H4" class="bookingStepCardTitle"/>
            <Text
                text="{i18n>cancellationpolicy}"
                class="bookingStepDescription"/>
        </VBox>

        <!-- Step 3 -->
        <VBox class="bookingStepCard" width="32%">
            <Text text="3" class="bookingStepNumber"/>
            <Title text="{i18n>Bookstay}" level="H4" class="bookingStepCardTitle"/>
            <Text
                text="{i18n>Confirmstay}"
                class="bookingStepDescription"/>
        </VBox>

    </HBox>
</VBox>
<VBox class="aboutUsContainer" width="100%">
        
        <!-- Inner Responsive Splitter / Container using HBox with wrap -->
        <HBox class="aboutUsInner" width="100%" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
            
            <!-- Left Side: Information & CTAs -->
            <VBox class="aboutContent" width="48%">
                <Text text="{i18n>ABOUTUS}" class="aboutTag"/>
                <Title text="{i18n>Indiafirstbookingplatformforeverykindstay}" level="H1" class="aboutTitle"/>
                <Text text="{i18n>staydesc}" class="aboutDescription"/>
                <Text text="{i18n>staysecdesc}" class="aboutDescription"/>
                
                <!-- Action Buttons -->
                <HBox class="aboutActions"   width="100%"
    alignItems="Center"
    justifyContent="Start"
    wrap="Wrap" >
                    <Button text="{i18n>Learnmore}" type="Emphasized" class="btnPrimary" press="onUsermanualPress"/>
                    <Button text="{i18n>cardContactus}" type="Default" class="btnOutline" press="onfootercontacttabselect"/>
                </HBox>
            </VBox>

            <!-- Right Side: 2x2 Feature Cards Grid -->
            <VBox class="featuresGrid" width="48%">
                
                <!-- Row 1 -->
                <HBox width="100%" justifyContent="SpaceBetween" class="featureRow">
                    <!-- Card 1: Every kind of stay -->
                    <VBox class="featureCard" width="48%">
                        <core:Icon src="sap-icon://grid" class="featureIcon"/>
                        <Title text="{i18n>Everykindofstay}" level="H4" class="featureTitle"/>
                        <Text text="{i18n>Fivepropertytypesoneplatform}" class="featureDesc"/>
                    </VBox>

                    <!-- Card 2: Easy to find -->
                    <VBox class="featureCard" width="48%">
                        <core:Icon src="sap-icon://search" class="featureIcon"/>
                        <Title text="{i18n>Easytofind}" level="H4" class="featureTitle"/>
                        <Text text="{i18n>Searchbycitytypeandlocality}" class="featureDesc"/>
                    </VBox>
                </HBox>

                <!-- Row 2 -->
                <HBox width="100%" justifyContent="SpaceBetween" class="featureRow">
                    <!-- Card 3: Clear policies -->
                    <VBox class="featureCard" width="48%">
                        <core:Icon src="sap-icon://shield" class="featureIcon"/>
                        <Title text="{i18n>Clearpolicies}" level="H4" class="featureTitle"/>
                        <Text text="{i18n>Rulesandrefundsshownupfront}" class="featureDesc"/>
                    </VBox>

                    <!-- Card 4: Guest-first -->
                    <VBox class="featureCard" width="48%">
                        <core:Icon src="sap-icon://favorite" class="featureIcon"/>
                        <Title text="{i18n>Guestfirst}" level="H4" class="featureTitle"/>
                        <Text text="{i18n>Reviewsandsupportwhenyouneedit}" class="featureDesc"/>
                    </VBox>
                </HBox>

            </VBox>

        </HBox>
    </VBox>
    <HBox class="listPropertyBanner" width="100%" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
        
        <!-- Left Content Area -->
        <VBox class="bannerContent">
            <Title 
                text="{i18n>OwnpropertyListitonStayVriksha}" 
                level="H2" 
                wrapping="true" 
                class="bannerTitle"/>
            <Text 
                text="{i18n>Reachmoreguestsmanagemultiplebranchesfromonedashboard}" 
                class="bannerSubtitle"/>
        </VBox>

        <!-- Right Action Button Area -->
        <HBox class="bannerAction sapUiMediumMarginBottom sapUiTinyMarginTop">
            <Button 
                text="{i18n>Registeryourproperty}" 
                press="onAdminSIGNUP"
                class="btnRegister"/>
        </HBox>

    </HBox>
            <!-- </VBox> -->

                               <VBox class="sapUiTinyMarginTop">
                                                    <core:Fragment
                                                        fragmentName="sap.ui.com.project1.fragment.quicklinks"
                                                        type="XML"
                                                    />
                                                </VBox>
                                                        </Page>

                            <Page
                                id="idRooms"
                                showHeader="false"
                                enableScrolling="true"
                                class="RoomsPage"
                            >
                                <VBox
                                    height="100%"
                                    renderType="Bare"
                                >
                                    <ScrollContainer
                                        id="idRoomsScroll"
                                        height="100%"
                                        vertical="true"
                                        horizontal="false"
                                        class="stickyPageContent"
                                    >
                                        <layoutData>
                                            <FlexItemData
                                                growFactor="1"
                                                baseSize="0%"
                                            />
                                        </layoutData>
                                        <content>
                                            <VBox
                                                class="minHeight100 flexGrow1"
                                                justifyContent="SpaceBetween"
                                            >
                                              <HBox width="100%" alignItems="Start"  class="sapUiSmallMargin roomsMainLayout">
    
    <!-- ===== LEFT SIDE: VERTICAL FILTER BAR ===== -->
    <VBox width="300px"  class="sapUiTinyMarginTop sapUiTinyMarginEnd stickyFilterContainer">
        <fb:FilterBar
            id="filterbar"
            persistencyKey="myPersKey"
            useToolbar="false"
            clear="FC_onPressClear"
            showClearOnFB="true"
            search="onSearchRooms"
            filterChange="IA_.onFilterChange"
            afterVariantLoad="IA_.onAfterVariantLoad"
            showFilterConfiguration="false"
            filterContainerWidth="100%"

            class="sapUiContentPadding HostelRooms filterBarTheme"
            busyIndicatorDelay="0"
        >
            <fb:filterGroupItems>
                <!-- Branch Name -->
                <fb:FilterGroupItem
                    name="Branch"
                    label="{i18n>city}"
                    groupName="Group1"
                    visibleInFilterBar="true"
                    mandatory="true"
                >
                    <fb:control>
                        <ComboBox
                            id="id_Branch"
                            placeholder="{i18n>cityValueText}"
                            valueStateText="{i18n>pleaseSelectCity}"
                            showClearIcon="true"
                            busyIndicatorDelay="0"
                            enabled="true"
                            items="{path:'sBRModel>/'}"
                            selectionChange=".onBranchSelectionChange"
                        >
                            <core:ListItem
                                key="{sBRModel>city}"
                                text="{sBRModel>city}"
                            />
                        </ComboBox>
                    </fb:control>
                </fb:FilterGroupItem>

                <!-- Property Type -->
                <fb:FilterGroupItem
                    name="PropertyType"
                    label="{i18n>propertyType}"
                    groupName="Group1"
                    visibleInFilterBar="true"
                >
                    <fb:control>
                        <MultiComboBox
                            id="id_PropertyType"
                            placeholder="{i18n>selectPropertyType}"
                            showClearIcon="true"
                            busyIndicatorDelay="0"
                            items="{PropertyType>/}"
                            selectionChange=".onPropertyTypeChange"
                        >
                            <core:ListItem
                                key="{PropertyType>PropertyType}"
                                text="{PropertyType>PropertyType}"
                            />
                        </MultiComboBox>
                    </fb:control>
                </fb:FilterGroupItem>

                <!-- Property Name -->
                <fb:FilterGroupItem
                    name="Property Name"
                    label="{i18n>sheetBranchName}"
                    groupName="Group1"
                    visibleInFilterBar="true"
                >
                    <fb:control>
                        <ComboBox
                            id="id_Roomtype"
                            placeholder="{i18n>SelectBranchname}"
                            showClearIcon="true"
                            busyIndicatorDelay="0"
                            items="{AreaModel>/}"
                        >
                            <core:ListItem
                                key="{AreaModel>Name}"
                                text="{AreaModel>Name}"
                            />
                        </ComboBox>
                    </fb:control>
                </fb:FilterGroupItem>

                <!-- Area -->
                <fb:FilterGroupItem
                    name="Area"
                    label="{i18n>locality}"
                    groupName="Group1"
                    visibleInFilterBar="true"
                >
                    <fb:control>
                        <ComboBox
                            id="id_Area"
                            placeholder="{i18n>selectLocality}"
                            showClearIcon="true"
                            enabled="false"
                            valueStateText="{i18n>selectArea}"
                            items="{AreaModel>/}"
                            selectionChange=".onAreaSelectionChange"
                            busyIndicatorDelay="0"
                        >
                            <core:ListItem
                                key="{AreaModel>LandMark}"
                                text="{AreaModel>LandMark}"
                            />
                        </ComboBox>
                    </fb:control>
                </fb:FilterGroupItem>

                      <fb:FilterGroupItem
                    name="Pricerange"
                    label="{i18n>Pricerange}"
                    groupName="Group1"
                    visibleInFilterBar="true"
                >
                    <fb:control>
                     <ComboBox
    id="id_Pricerange"
    placeholder="{i18n>Choosepriceorder}"
    showClearIcon="true"
    enabled="false"
    selectionChange=".onAreaSelectionChange">

    <core:Item key="Lowest" text="{i18n>LowestCostStays}" />
    <core:Item key="Highest" text="{i18n>HighestCostStays}" />

</ComboBox>
                    </fb:control>
                </fb:FilterGroupItem>
            </fb:filterGroupItems>
        </fb:FilterBar>

        <!-- ===== Advertisements, same panel and auto-slide as on the booking
             page and the user manual page, kept under the filter bar ===== -->
        <VBox
            id="roomsAdWrap"
            class="roomsAdWrap sapUiMediumMarginTop"
            visible="{= ${AdvertisementModel>/Advertisements}.length > 0 }">
            <Title
                text="{i18n>advertisements}"
                class="roomsAdTitle"
            />
            <Panel
                class="adPanel panelbracket"
            >
                <VBox class="sapUiTinyMargin">
                    <Carousel
                        id="AdvertisementCarousel"
                        height="215px"
                        showPageIndicator="true"
                        arrowsPlacement="Content"
                        loop="true"
                        pages="{
                            path: 'AdvertisementModel>/Advertisements',
                            templateShareable: false
                        }"
                    >
                        <pages>
                            <Image
                                src="{AdvertisementModel>image}"
                                alt="{AdvertisementModel>title}"
                                width="100%"
                                height="170px"
                                press="onAdvertisementImagePress"
                            />
                        </pages>
                    </Carousel>
                </VBox>
            </Panel>
        </VBox>
    </VBox>

    <!-- ===== RIGHT SIDE: ROOMS GRID & CONTENT ===== -->
    <VBox width="100%" class="sapUiTinyMarginBegin roomsContentContainer">
        <!-- Rooms Grid -->
        <l:Grid
            id="idBedTypeFlex"
            defaultSpan="XL4 L4 M6 S12"
            containerQuery="true"
            hSpacing="1"
            vSpacing="1"
            content="{path: 'VisibilityModel>/Branches'}"
            visible="{= !${VisibilityModel>/NoData} }"
        >
            <VBox class="BranchCard sapUiTinyMargin">
                <!-- ===== IMAGE CAROUSEL ===== -->
                <Carousel
                    height="200px"
                    width="100%"
                    loop="true"
                    showPageIndicator="false"
                    backgroundDesign="Transparent"
                >
                    <pages>
                        <VBox class="imageWrapper">
                            <HBox class="areaTagBox">
                                <core:Icon
                                    src="sap-icon://building"
                                    size="0.9rem"
                                    color="black"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Text text="{VisibilityModel>PropertyType}" />
                            </HBox>
                            <Image
                                src="{VisibilityModel>Image}"
                                width="100%"
                                height="200px"
                                class="BranchCardImage"
                                decorative="false"
                            />
                        </VBox>
                    </pages>
                </Carousel>

                <!-- ===== CARD CONTENT ===== -->
                <VBox class="BranchCardContent">
                    <Text text="{= ${VisibilityModel>Name} + ' - ' + ${VisibilityModel>LandMark}}" class="BranchCardTitle" />
                    
                    <VBox alignItems="Center">
                        <List
                            class="ratingList"
                            showSeparators="None"
                            backgroundDesign="Transparent"
                            visible="{= !!${VisibilityModel>TotalFeedbacks} &amp;&amp; Number(${VisibilityModel>TotalFeedbacks}) > 0 }"
                        >
                            <CustomListItem type="Active" press=".onRatingPress" tooltip="Tap to See Reviews">
                                <HBox class="ratingInline" justifyContent="Center" alignItems="Center">
                                    <RatingIndicator
                                        value="{= Number(${VisibilityModel>AverageRating}) || 0 }"
                                        maxValue="5"
                                        enabled="true"
                                        editable="false"
                                        iconSize="1.35rem"
                                        class="ratingStars"
                                    />
                                    <Text text="{= '(' + ${VisibilityModel>TotalFeedbacks} + ')' }" class="ratingCountInline" />
                                </HBox>
                            </CustomListItem>
                        </List>
                        
                        <Title
                            text="{parts: ['VisibilityModel>Currency','VisibilityModel>StartingPrice'], formatter: '.Formatter.formatStartingPrice'}"
                            visible="{= !(${VisibilityModel>TotalFeedbacks} ? Number(${VisibilityModel>TotalFeedbacks}) > 0 : false) }"
                            class="branchCardPrice"
                        />
                        <Title
                            text="{parts: ['VisibilityModel>Currency','VisibilityModel>StartingPrice'], formatter: '.Formatter.formatStartingPrice'}"
                            visible="{= ${VisibilityModel>TotalFeedbacks} ? Number(${VisibilityModel>TotalFeedbacks}) > 0 : false }"
                        />
                    </VBox>

                    <HBox justifyContent="Center" alignItems="Center">
                        <Link
                            text="{i18n>ViewRooms}"
                            tooltip="{i18n>ViewRooms}"
                            press="viewRooms"
                            class="btnViewDetails"
                        />
                    </HBox>
                </VBox>
            </VBox>
        </l:Grid>

        <!-- No Data Message -->
        <VBox
            height="400px"
            justifyContent="Center"
            alignItems="Center"
            visible="{VisibilityModel>/NoData}"
        >
            <Text text="{i18n>noRoomsFound}" class="cssNoDataMessage" />
            <Text text="{i18n>pleaseselectanotherCity}" class="cssNoDataSubMessage" />
        </VBox>

        <!-- View More Button -->
        <VBox
            alignItems="Center"
            class="sapUiTinyMarginTop"
            visible="{VisibilityModel>/ShowViewMore}"
        >
            <Link
                id="idViewMoreBusy"
                text="{i18n>viewmorerooms}"
                press="onViewMoreRooms"
                class="btnViewDetails"
            />
            <VBox height="2rem" />
        </VBox>
    </VBox>

</HBox>

                                                <VBox
                                                    visible="{FooterModel>/showRoomsFooter}"
                                                    class="footer-shell"
                                                >
                                                    <core:Fragment
                                                        id="roomsFooter"
                                                        fragmentName="sap.ui.com.project1.fragment.quicklinks"
                                                        type="XML"
                                                    />
                                                </VBox>
                                            </VBox>
                                        </content>
                                    </ScrollContainer>
                                </VBox>
                            </Page>

                            <ScrollContainer
                                id="idVendor"
                                horizontal="false"
                                vertical="true"
                                height="100%"
                                class="svPage"
                            >
                                <VBox class="svWrap" width="100%" renderType="Bare">
                                    <core:Fragment
                                        fragmentName="sap.ui.com.project1.fragment.VendorHero"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="sap.ui.com.project1.fragment.VendorPropertyTypes"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="sap.ui.com.project1.fragment.VendorAdminModules"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="sap.ui.com.project1.fragment.VendorHowItWorks"
                                        type="XML"
                                    />
                                    <core:Fragment
                                        fragmentName="sap.ui.com.project1.fragment.VendorRegistration"
                                        type="XML"
                                    />
                                </VBox>
                                <VBox
                                    visible="{FooterModel>/showGlobalFooter}"
                                >
                                    <core:Fragment
                                        fragmentName="sap.ui.com.project1.fragment.quicklinks"
                                        type="XML"
                                    />
                                </VBox>
                            </ScrollContainer>

                            <ScrollContainer
                                id="idContact"
                                horizontal="false"
                                vertical="true"
                                height="100%"
                            >
                                <core:Fragment
                                    fragmentName="sap.ui.com.project1.fragment.ContactPage"
                                    type="XML"
                                />
                                    <VBox visible="{FooterModel>/showGlobalFooter}" class="sapUiMediumMarginTop">
                        <core:Fragment
                            fragmentName="sap.ui.com.project1.fragment.quicklinks"
                            type="XML"
                        />
                    </VBox>
                                <!-- <VBox height="1rem" /> -->
                            </ScrollContainer>
                            
                     
                        </pages>
                    </NavContainer>
               
                </items>
            </VBox>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>

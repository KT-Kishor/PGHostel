<mvc:View
    controllerName="sap.ui.com.project1.controller.MyBookings"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        id="idMyBookingsPage"
        title="My Bookings"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="defaultBGBlur"
    >
        <customHeader>
            <Bar class="barheader">
                <contentLeft>
                    <Button
                        icon="sap-icon://nav-back"
                        class="btnGradientHoverOnly"
                        tooltip="{i18n>back}"
                        press="onNavBack"
                    />
                </contentLeft>
                <contentMiddle>
                    <Title
                        text="My Bookings"
                        level="H4"
                    />
                </contentMiddle>
                <contentRight>
                    <Button
                        press="onLogPress"
                        tooltip="{i18n>logoutTooltip}"
                        icon="sap-icon://log"
                    />
                </contentRight>
            </Bar>
        </customHeader>

        <FlexBox
            direction="Row"
            justifyContent="SpaceBetween"
            alignItems="Center"
            wrap="Wrap"
            class="responsiveFlex sapUiSmallMargin customRoundedFlex"
        >
            <IconTabHeader
                id="idMyBookingsTabHeader"
                mode="Standard"
                select="onTableSelect"
                class="sapUiSmallMarginBottom"
            >
                <layoutData>
                    <FlexItemData maxWidth="100%" />
                </layoutData>
                <items>
                    <IconTabFilter
                        key="Booking History"
                        text="{= ${myBookings>/bookingCount} > 0 ? 'Booking History (' + ${myBookings>/bookingCount} + ')' : 'Booking History' }"
                    />
                    <IconTabFilter
                        key="Members"
                        text="{= ${myBookings>/memberCount} > 0 ? 'Members (' + ${myBookings>/memberCount} + ')' : 'Members' }"
                    />
                    <IconTabFilter
                        key="Payment"
                        text="{= ${myBookings>/paymentCount} > 0 ? 'Payment (' + ${myBookings>/paymentCount} + ')' : 'Payment' }"
                    />
                    <IconTabFilter
                        key="Complaints"
                        text="{= ${myBookings>/complainCount} > 0 ? 'Complaints (' + ${myBookings>/complainCount} + ')' : 'Complaints' }"
                    />
                    <IconTabFilter
                        key="Damage"
                        text="{= ${myBookings>/damageCount} > 0 ? 'Damage (' + ${myBookings>/damageCount} + ')' : 'Damage' }"
                    />
                </items>
            </IconTabHeader>

            <ToolbarSpacer />
            <HBox
                alignItems="Center"
                justifyContent="Start"
                class="customActionBox"
            >
                <Button
                    text="Add Members"
                    press="onPressAddMember"
                    class="myUnifiedBtn sapUiSmallMarginEnd"
                    visible="{= ${myBookings>/selectedTab} === 'Members' }"
                />
                <Button
                    text="Raise Complaint"
                    press="onPressRaiseComplaint"
                    class="myUnifiedBtn sapUiSmallMarginEnd"
                    enabled="{myBookings>/hasAssignedBooking}"
                />
                <SearchField
                    id="idMyBookingsSearch"
                    width="auto"
                    liveChange="onGlobalSearch"
                    placeholder="{i18n>search}"
                />
            </HBox>
        </FlexBox>

        <Table
            id="Id_MyBookingTable"
            visible="{= ${myBookings>/selectedTab} === 'Booking History' }"
            updateFinished="onTableUpdateFinished"
            busyIndicatorDelay="0"
            noDataText="No booking history found"
            items="{
                path: 'myBookings>/bookings',
                sorter: [
                    { path: 'bookingGroup', descending: false, group: true },
                    { path: 'BookingDateSort', descending: true },
                    { path: 'BookingID', descending: true  }
                ]
            }"
            width="auto"
            class="sapUiSmallMargin customRoundedTable"
        >
            <columns>
                <Column demandPopin="true">
                    <Text text="{i18n>bookingDate}" />
                </Column>
                <Column demandPopin="true">
                    <Text text="{i18n>bookingID}" />
                </Column>
                <Column demandPopin="true">
                    <Text text="{i18n>customerName}" />
                </Column>
                <Column
                    demandPopin="true"
                    minScreenWidth="Tablet"
                >
                    <Text text="{i18n>room}" />
                </Column>
                <Column
                    demandPopin="true"
                    minScreenWidth="Tablet"
                >
                    <Text text="{i18n>amount}" />
                </Column>
                <Column
                    demandPopin="true"
                    minScreenWidth="Tablet"
                >
                    <Text text="{i18n>status}" />
                </Column>
            </columns>
            <items>
                <ColumnListItem
                    type="Navigation"
                    press="onPressBookingRow"
                >
                    <cells>
                        <Text text="{myBookings>BookingDate}" />        
                        <Text text="{myBookings>BookingID}" />
                        <Text text="{myBookings>customerName}" />
                        <Text text="{myBookings>room}" />
                        <Text text="{path:'myBookings>amount', formatter:'.Formatter.fromatNumber'} {myBookings>currency}" />
                        <ObjectStatus
                            text="{myBookings>status}"
                            state="{path: 'myBookings>status', formatter: '.Formatter.formatObjectStatus'}"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <Table
            id="Id_MyBookingMemberTable"
            visible="{= ${myBookings>/selectedTab} === 'Members' }"
            updateFinished="onTableUpdateFinished"
            busyIndicatorDelay="0"
            noDataText="No members found"
            items="{path: 'myBookings>/Members'}"
            width="auto"
            class="sapUiSmallMargin customRoundedTable"
        >
            <columns>
                <Column demandPopin="true">
                    <Text text="{i18n>fullname}" />
                </Column>
                <Column demandPopin="true">
                    <Text text="{i18n>age}" />
                </Column>
                <Column demandPopin="true">
                    <Text text="{i18n>relation}" />
                </Column>
                <Column
                    demandPopin="true"
                    minScreenWidth="Tablet"
                >
                    <Text text="{i18n>document}" />
                </Column>
                <Column
                    demandPopin="true"
                    minScreenWidth="Tablet"
                />
            </columns>
            <items>
                <ColumnListItem type="Inactive">
                    <cells>
                        <Text text="{= ${myBookings>Salutation} + ' ' + ${myBookings>Name}}" />
                        <Text text="{path: 'myBookings>DateOfBirth', formatter: '.Formatter.formatAgeFromDOBOrAge'}" />
                        <Text text="{myBookings>Relation}" />
                        <Link
                            text="{i18n>view}"
                            press="onViewMemberDocument"
                        />
                        <Button
                            icon="sap-icon://edit"
                            type="Transparent"
                            tooltip="Upload Document"
                            press="onEditMemberFromDialog"
                            class="myUnifiedBtn"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <!-- ================= PAYMENT TABLE ================= -->
        <Table
            id="Id_PaymentTable1"
            noDataText="No Payment history found"
            visible="{= ${myBookings>/selectedTab} === 'Payment' }"
            updateFinished="onTableUpdateFinished"
            busyIndicatorDelay="0"
            items="{
                path:'myBookings>/Payments',
                sorter:[{ path:'PaymentGroup', group:true }]
            }"
            width="auto"
            class="sapUiSmallMargin customRoundedTable"
        >
            <columns>
                <Column demandPopin="true">
                    <Text text="{i18n>bookingID}" />
                </Column>
                <Column
                    demandPopin="true"
                    minScreenWidth="Tablet"
                >
                    <Text text="{i18n>invoiceDate}" />
                </Column>
                <Column
                    demandPopin="true"
                    minScreenWidth="Tablet"
                >
                    <Text text="{i18n>invoiceNo}" />
                </Column>
                <Column demandPopin="true">
                    <Text text="{i18n>customerName}" />
                </Column>
                <Column
                    demandPopin="true"
                    minScreenWidth="Desktop"
                >
                    <Text text="{i18n>totalAmount}" />
                </Column>
                <Column
                    demandPopin="true"
                    minScreenWidth="Desktop"
                >
                    <Text text="{i18n>invoiceDueRefAmount}" />
                </Column>
            </columns>

            <items>
                <ColumnListItem
                    type="Navigation"
                    press="onPressManageInvoice"
                >
                    <cells>
                        <Text text="{myBookings>BookingID}" />
                        <Text
                            text="{path:'myBookings>InvoiceDate', formatter:'.Formatter.formatDate'}"
                        />
                        <Text text="{myBookings>InvNo}" />
                        <Text text="{myBookings>CustomerName}" />
                        <Text
                            text="{path:'myBookings>TotalAmount', formatter:'.Formatter.fromatNumber'} {myBookings>currency}"
                        />
                        <Text
                            text="{path:'myBookings>DueAmount', formatter:'.Formatter.fromatNumber'} {myBookings>currency}"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <!-- ================= COMPLAINTS TABLE ================= -->
        <Table
            id="Id_MyBookingComplaintTable"
            visible="{= ${myBookings>/selectedTab} === 'Complaints' }"
            updateFinished="onTableUpdateFinished"
            busyIndicatorDelay="0"
            noDataText="No complaints history found"
            width="auto"
            class="sapUiSmallMargin customRoundedTable"
            items="{
                path: 'myBookings>/complain',
                sorter: [
                    { path: 'ComplaintStatus', descending: false, group: true },
                    { path: 'ComplaintRaisedDate', descending: true }
                ]
            }"
        >
            <columns>
                <Column demandPopin="true" minScreenWidth="Tablet">
                    <Text text="{i18n>bookingID}" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Tablet">
                    <Text text="{i18n>customerName}" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Tablet">
                    <Text text="{i18n>complainType}" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Phone">
                    <Text text="Branch" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Desktop">
                    <Text text="{i18n>roomNo}" />
                </Column>
                <Column demandPopin="true">
                    <Text text="{i18n>description}" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Tablet">
                    <Text text="{i18n>complainDate}" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Tablet">
                    <Text text="{i18n>expectedResolveddate}" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Tablet">
                    <Text text="{i18n>AssignedBy}" />
                </Column>
                <Column hAlign="Center" width="3rem" />
            </columns>
            <items>
                <ColumnListItem type="Inactive">
                    <cells>
                        <Text text="{myBookings>BookingID}" />
                        <Text text="{myBookings>CustomerName}" />
                        <Text text="{myBookings>ComplaintType}" />
                        <Text text="{myBookings>BranchName}" />
                        <Text text="{myBookings>RoomNo}" />
                        <ExpandableText text="{myBookings>ComplaintDescription}" maxCharacters="20" />
                        <Text text="{path:'myBookings>ComplaintRaisedDate', formatter:'.Formatter.formatDate'}" />
                        <Text text="{= ${myBookings>ExpectedResolvedDate} === '1899-11-30T00:00:00.000Z' || ${myBookings>ExpectedResolvedDate} === null ? '' : ${path: 'myBookings>ExpectedResolvedDate', formatter: '.Formatter.formatDate'}}" />
                        <Text text="{myBookings>AssignedTo}" />
                        <Button
                            icon="sap-icon://edit"
                            type="Transparent"
                            press="onPressComplaintRow"
                            tooltip="Edit Complaint"
                            visible="{path: 'myBookings>ComplaintStatus', formatter: '.Formatter.canEditComplaint'}"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <!-- ================= DAMAGE TABLE ================= -->
        <Table
            id="Id_MyBookingDamageTable"
            visible="{= ${myBookings>/selectedTab} === 'Damage' }"
            updateFinished="onTableUpdateFinished"
            busyIndicatorDelay="0"
            noDataText="No damage history found"
            width="auto"
            class="sapUiSmallMargin customRoundedTable"
            items="{
                path: 'myBookings>/damage',
                sorter: [{ path: 'Status', descending: false, group: true }]
            }"
        >
            <columns>
                <Column demandPopin="true" minScreenWidth="Tablet">
                    <Text text="Damage ID" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Tablet">
                    <Text text="Branch" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Tablet">
                    <Text text="Room No" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Tablet">
                    <Text text="Item" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Phone">
                    <Text text="Type" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Desktop">
                    <Text text="Description" />
                </Column>
                <Column demandPopin="true">
                    <Text text="Qty" />
                </Column>
                <Column demandPopin="true" minScreenWidth="Tablet">
                    <Text text="Cost" />
                </Column>
            </columns>
            <items>
                <ColumnListItem type="Inactive">
                    <cells>
                        <Text text="{myBookings>DamageID}" />
                        <Text text="{myBookings>BranchName}" />
                        <Text text="{myBookings>RoomNo}" />
                        <Text text="{myBookings>ItemName}" />
                        <Text text="{myBookings>Type}" />
                        <ExpandableText text="{myBookings>Description}" maxCharacters="20" />
                        <Text text="{myBookings>Quantity}" />
                        <Text text="{myBookings>Cost}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <footer>
            <core:Fragment
                fragmentName="sap.ui.com.project1.fragment.AppFooter"
                type="XML"
            />
        </footer>
    </Page>
</mvc:View>

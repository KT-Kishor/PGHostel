<mvc:View
    controllerName="sap.ui.com.project1.controller.EditBooking"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    displayBlock="true"
    xmlns:l="sap.ui.layout"
>
    <Page
        showHeader="true"
        enableScrolling="true"
        class="BookBGBlur"
    >
        <headerContent>
            <core:Fragment
                fragmentName="sap.ui.com.project1.fragment.BookingHeader"
                type="XML"
            />
        </headerContent>
        <l:Grid
            defaultSpan="XL12 L12 M12 S12"
            hSpacing="1"
            vSpacing="1"
            width="100%"
        >
            <l:content>
                <VBox>
                    <layoutData>
                        <l:GridData span="XL8 L8 M12 S12" />
                    </layoutData>
                    <!-- Booking Details Section -->
                    <Title
                        text="{i18n>assignRooms}"
                        class="booking-section-header"
                        wrapping="true"
                    />

                    <Panel
                        class="customBookingPanel booking-panel-enhanced panelbracket"
                    >
                        <MessageStrip
                            text="{i18n>checkinTime} {HostelModel>/CheckInTime}     {i18n>checkoutTime} {HostelModel>/CheckOutTime}"
                            showIcon="true"
                            showCloseButton="false"
                            class="sapUiTinyMarginBottom"
                        />

                        <f:SimpleForm
                            editable="true"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="4"
                            labelSpanL="4"
                            labelSpanM="4"
                            labelSpanS="12"
                            columnsXL="2"
                            columnsL="2"
                            columnsM="1"
                            class="responsiveForm"
                        >
<Label text="{i18n>property}" />

                            <Input
                                id="EditBookProperty_ID"
                                value="{= ${HostelModel>/Area} + (${HostelModel>/PropertyType} ? ' (' + ${HostelModel>/PropertyType} + ')' : '') }"
                                editable="false"
                            />

<Label text="{i18n>roomtype}" />


                            <Input
                                id="EditBookBedType_ID"
                                value="{= ${HostelModel>/BedType} + (${HostelModel>/ACType} ? ' (' + ${HostelModel>/ACType} + ')' : '') }"
                                editable="false"
                            />


                            
                            <Label
                                text="{i18n>roomplan}"
                                required="true"
                            />
                            <ComboBox
                                id="EditBookRoom_ID"
                                selectedKey="{HostelModel>/SelectedPriceType}"
                                items="{HostelModel>/AvailablePaymentMethods}"
                                selectionChange="onRoomPlanChange"
                                change="onRoomplane"
                                valueStateText="{i18n>selectRoomPlan}"
                                enabled="{BookingView>/editModeEnabled}"
                            >
                                <core:Item
                                    key="{HostelModel>key}"
                                    text="{HostelModel>text}"
                                />
                            </ComboBox>

                            <Label text="{i18n>rentPrice}" />
                            <Input
                                value="{
                                    parts: [
                                        { path: 'HostelModel>/FinalPrice' },
                                        { path: 'HostelModel>/Currency' }
                                    ],
                                    formatter: '._formatAmountToTwoDecimals'
                                }"
                                editable="false"
                            />
                       <Label text="{i18n>noPersons}" />
<Input
    value="{= (${HostelModel>/PropertyType} === 'Hostel' || ${HostelModel>/PropertyType} === 'PG') ? 1 : ${HostelModel>/Capacity} }"
    editable="false"
/>
                            <!-- <Label text="No. of Persons" />
                            <Input
                                value="{HostelModel>/SelectedPerson}"
                                editable="false"
                            /> -->

                            <Label
                                text="{i18n>duration}"
                                visible="{BookingView>/showDurationSelector}"
                            />
                            <ComboBox
                                id="EditBookDuration_ID"
                                class="boldSelectItems"
                                width="100%"
                                selectedKey="{HostelModel>/SelectedMonths}"
                                items="{BookingView>/DurationOptions}"
                                visible="{BookingView>/showDurationSelector}"
                                change="onDurationChange"
                                valueStateText="{i18n>selectDuration}"
                                enabled="{BookingView>/editModeEnabled}"
                            >
                                <core:Item
                                    key="{BookingView>key}"
                                    text="{BookingView>text}"
                                />
                            </ComboBox>

                            <Label
                                text="{i18n>startDate}"
                                required="true"
                            />
                            <DatePicker
                                id="EditBookStartdate_ID"
                                value="{HostelModel>/StartDate}"
                                valueFormat="dd/MM/yyyy"
                                displayFormat="dd/MM/yyyy"
                                minDate="{HostelModel>/TodayDate}"
                                change="onStartDateChange"
                                liveChange="onStartDateChange"
                                valueStateText="{i18n>selectValidStart}"
                                showValueStateMessage="true"
                                placeholder="{i18n>selectStartDate}"
                                enabled="{BookingView>/editModeEnabled}"
                            />

                            <Label
                                text="{i18n>endDate}"
                                required="{= ${HostelModel>/SelectedPriceType} === 'Per Day' }"
                            />
                            <DatePicker
                                id="EditBookEnddate_ID"
                                value="{HostelModel>/EndDate}"
                                valueFormat="dd/MM/yyyy"
                                displayFormat="dd/MM/yyyy"
                                minDate="{HostelModel>/EndDateMinDate}"
                                editable="{= ${BookingView>/endDateEditable} &amp;&amp; ${BookingView>/editModeEnabled} }"
                                valueStateText="{i18n>endDatemustbeafterStartDate}"
                                change="onEndDateChange"
                                liveChange="onEndDateChange"
                                showValueStateMessage="true"
                                placeholder="{i18n>selectEndDate}"
                            />
                           
                        </f:SimpleForm>
                    </Panel>

                    <!-- Guest Information Section -->
                    <Title
                        text="{i18n>selectOccupants}"
                        class="booking-section-header"
                        wrapping="true"
                    />

                    <Panel
                        class="customBookingPanel booking-panel-enhanced panelbracket"
                    >
                        <VBox class="sapUiTinyMargin">
                            <Input
                                id="EditmemberValueHelpInput"
                                value="{path: 'BookingView>/FamilyMembers', formatter: '.formatSelectedMembersSummary'}"
                                placeholder="{i18n>clickSelectAdd}"
                                showValueHelp="{BookingView>/editModeEnabled}"
                                valueHelpOnly="true"
                                valueHelpRequest="onMemberValueHelpRequest"
                                enabled="{BookingView>/editModeEnabled}"
                                visible="{BookingView>/editModeEnabled}"
                            />
                            <MessageStrip
                                text="{i18n>canChangeAny}"
                                type="Information"
                                showIcon="true"
                                showCloseButton="false"
                                class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                                visible="{BookingView>/showFamilySection}"
                            />

                            <Text
                                text="{path: 'BookingView>/FamilyMembers', formatter: '.formatSelectedMembersCount'}"
                                class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                            />

                            <VBox
                                class="sapUiTinyMarginBottom"
                                visible="{BookingView>/showFamilySection}"
                            >
                                <Text
                                    text="{i18n>primaryOccupantContact} {path: 'BookingView>/FamilyMembers', formatter: '.formatPrimaryOccupantName'}"
                                    class="sapUiSmallMarginBottom"
                                    visible="{= ${BookingView>/FamilyMembers}.length > 0 }"
                                />
                            </VBox>

                            <Table
                                items="{BookingView>/FamilyMembers}"
                                noDataText="{i18n>noMembersSelected}"
                                class="familyMembersTable tealTableRadio"
                            >
                                <columns>
                                    <Column
                                         id="EditprimaryColumn"
                                            width="6rem"
                                        visible="{BookingView>/showFamilySection}"
                                    >
                                        <Text text="{i18n>primary}" />
                                    </Column>

                                    <Column id="EditnameColumn">
                                        <Text text="{i18n>MVDname}" />
                                    </Column>
                                    <Column
                                      
                                    >
                                        <Text text="{i18n>age}" />
                                    </Column>
                                    <Column
                                        minScreenWidth="Tablet"
                                        demandPopin="true"
                                    >
                                        <Text text="{i18n>MVgender}" />
                                    </Column>
                                    <Column
                                             minScreenWidth="Tablet"
                                        demandPopin="true"
                                    >
                                        <Text text="{i18n>Relationship}" />
                                    </Column>
                                    <Column width="6rem" id="EditactionColumn"  >
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <RadioButton
                                                groupName="primaryOccupantGroup"
                                                selected="{BookingView>IsPrimary}"
                                                select="onPrimaryOccupantRadioSelect"
                                                visible="{BookingView>/showFamilySection}"
                                                enabled="{BookingView>/editModeEnabled}"
                                            />

                                            <Text  
                                                text="{= (${BookingView>Salutation} ? ${BookingView>Salutation} + ' ' : '') + (${BookingView>Name} || '')}"
                                                wrapping="true"
                                            />
                                            <Text 
                                                text="{path: 'BookingView>Age', formatter: '.Formatter.formatAgeFromDOBOrAge'}"
                                                wrapping="true"
                                            />

                                            <Text text="{BookingView>Gender}" />
                                            <Text
                                                text="{BookingView>Relation}"
                                            />

                                          
                                            <Button
                                                icon="sap-icon://delete"
                                                tooltip="{i18n>removeMember}"
                                                press="onDeleteFamilyMemberRow"
                                                class="myUnifiedBtn"
                                                enabled="{BookingView>/editModeEnabled}"
                                            />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </Panel>

                    <!-- Facilities Section -->
                    <Title
                        text="{i18n>facilities}"
                        class="booking-section-header"
                        wrapping="true"
                        visible="{= ${FacilityModel>/Facilities}.length > 0 }"
                    />

                    <Panel
                        class="customBookingPanel booking-panel-enhanced facilityBookingPanel panelbracket"
                        visible="{= ${FacilityModel>/Facilities}.length > 0 }"
                    >
                        <VBox class="sapUiTinyMargin">
                            <MessageStrip
                                text="{i18n>addOnlyFacilities_BKK}"
                                type="Information"
                                showIcon="true"
                                showCloseButton="false"
                                class="sapUiTinyMarginBottom facilityMessageStrip"
                            />

                            <HBox
                                width="100%"
                                alignItems="Center"
                                justifyContent="SpaceBetween"
                                class="facilitiesNavContainer facilityCarouselShell"
                            >
                                <Button
                                    id="facilityPrevBtn"
                                    icon="sap-icon://slim-arrow-left"
                                    press="onFacilityPrev"
                                    class="facilityNavBtn sapUiTinyMarginEnd myUnifiedBtn"
                                />

                                <HBox
                                    id="facilityViewport"
                                    width="100%"
                                    renderType="Bare"
                                    class="facilityViewport"
                                >
                                    <HBox
                                        id="facilityCardsContainer"
                                        renderType="Bare"
                                        class="facilityTrack"
                                    />
                                </HBox>

                                <Button
                                    id="facilityNextBtn"
                                    icon="sap-icon://slim-arrow-right"
                                    press="onFacilityNext"
                                    class="facilityNavBtn sapUiTinyMarginBegin myUnifiedBtn"
                                />
                            </HBox>
<!-- Dot indicators for mobile swipe navigation -->
<HBox
    id="facilityDotsContainer"
    justifyContent="Center"
    alignItems="Center"
    class="facilityDotsRow sapUiTinyMarginTop"
    visible="false"
/>

                        </VBox>
                    </Panel>
                </VBox>
            </l:content>

            <!-- Right Column - Takes full width on mobile, 35% on tablet/desktop -->

            <l:content>
                <VBox>
                    <layoutData>
                        <l:GridData span="XL4 L4 M12 S12" />
                    </layoutData>
                    <!-- Advertisement Carousel Section -->
                    <Title
                        text="{i18n>advertisements}"
                        class="booking-section-header"
                        wrapping="true"
                        visible="{= ${AdvertisementModel>/Advertisements}.length > 0 }"
                    />

                    <Panel
                        class="adPanel panelbracket"
                        visible="{= ${AdvertisementModel>/Advertisements}.length > 0 }"
                    >
                        <VBox class="sapUiTinyMargin">
                            <Carousel
                                id="AdvertisementCarousel"
                                visible="{= ${AdvertisementModel>/Advertisements}.length > 0 }"
                                showPageIndicator="true"
                                arrowsPlacement="Content"
                                loop="true"
                                pages="{
                                    path: 'AdvertisementModel>/Advertisements',
                                    templateShareable: false
                                }"
                            >
                                <pages>
                                    <Image
                                        src="{AdvertisementModel>image}"
                                        alt="{AdvertisementModel>title}"
                                        width="100%"
                                        height="300px"
                                        press="onAdvertisementImagePress"
                                    />
                                </pages>
                            </Carousel>
                        </VBox>
                    </Panel>

                    <!-- Coupon Section -->
                    <Title
                        text="{i18n>coupon}"
                        class="booking-section-header"
                        wrapping="true"
                    />

                    <Panel class="couponPanel panelbracket">
                        <HBox
                            width="100%"
                            alignItems="Center"
                            justifyContent="Start"
                            wrap="NoWrap"
                            class="sapUiTinyMarginTop"
                        >
                          
                               <Input
                    value="{HostelModel>/CouponCode}"
                                placeholder="{i18n>enterCouponCode}"
                                liveChange="onCouponLiveChange"
                                class="sapUiSmallMarginEnd couponInput"
                                width="100%"
                                maxLength="21"
                    enabled="{BookingView>/editModeEnabled}"
                    showValueHelp="true"
                    valueHelpRequest="BV_onOpenVH"
                    valueStateText="{i18n>modelValueState}"
                    submit="onApplyCoupon"
                >
                                <layoutData>
                                    <FlexItemData
                                        growFactor="1"
                                        shrinkFactor="1"
                                    />
                                </layoutData>
                            </Input>
                            <Button
                                text="{i18n>applyCoupon}"
                                press="onApplyCoupon"
                                class="myUnifiedBtn couponButton sapUiTinyMarginBegin"
                                visible="{= !${HostelModel>/AppliedCouponCode} }"
                                enabled="{BookingView>/editModeEnabled}"
                            >
                                <layoutData>
                                    <FlexItemData
                                        growFactor="0"
                                        shrinkFactor="0"
                                    />
                                </layoutData>
                            </Button>
                            <Button
                                text="{i18n>Remove}"
                                press="onRemoveCoupon"
                                class="myUnifiedBtn couponButton sapUiTinyMarginBegin"
                                visible="{= !!${HostelModel>/AppliedCouponCode} }"
                                enabled="{BookingView>/editModeEnabled}"
                            >
                                <layoutData>
                                    <FlexItemData growFactor="0" />
                                </layoutData>
                            </Button>
                        </HBox>
                    </Panel>

                    <!-- Payment Summary Section -->
                    <Title
                        text="{i18n>pricingDetails}"
                        class="booking-section-header"
                        wrapping="true"
                    />

                    <Panel
                        class="customBookingPanel booking-panel-enhanced panelbracket"
                    >
                        <VBox class="sapUiTinyMargin">
                            <MessageStrip
                                text="{HostelModel>/RefundMessage}"
                                type="Information"
                                showIcon="true"
                                showCloseButton="true"
                                visible="{HostelModel>/ShowRefundMessage}"
                                class="sapUiTinyMarginBottom"
                            />
                            <HBox
                                justifyContent="SpaceBetween"
                                alignItems="Center"
                                visible="{= ${BookingView>/showBusinessTravelOption} &amp;&amp; !!${HostelModel>/PropertyGSTIN} }"
                                class="sapUiTinyMarginBottom"
                            >
                                <Text text="{i18n>gstDetailsOptional}" />
                                <Switch
                                    state="{HostelModel>/IsBusinessTravel}"
                                    change="onBusinessTravelToggle"
                                    enabled="{= ${BookingView>/showBusinessTravelOption} &amp;&amp; ${BookingView>/editModeEnabled} }"
                                    class="tealSwitch"
                                />
                            </HBox>

                            <Label
                                required="true"
                                text="{i18n>gstNo}"
                                visible="{= ${BookingView>/showBusinessGSTSection} &amp;&amp; !!${HostelModel>/PropertyGSTIN} }"
                                class="sapUiTinyMarginBottom"
                            />
                            <Input
                                id="EditBookGst_ID"
                                value="{HostelModel>/CustomerGSTIN}"
                                placeholder="{i18n>enterGstin}"
                                visible="{= ${BookingView>/showBusinessGSTSection} &amp;&amp; !!${HostelModel>/PropertyGSTIN} }"
                                liveChange="onGSTINLiveChange"
                                change="onGSTINChange"
                                class="sapUiTinyMarginBottom"
                                valueStateText="{i18n>gstError}"
                                width="100%"
                                enabled="{BookingView>/editModeEnabled}"
                                maxLength="15"
                            />

                            <Label
                                required="true"
                                text="{i18n>companyName}"
                                visible="{= ${BookingView>/showBusinessGSTSection} &amp;&amp; !!${HostelModel>/PropertyGSTIN} }"
                                class="required-field-label sapUiTinyMarginBottom"
                            />
                            <Input
                                id="EditBookCompanyname_ID"
                                value="{HostelModel>/CompanyName}"
                                placeholder="{i18n>enterCompanyName}"
                                visible="{= ${BookingView>/showBusinessGSTSection} &amp;&amp; !!${HostelModel>/PropertyGSTIN} }"
                                class="sapUiTinyMarginBottom"
                                width="100%"
                                change="onchangeCompanyname"
                                liveChange="onchangeCompanyname"
                                valueStateText="{i18n>enterValidCompany}"
                                showValueStateMessage="true"
                                maxLength="100"
                                enabled="{BookingView>/editModeEnabled}"
                            />

                            <Label
                                required="true"
                                text="{i18n>companyAddress}"
                                visible="{= ${BookingView>/showBusinessGSTSection} &amp;&amp; !!${HostelModel>/PropertyGSTIN} }"
                                class="required-field-label sapUiTinyMarginBottom"
                            />
                            <TextArea
                                value="{HostelModel>/CompanyAddress}"
                                placeholder="{i18n>enterCompleteCompany}"
                                visible="{= ${BookingView>/showBusinessGSTSection} &amp;&amp; !!${HostelModel>/PropertyGSTIN} }"
                                rows="3"
                                class="sapUiTinyMarginBottom"
                                width="100%"
                                change="onchangeConpanyAddress"
                                liveChange="onchangeConpanyAddress"
                                valueStateText="{i18n>BK_enterValidCompany}"
                                showValueStateMessage="true"
                                id="EditBookconpanyAddress_ID"
                                maxLength="500"
                                growing="true"
                                growingMaxLines="5"
                                enabled="{BookingView>/editModeEnabled}"
                            />

                            <Title
                                text="{i18n>RoomGSTIN} {HostelModel>/PropertyGSTIN}"
                                level="H5"
                                class="sapUiSmallMarginTop sapUiTinyMarginBottom"
                                visible="{= !!${HostelModel>/EffectiveGSTType} &amp;&amp; !!${HostelModel>/PropertyGSTIN} }"
                            />

                            <Table
                                width="100%"
                                inset="false"
                                fixedLayout="Strict"
                                showSeparators="Inner"
                                class="pricingDetailsTable sapUiTinyMarginBottom"
                            >
                                <columns>
                                    <Column width="53%">
                                        <header>
<Title
    text="{i18n>Item}"
    level="H6"
/>

                                        </header>
                                    </Column>
                                    <Column
                                        width="47%"
                                        hAlign="End"
                                    >
                                        <header>
                                            <Title
                                                text="{= 'Amount (' + ${HostelModel>/Currency} + ')' }"
                                                level="H6"
                                            />
                                        </header>
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem vAlign="Bottom">
                                        <cells>
                                            <VBox
                                                class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                                            >
                                                <Title
                                                    text="{i18n>room}"
                                                    level="H6"
                                                />
                                                <Text
                                                    text="{HostelModel>/RoomBreakdownText}"
                                                    wrapping="true"
                                                    class="sapThemeBaseText sapUiTinyMarginTop"
                                                />
                                            </VBox>

                                            <VBox
                                                alignItems="End"
                                                justifyContent="End"
                                                class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                                            >
                                                <HBox
                                                    renderType="Bare"
                                                    justifyContent="End"
                                                >
                                                    <Text
                                                        text="{path: 'HostelModel>/RoomPrice', formatter: '.Formatter.fromatNumber'}"
                                                        class="sapUiTinyMarginEnd sapUiStrongText"
                                                    />
                                                    <Text
                                                        text="{HostelModel>/Currency}"
                                                        class="sapUiStrongText"
                                                    />
                                                </HBox>
                                            </VBox>
                                        </cells>
                                    </ColumnListItem>

                                    <!-- Per-facility-item breakdown -->
                                    <ColumnListItem
                                        vAlign="Middle"
                                        visible="{= ${HostelModel>/AllSelectedFacilities}.length > 0}"
                                    >
                                        <cells>
                                            <VBox class="sapUiTinyMarginTop sapUiTinyMarginBottom">
                                                <HBox alignItems="Center" wrap="NoWrap">
                                                    <Title text="{i18n>facilities}" level="H6" />
                                                    <core:Icon
                                                        id="editFacilitiesBreakdownIcon"
                                                        src="sap-icon://hint"
                                                        size="1rem"
                                                        color="#1a5f6b"
                                                        hoverColor="DarkBlue"
                                                        press="onFacilitiesBreakdownPress"
                                                        tooltip="{i18n>viewFacilitiesBreakdown}"
                                                        class="sapUiTinyMarginBegin"
                                                    />
                                                </HBox>
                                            </VBox>

                                            <HBox
                                                renderType="Bare"
                                                justifyContent="End"
                                                class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                                            >
                                                <Text
                                                    text="{path: 'HostelModel>/TotalFacilityPrice', formatter: '.Formatter.fromatNumber'}"
                                                    class="sapUiTinyMarginEnd sapUiStrongText"
                                                />
                                                <Text
                                                    text="{HostelModel>/Currency}"
                                                    class="sapUiStrongText"
                                                />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>

                                    <ColumnListItem
                                        vAlign="Middle"
                                        class="grandTotalBar"
                                    >
                                        <cells>
                                            <Title
                                                text="{i18n>BK_subTotal}"
                                                level="H6"
                                            />
                                            <HBox
                                                justifyContent="End"
                                                alignItems="Center"
                                                renderType="Bare"
                                            >
                                                <Title
                                                    text="{path: 'HostelModel>/SubTotalBeforeDiscount', formatter: '.Formatter.fromatNumber'}"
                                                    class="sapUiTinyMarginEnd"
                                                    level="H6"
                                                />
                                                <Title
                                                    text="{HostelModel>/Currency}"
                                                    level="H6"
                                                />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                    <ColumnListItem
                                        vAlign="Middle"
                                        visible="{= !!${HostelModel>/AppliedCouponCode} }"
                                        class="grandTotalBar"
                                    >
                                        <cells>
                                            <Title
                                                text="{= 'Coupon (' + ${HostelModel>/AppliedCouponCode} + ')' }"
                                                level="H6"
                                                wrapping="true"
                                            />
                                            <HBox
                                                justifyContent="End"
                                                alignItems="Center"
                                                renderType="Bare"
                                            >
                                                <Title
                                                    text="-{path: 'HostelModel>/AppliedDiscount', formatter: '.Formatter.fromatNumber'}"
                                                    level="H6"
                                                    class="sapUiTinyMarginEnd"
                                                />
                                                <Title
                                                    text="{HostelModel>/Currency}"
                                                    level="H6"
                                                />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>

                                    <ColumnListItem
                                        vAlign="Middle"
                                        visible="{= !!${HostelModel>/AppliedCouponCode} }"
                                        class="grandTotalBar"
                                    >
                                        <cells>
                                            <Title
                                                text="{i18n>discountedTotal}"
                                                level="H6"
                                            />
                                            <HBox
                                                justifyContent="End"
                                                alignItems="Center"
                                                renderType="Bare"
                                            >
                                                <Title
                                                    text="{path: 'HostelModel>/BookingNetSubTotal', formatter: '.Formatter.fromatNumber'}"
                                                    class="sapUiTinyMarginEnd"
                                                    level="H6"
                                                />
                                                <Title
                                                    text="{HostelModel>/Currency}"
                                                    level="H6"
                                                />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>

                                    <!-- <ColumnListItem
                                        vAlign="Middle"
                                        visible="{= !!${HostelModel>/CustomerGSTIN} }"
                                    >
                                        <cells>
                                            <Text text="Customer GSTIN" />
                                            <HBox
                                                justifyContent="End"
                                                alignItems="Center"
                                                renderType="Bare"
                                            >
                                                <Text
                                                    text="{HostelModel>/CustomerGSTIN}"
                                                />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem> -->

                                    <ColumnListItem
                                        vAlign="Middle"
                                        visible="{= ${HostelModel>/Tax} > 0}"
                                        class="greyGST"
                                    >
                                        <cells>
                                            <Text
                                                text="{= ${HostelModel>/EffectiveGSTValue} > 0 ? 'Tax (' + ${HostelModel>/EffectiveGSTValue} + '%)' : 'Tax'}"
                                            />

                                            <HBox
                                                justifyContent="End"
                                                alignItems="Center"
                                                renderType="Bare"
                                                class="greyGST"
                                            >
                                                <Text
                                                    text="{path: 'HostelModel>/Tax', formatter: '.Formatter.fromatNumber'}"
                                                    class="sapUiTinyMarginEnd"
                                                />
                                                <Text
                                                    text="{HostelModel>/Currency}"
                                                />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                    <ColumnListItem
                                        vAlign="Middle" 
                                        class="grandTotalBar grandTotalFinalRow"
                                    >
                                        <cells>
                                            <Title
                                                text="{i18n>BK_grandTotal}"
                                                level="H3"
                                                titleStyle="H3"
                                            />
                                            <HBox
                                                justifyContent="End"
                                                alignItems="Center"
                                                renderType="Bare"
                                            >
                                                <Title
                                                    text="{path: 'HostelModel>/GrandTotal', formatter: '.Formatter.fromatNumber'}"
                                                    level="H3"
                                                    titleStyle="H3"
                                                    class="sapUiTinyMarginEnd"
                                                    wrapping="true"
                                                />
                                                <Title
                                                    text="{HostelModel>/Currency}"
                                                    level="H3"
                                                    titleStyle="H3"
                                                    wrapping="true"
                                                />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>

                            <MessageStrip
                                text="{= 'Security deposit to be paid at check-in: ' + ${path: 'HostelModel>/Deposit', formatter: '.Formatter.fromatNumber'} + ' ' + ${HostelModel>/DepositCurrency}}"
                                type="Success"
                                showIcon="true"
                                showCloseButton="false"
                                visible="{= ${HostelModel>/Deposit} > 0}"
                                class="sapUiSmallMarginBottom sapUiLargeMarginTop"
                            />
                        </VBox>
                    </Panel>
                </VBox>
            </l:content>
        </l:Grid>

        <footer>
          	<Bar>
            <contentLeft>
            <FlexBox class="profile-footer-scroll-text" alignItems="Center">
            <items>
                <FlexBox class="profile-footer-marquee" alignItems="Center"> 
             <Image src="../image/TransparentKTlogo.png" width="30px" height="30px" />
             <Link
                text="{i18n>devlopby}"
                href="https://kalpavrikshatechnologies.com/"
                target="_blank"
                class="customLinkWhiteBg"
            />
                </FlexBox>
            </items>
            </FlexBox>
            </contentLeft>
				<contentRight>
                <Button
                    text="{= ${BookingView>/editModeEnabled} ? ${i18n>UpdateBooking} : ${i18n>EditBooking} }"
                    class="myUnifiedBtn"
                    press="onToggleEditUpdate"
                    visible="{= ${BookingView>/showEditButton} || ${BookingView>/editModeEnabled} }"
                />
                <Button
                    text="{i18n>actionCancel}"
                    class="myUnifiedBtn"
                    press="onCancelEditPress"
                    visible="{BookingView>/editModeEnabled}"
                />
                <Button
                    text="{i18n>cancelBooking}"
                    class="myUnifiedBtn"
                    press="onPressCancelBooking"
                    visible="{= ${BookingView>/showEditButton} &amp;&amp; !${BookingView>/editModeEnabled} }"
                />
                  </contentRight>
			</Bar>
        </footer>
    </Page>
</mvc:View>

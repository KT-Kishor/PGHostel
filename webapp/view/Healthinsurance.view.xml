<mvc:View
    controllerName="sap.ui.com.project1.controller.Healthinsurance"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    displayBlock="true"
    xmlns:u="sap.ui.unified"
    xmlns:m="sap.m"
>
		<Page
			showHeader="true"
              navButtonPress="onNavBack"
        showNavButton="true"
        class="myUnifiedBtn"
        title="{i18n>InsuranceApplication}"
			>
                <!-- <headerContent>
            <core:Fragment
                fragmentName="sap.ui.com.project1.fragment.Header"
                type="XML"
            />
        </headerContent> -->
    <uxap:ObjectPageLayout
        id="insuranceObjectPage"
        showTitleInHeaderContent="true"
        useIconTabBar="false"
        showAnchorBar="true"
        showFooter="true"
        upperCaseAnchorBar="false"

    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title
                        text="{= (${HealthInsuranceModel>/sPath} === 'Health' ? ${i18n>Health} : ${i18n>Travel}) + ' ' + ${i18n>insurence} }"
                        level="H1"
                    />
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <Title
                        text="{= (${HealthInsuranceModel>/sPath} === 'Health' ? ${i18n>Health} : ${i18n>Travel}) + ' ' + ${i18n>insurence} }"
                        level="H2"
                    />
                </uxap:snappedHeading>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <!-- HEALTH INSURANCE -->
        <uxap:sections>
            <uxap:ObjectPageSection
                id="personalInfoSection"
                title="{i18n>personalInformation}"
                visible="{= ${HealthInsuranceModel>/sPath} === 'Health' }"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <uxap:blocks>
                            <!-- Your existing Personal Information SimpleForm -->
                            <f:SimpleForm
                                editable="true"
                                layout="ColumnLayout"
                                columnsXL="2"
                                columnsL="2"
                                columnsM="1"
                                labelSpanXL="3"
                                labelSpanL="3"
                                labelSpanM="4"
                                labelSpanS="12"
                                singleContainerFullSize="false"
                                class="sapUiMediumMarginBottom sapUiSmallMarginTop"
                            >
                                <f:content>
                                    <Label
                                        text="{i18n>adminBookingNCFullName}"
                                        required="true"
                                    />
                                    <Input
                                        id="Id_fullName"
                                        value="{HealthInsuranceModel>/fullName}"
                                        placeholder="{i18n>enterFullName}"
                                        maxLength="100"
                                        liveChange="onInputChange"
                                        valueStateText="{i18n>enterFullName}"
                                    />

                                    <Label
                                        text="{i18n>emailId}"
                                        required="true"
                                    />
                                    <Input
                                        id="Id_email"
                                        type="Email"
                                        value="{HealthInsuranceModel>/email}"
                                        placeholder="{i18n>enterEmailId}"
                                        liveChange="onEmailliveChange"
                                        valueStateText="Enter the mail"
                                    />

                                    <Label
                                        text="{i18n>mobileNo}"
                                        required="true"
                                    />
                                    <Input
                                        id="ID_mobileNumber"
                                        type="Tel"
                                        value="{HealthInsuranceModel>/mobileNumber}"
                                        maxLength="10"
                                        placeholder="{i18n>Enterthemobilenumber}"
                                        liveChange="onInputMobileChange"
                                        valueStateText="{i18n>Enterthemobilenumber}"
                                    />

                                    <Label
                                        text="{i18n>InsurancePlan}"
                                        required="true"
                                    />
                                    <ComboBox
                                        id="insurancePlan"
                                        selectedKey="{HealthInsuranceModel>/insurancePlan}"
                                        placeholder="{i18n>Selectinsuranceplan}"
                                        change="onInsurancePlanChange"
                                        valueStateText="{i18n>Selectinsuranceplan}"
                                    >
                                        <core:Item
                                            key="Individual"
                                            text="{i18n>IndividualHealthInsurance}"
                                        />
                                        <core:Item
                                            key="Family"
                                            text="{i18n>FamilyHealthInsurance}"
                                        />
                                    </ComboBox>

                                    <Label
                                        text="{i18n>Doyouhaveanypreviousdiseases}"
                                        required="true"
                                    />
                                    <TextArea
                                        id="ID_diseases"
                                        value="{HealthInsuranceModel>/diseases}"
                                        placeholder="{i18n>Enteryouhaveanypreviousdiseases}"
                                        valueStateText="{i18n>Enteryouhaveanypreviousdiseases}"
                                        liveChange="onInputChange"
                                        maxLength="200"
                                    />

                                    <Label
                                        text="{i18n>Weight}"
                                        required="true"
                                    />

                                    <Input
                                        id="ID_Weight"
                                        value="{HealthInsuranceModel>/Weight}"
                                        maxLength="3"
                                        placeholder="{i18n>EnteryourWeightinkgs}"
                                        liveChange="onInputMobileChange"
                                        valueStateText="{i18n>EnteryourWeightinkgs}"
                                    />

                                    <Label
                                        text="{i18n>BloodGroup}"
                                        required="true"
                                    />
                                    <ComboBox
                                        id="ID_BloodGroup"
                                        selectedKey="{HealthInsuranceModel>/BloodGroup}"
                                        placeholder="{i18n>SelectBloodGroup}"
                                        change="onBloodGroupChange"
                                        valueStateText="{i18n>SelectBloodGroup}"
                                        width="100%"
                                    >
                                        <core:Item
                                            key="A+"
                                            text="A+"
                                        />
                                        <core:Item
                                            key="A-"
                                            text="A-"
                                        />
                                        <core:Item
                                            key="B+"
                                            text="B+"
                                        />
                                        <core:Item
                                            key="B-"
                                            text="B-"
                                        />
                                        <core:Item
                                            key="AB+"
                                            text="AB+"
                                        />
                                        <core:Item
                                            key="AB-"
                                            text="AB-"
                                        />
                                        <core:Item
                                            key="O+"
                                            text="O+"
                                        />
                                        <core:Item
                                            key="O-"
                                            text="O-"
                                        />
                                    </ComboBox>
                                </f:content>
                            </f:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Section 2: Member Information -->
            <uxap:ObjectPageSection
                id="memberInfoSection"
                title="{i18n>MemberInformation}"
                visible="{= ${HealthInsuranceModel>/sPath} === 'Health' }"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="">
                        <uxap:blocks>
                            <!-- Keep your existing Member Information content here -->
                            <VBox class="sapUiMediumMarginBottom">
                                <HBox
                                    alignItems="Center"
                                    justifyContent="SpaceBetween"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <VBox>
                                        <Title
                                            text="{i18n>documentDetails}"
                                            level="H4"
                                        />
                                        <Text
                                            text="{i18n>Adddateofbirthforeachinsuredmember}"
                                        />
                                    </VBox>

                                    <ObjectStatus
                                        text="{i18n>Required}"
                                        state="Information"
                                    />
                                </HBox>

                          <FlexBox
    alignItems="Center"
    wrap="Wrap"
    width="100%"
    class="sapUiSmallMarginBottom memberCountRow">

    <core:Icon
        src="sap-icon://group"
        size="1.5rem"
        />

    <Label
        text="{i18n>NumberofMembers}"
         class="memberlabel"/>

    <StepInput
        id="memberCount"
        min="1"
        max="6"
        value="1"
        step="1"
        change="onMemberCountChange"
        width="8rem" />

</FlexBox>

                                <VBox
                                    id="memberDobContainer"
                                    width="100%"
                                    class="memberDobContainer"
                                />
                            </VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                      
                </uxap:subSections>
            </uxap:ObjectPageSection>
    <uxap:ObjectPageSection
                title="{i18n>documentinfo}"
                visible="{= ${HealthInsuranceModel>/sPath} === 'Health' }"
            >
                <uxap:subSections>
             <uxap:ObjectPageSubSection>
        <uxap:blocks>
            <VBox
                width="100%">

                <MessageStrip
                    text="{i18n>healthinsurencemessagestrip}"
                    type="Information"
                    showIcon="true"
                    showCloseButton="false"
                    class="sapUiSmallMarginBottom" />
           
             

<VBox width="100%" class="aadhaarUploadContainer">
    <HBox
        width="100%"
        alignItems="Center"
        class="aadhaarAttachmentRow">

        <Label
            text="{i18n>AadhaarCardAttachment}"
            labelFor="aadhaarUploader"
            class="aadhaarAttachmentLabel" />

        <u:FileUploader
            id="aadhaarUploader"
            name="aadhaarCard"
            fileType="pdf,png,jpg,jpeg"
            mimeType="application/pdf,image/png,image/jpeg"
            maximumFileSize="5"
            placeholder="{i18n>ChooseAadhaarcarddocument}"
            buttonText="Browse"
            width="100%"
            multiple="true"
            change="onAadhaarAttachmentChange">

            <u:layoutData>
                <m:FlexItemData growFactor="0.5" />
            </u:layoutData>
        </u:FileUploader>
    </HBox>

    <!-- Selected files appear below, each with its own Remove button -->
    <VBox
        id="aadhaarUploadedFiles"
        width="100%"
        class="sapUiSmallMarginTop" />
</VBox>



                <Text
                    text="{i18n>acceptedDocumentFormats}"
                    class="sapUiTinyMarginTop sapUiSmallMarginBottom" />

            </VBox>
        </uxap:blocks>
    </uxap:ObjectPageSubSection>
         </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- TRAVEL INSURANCE -->
            <uxap:ObjectPageSection
                title="{i18n>TravelInsurance}"
                visible="{= ${HealthInsuranceModel>/sPath} !== 'Health' }"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="{i18n>TripInformation}">
                        <uxap:blocks>
                            <f:SimpleForm
                                editable="true"
                                layout="ColumnLayout"
                                columnsXL="2"
                                columnsL="2"
                                columnsM="1"
                                labelSpanXL="3"
                                labelSpanL="3"
                                labelSpanM="4"
                                labelSpanS="12"
                                singleContainerFullSize="false"
                                class="sapUiMediumMarginBottom sapUiSmallMarginTop"
                            >
                                <f:content>
                                    <Label
                                        text="{i18n>TravelType}"
                                        required="true"
                                    />
                                    <ComboBox
                                        id="idtype"
                                        selectedKey="{HealthInsuranceModel>/insurancePlan}"
                                        placeholder="{i18n>Selecttraveltype}"
                                        change="onInsurancePlanChange"
                                        valueStateText="{i18n>Selecttraveltype}"
                                    >
                                        <core:Item
                                            key="International Trip"
                                            text="{i18n>InternationalTrip}"
                                        />
                                        <core:Item
                                            key="Student Travel"
                                            text="{i18n>StudentTravel}"
                                        />
                                    </ComboBox>

                                    <Label
                                        text="{i18n>Destination}"
                                        required="true"
                                    />
                                    <MultiComboBox
                                        id="id_Destination"
                                        selectedKeys="{HealthInsuranceModel>/destination}"
                                        placeholder="{i18n>Selectdestination}"
                                        items="{path:'CountryModel>/', length:1000}"
                                        change="onDestinationChange"
                                        valueStateText="{i18n>Selectdestination}"
                                    >
                                        <core:ListItem
                                            key="{CountryModel>countryName}"
                                            text="{CountryModel>countryName}"
                                        />
                                    </MultiComboBox>
                                    <Label text="{i18n>NumberofTravellers}" />
                                    <StepInput
                                        id="memberCount1"
                                        min="1"
                                        max="10"
                                        value="{HealthInsuranceModel>/totalTravellers}"
                                        step="1"
                                        change="onTravellerCountChange"
                                    />
                                    <Label
                                        text="{i18n>startDate}"
                                        required="true"
                                    />
                                    <DatePicker
                                        id="id_startDate"
                                        value="{HealthInsuranceModel>/startDate}"
                                        minDate="{HealthInsuranceModel>/minDate}"
                                        displayFormat="dd/MM/yyyy"
                                        valueFormat="yyyy-MM-dd"
                                        placeholder="{i18n>selectStartDate}"
                                        valueStateText="{i18n>selectStartDate}"
                                        change="onDateChange"
                                    />

                                    <Label
                                        text="{i18n>endDate}"
                                        required="true"
                                    />
                                    <DatePicker
                                        id="id_endDate"
                                        value="{HealthInsuranceModel>/endDate}"
                                        displayFormat="dd/MM/yyyy"
                                        valueFormat="yyyy-MM-dd"
                                        placeholder="{i18n>selectEndDate}"
                                        valueStateText="{i18n>selectEndDate}"
                                        change="onDateChange"
                                    />

                                    <!-- Traveller forms are added here by the controller -->
                                </f:content>
                            </f:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>

        <!-- FOOTER -->
        <uxap:footer>
            <OverflowToolbar class="footerBtnBarInsurance">
                <Image
                    src="../image/TransparentKTlogo.png"
                    width="30px"
                    height="30px"
                />

                <Link
                    text="{i18n>devlopby}"
                    href="https://kalpavrikshatechnologies.com/"
                    target="_blank"
                    class="customLinkWhiteBg"
                />

                <ToolbarSpacer />

                <Button
                    text="{i18n>CancelButton}"
                    press="onNavBack"
                    class="myUnifiedBtn"
                />

                <Button
                    text="{i18n>submit}"
                    class="myUnifiedBtn"
                    press="onSubmitPress"
                    visible="{= ${HealthInsuranceModel>/sPath} !== 'Health' }"
                />

                <Button
                    text="{i18n>submit}"
                    class="myUnifiedBtn"
                    press="onhealthSubmitPress"
                    visible="{= ${HealthInsuranceModel>/sPath} === 'Health' }"
                />
            </OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
    		</Page>

</mvc:View>

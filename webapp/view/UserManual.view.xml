<mvc:View
	controllerName="sap.ui.com.project1.controller.UserManual"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	displayBlock="true">
	<Page id="manualPage1"  class="umPage">

		<!-- ===== Top bar ===== -->
		<customHeader>
			<Toolbar class="umTopbar" height="64px">
			<Image
                src="./image/SVLogo.png"
                height="2.5rem"
                class="logoFix"
                press="onBack"
            />
				
				<VBox class="umTitleBlock">
					<Title text="User Manuals" level="H1" class="umTitle" />
					<Text text="Short video walkthroughs and printable guides for every feature." class="umSubtitle" />
				</VBox>
				<ToolbarSpacer />
				<Button
					icon="sap-icon://home"
					type="Transparent"
					class="umBackBtn myUnifiedBtn"
					press="onBack"
					tooltip="Go back" />
				<SearchField
					id="topicSearch1"
					width="260px"
					placeholder="Search topics"
					liveChange="onSearch"
					class="umSearch" />
			</Toolbar>
		</customHeader>

		<content>
			<VBox class="umWrap">

				<!-- ===== Cards, two per row ===== -->
				<FlexBox
					id="cardGrid1"
					items="{manual>/topics}"
					wrap="Wrap"
					class="umGrid">

					<VBox class="umCard" 	visible="{
							parts: [
								{ path: 'manual>excludeRoles' },
								{ path: 'LoginModel>/Role' },
								{ path: 'manual>showWhenNoRole' }
							],
							formatter: '.isCardVisible'
						}">

						<HBox class="umCardHead" alignItems="Center">
							<core:Icon src="{manual>icon}" class="umIcon" />
							<VBox class="umCardHeadText">
								<Title text="{manual>title}" level="H2" class="umCardTitle" />
								<Text text="{manual>meta}" class="umMeta" />
							</VBox>
						</HBox>
<VBox class="umDescriptionBox">

    <Text
        text="{
            parts: [
                { path: 'manual>description' },
                { path: 'manual>expanded' }
            ]
          
        }"
        class="umDesc" />

   

</VBox>
						<HBox class="umActions" justifyContent="End">
							<Button
								text="Video Guide"
								
								type="Emphasized"
								class="umBtnPrimary myUnifiedBtn"
								press="onViewDemo" />
							<Button 
    text="Download Guide" 
   
    type="Default" 
    class="umBtnGhost myUnifiedBtn" 
    press="onDownloadGuide">

    <customData>
        <core:CustomData
            key="pdfFile"
            value="{manual>guideUrl}" />
    </customData>

</Button>
						</HBox>

					</VBox>
				</FlexBox>

				<Text id="emptyState1" text="No topics match that search" class="umEmpty" visible="false" />

			</VBox>
		</content>
	</Page>

</mvc:View>
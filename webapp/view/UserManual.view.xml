<mvc:View
	controllerName="sap.ui.com.project1.controller.UserManual"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	displayBlock="true">
	<Page id="manualPage1"  class="umPage tocPage">

		<!-- ===== Top bar ===== -->
		<!-- The page title lives in the banner below, so the bar keeps only the
		     navigation and the search. -->
		<customHeader>
			<Toolbar class="umTopbar" height="64px">
			<Image
                src="./image/SVLogo.png"
                height="2.5rem"
                class="logoFix"
                press="onBack"
            />
				
				<ToolbarSpacer />
				<Button
					icon="sap-icon://home"
					type="Transparent"
					class="umBackBtn myUnifiedBtn"
					press="onBack"
					tooltip="{i18n>goBack}" />
				<SearchField
					id="topicSearch1"
					width="260px"
					placeholder="{i18n>searchTopics}"
					liveChange="onSearch"
					class="umSearch" />
			</Toolbar>
		</customHeader>

		<content>
			<VBox class="umRoot">

				<!-- =====================  BANNER  ===================== -->
				<!-- Same banner as on the policy page: it carries the page
				     identity, so the title is not repeated in the top bar. -->
				<VBox class="bannerWrap">
					<VBox class="bannerIn">
						<HBox class="crumb" alignItems="Center" wrap="Wrap">
							<Link text="{i18n>home}"
								  class="crumbLink"
								  tooltip="{i18n>home}"
								  press=".onCrumbHome"/>
							<Text text="/" class="crumbSep"/>
							<Text text="{i18n>userManuals}" class="crumbCurrent"/>
						</HBox>

						<Title text="{i18n>userManuals}"
							   level="H1"
							   class="bannerTitle"/>

						<Text text="{i18n>shortVideoWalkthroughs}"
							  class="bannerSub"/>
					</VBox>
				</VBox>

				<HBox class="mainWrap" alignItems="Start">

					<!-- ======== INDEX ======== -->
					<!-- The same panel as on the policy page: it lists the topics
					     that are on screen and scrolls to the one that is picked. -->
					<VBox class="tocCol" id="umTocCol">
						<Panel id="umTocPanel"
							   class="tocPanel"
							   expandable="true"
							   expanded="true"
							   headerText="{i18n>policyOnThisPage}"
							   expand=".onTocToggle"
							   collapse=".onTocToggle"
							   width="100%">
							<VBox class="tocBody" id="umTocBody">
								<VBox id="umTocList" class="tocList"
									  items="{umIndex>/items}">
									<Link text="{umIndex>title}"
										  class="tocLink _link"
										  press=".onTocPress">
										<customData>
											<core:CustomData key="target"
															 value="{umIndex>target}"
															 writeToDom="true"/>
										</customData>
									</Link>
								</VBox>
								<Text text="{i18n>noTopicsMatch}"
									  class="umTocEmpty"
									  visible="{umIndex>/empty}"/>
							</VBox>
						</Panel>
					</VBox>

					<!-- ======== CARDS ======== -->
					<VBox class="umWrap umCol">

						<!-- ===== Cards, two per row ===== -->
						<FlexBox
							id="cardGrid1"
							items="{manual>/topics}"
							wrap="Wrap"
							class="umGrid">

							<VBox class="umCard" 	visible="{
									parts: [
										{ path: 'manual>excludeRoles' },
										{ path: 'LoginModel>/Role' },
										{ path: 'manual>showWhenNoRole' },
										{ path: 'manual>matchesSearch' }
									],
									formatter: '.isCardVisible'
								}">
				<HBox class="umCardHead" alignItems="Center">
		        <core:Icon src="{manual>icon}" class="umIcon" />
		        <VBox class="umCardHeadText">
		            <!-- Fetch translated Title -->
		            <Title text="{path: 'manual>titleKey', formatter: '.Formatter.getI18nText'}" level="H2" class="umCardTitle" />
		            <!-- Fetch translated Meta text -->
		            <Text text="{path: 'manual>metaKey', formatter: '.Formatter.getI18nText'}" class="umMeta" />
		        </VBox>
		    </HBox>
		<VBox class="umDescriptionBox">
		        <!-- Fetch translated Description with expanded state -->
		        <Text text="{
		            parts: [
		                { path: 'manual>descKey' },
		                { path: 'manual>expanded' }
		            ],
		            formatter: '.Formatter.getI18nDescription'
		        }" class="umDesc" />
		    </VBox>
								<HBox class="umActions" justifyContent="End">
									<Button
										text="{i18n>videoGuide}"
										
										type="Emphasized"
										class="umBtnPrimary myUnifiedBtn"
										press="onViewDemo" />
									<Button 
		    text="{i18n>downloadGuide}" 
		   
		    type="Default" 
		    class="umBtnGhost myUnifiedBtn" 
		    press="onDownloadGuide">

		    <customData>
		        <core:CustomData
		            key="pdfFile"
		            value="{manual>guideUrl}" />
		    </customData>

		</Button>
								</HBox>

							</VBox>
						</FlexBox>

						<Text id="emptyState1" text="{i18n>noTopicsMatch}" class="umEmpty" visible="false" />

					</VBox>

				</HBox>

				<!-- ===== Quick links footer ===== -->
				<VBox class="quickLinksWrap">
					<core:Fragment
						fragmentName="sap.ui.com.project1.fragment.quicklinks"
						type="XML" />
				</VBox>
			</VBox>
		</content>
	</Page>

</mvc:View>

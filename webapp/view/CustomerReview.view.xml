<mvc:View
    controllerName="sap.ui.com.project1.controller.CustomerReview"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:m="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:f="sap.f"
    xmlns:et="sap.m"
    xmlns:card="sap.ui.integration.widgets"
>
    <Page showHeader="true">
        <headerContent>
            <core:Fragment
                fragmentName="sap.ui.com.project1.fragment.Header"
                type="XML"
            />
        </headerContent>
        <content>
            <VBox class="sapUiSmallMargin">
                <Title
                    text="{i18n>customerSReview}"
                    level="H3"
                    class="sapUiTinyMarginBottom"
                />
                <fb:FilterBar
                    id="CR_id_Filterbar"
                    useToolbar="false"
                    clear="CR_onPressClear"
                    showClearOnFB="true"
                    search="CR_onSearch"
                    showFilterConfiguration="false"
                    class="filterBarTheme"
                >
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem
                            name="BranchCode"
                            label="{i18n>branchIdName}"
                            groupName="Group"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <ComboBox
                                    id="CR_id_Branch"
                                    items="{BranchFilterModel>/}"
                                    showClearIcon="true"
                                    filterSecondaryValues="true"
                                    placeholder="{i18n>selectBranchId}"
                                    showSecondaryValues="true"
                                >
                                    <core:ListItem
                                        key="{BranchFilterModel>BranchCode}"
                                        text="{BranchFilterModel>BranchCode}"
                                        additionalText="{BranchFilterModel>Name}"
                                    />
                                </ComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem
                            name="FeedbackDate"
                            label="{i18n>feedbackDate}"
                            groupName="Group"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <DateRangeSelection
                                    id="CR_id_BranchCode"
                                    valueFormat="yyyy-MM-dd"
                                    displayFormat="dd/MM/yyyy"
                                    change="onDateRangeChange"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem
                            name="Rating"
                            label="{i18n>rating}"
                            groupName="Group"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiComboBox
                                    id="CR_id_Rating"
                                    showClearIcon="true"
                                >
                                    <core:Item
                                        key="1"
                                        text="{i18n>star1}"
                                    />
                                    <core:Item
                                        key="2"
                                        text="{i18n>stars2}"
                                    />
                                    <core:Item
                                        key="3"
                                        text="{i18n>stars3}"
                                    />
                                    <core:Item
                                        key="4"
                                        text="{i18n>stars4}"
                                    />
                                    <core:Item
                                        key="5"
                                        text="{i18n>stars5}"
                                    />
                                </MultiComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem
                            name="sort"
                            label="{i18n>sort}"
                            groupName="Group"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <ComboBox
                                    id="CR_id_Sort"
                                    showClearIcon="true"
                                >
                                    <core:Item
                                        key="1"
                                        text="{i18n>highestLowestRating}"
                                    />
                                    <core:Item
                                        key="2"
                                        text="{i18n>lowestHighestRating}"
                                    />
                                    <core:Item
                                        key="3"
                                        text="{i18n>latestDate}"
                                    />
                                    <core:Item
                                        key="4"
                                        text="{i18n>oldestDate}"
                                    />
                                </ComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
                <m:ScrollContainer
                    horizontal="false"
                    vertical="true"
                    class="sapUiResponsiveContentPadding"
                >
                    <m:VBox
                        id="CR_id_ReviewContainer"
                        class="reviewGrid"
                    />
                </m:ScrollContainer>
            </VBox>
        </content>
        <footer>
         <core:Fragment
                fragmentName="sap.ui.com.project1.fragment.AppFooter"
                type="XML"
            />
        </footer>
    </Page>
</mvc:View>

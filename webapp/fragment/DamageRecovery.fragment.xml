<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        id="DT_id_DamageRecoverDialog"
        title="{i18n>ReturnDamage}"
        contentWidth="500px"
        stretch="false"
        afterClose="onDialogAfterClose">
        <content>
            <form:SimpleForm
                id="DT_id_DamageRecoveryForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false">

                <!-- Customer ID -->
                <Label text="{i18n>bookingID}"/>
                <Text text="{DamageModel>/BookingID}"/>
                <!-- Customer Name -->
                <Label text="{i18n>customerName}"/>
                <Text text="{DamageModel>/CustomerName}"/>
                <!-- Damage Amount -->
                <Label text="{i18n>damageAmount}"/>
                <Text text="{parts:[{path:'DamageModel>/TotalCost'},{path:'DamageModel>/Currency'}],formatter:'.Formatter.formatCurrency'}"/>
              
                <!-- Return Amount -->
                <Label text="{i18n>actualcost}"/>
                <Text text="{parts:[{path:'DamageModel>/TotalCost'},{path:'DamageModel>/Currency'}],formatter:'.Formatter.formatCurrency'}"/>
               
                <!-- Return Amount -->
                <Label text="{i18n>recoverAmount}" />
                <Text text="{parts:[{path:'DamageModel>/RecoverCost'},{path:'DamageModel>/Currency'}],formatter:'.Formatter.formatCurrency'}"/>

                <!-- Return Mode -->
                <Label text="{i18n>paymentMode}" required="true"/>
                <ComboBox
                    id="DT_id_ReturnMode"
                    selectedKey="{DamageModel>/ReturnDamageMode}"
                    placeholder="{i18n>selectReturnMode}"
                    change="_onReturnModeChange" valueStateText="{i18n>selectReturnMode}" items="{PaymentMode>/}">
                    <core:ListItem key="{PaymentMode>Mode}" text="{PaymentMode>Mode}"/>
                   
                </ComboBox>

                <!-- Transaction ID -->
                <Label text="{i18n>transactionIdPerson}"/>
                <Input
                    id="DT_id_ReturnTransactionID"
                    value="{DamageModel>/ReturnDamageTransactionID}"
                    placeholder="{i18n>enterTransactionPerson}"
                    liveChange="_validateTransactionID" valueStateText="{i18n>enterTransactionPerson}"   enabled="{DamageModel>/ReturnTransactionEnabled}" />

                <!-- Returning Employee -->
                <Label text="{i18n>returning_801c}"/>
                <Text text="{LoginModel>/EmployeeName}"/>
            </form:SimpleForm>
        </content>
        <buttons>
            <Button text="{i18n>ReturnDamage}" press="onSaveReturn" class="marginRight myUnifiedBtn"/>
            <Button text="{i18n>actionCancel}" press="onDialogClose" class="marginRight myUnifiedBtn"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
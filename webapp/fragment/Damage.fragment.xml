<c:FragmentDefinition
	xmlns="sap.m"
	xmlns:c="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified">
	<Dialog type="Message" class="sapUiContentPadding" contentWidth="28rem" contentHeight="auto">
		<customHeader>
			<Bar class="barheader">
				<contentMiddle>
					<Title text="{i18n>manageDamageDetails}" />
				</contentMiddle>
			</Bar>
		</customHeader>
		<f:SimpleForm
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="3"
            labelSpanL="3"
            labelSpanM="3"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="2"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="false">
			<f:content>
				<!-- Booking ID -->
				<Label text="{i18n>bookingID}" required="true"/>
				<ComboBox id="HD_id_BookingID" width="100%" change="onChangeAddCustomer"
                    items="{CustomerModel>/}" showSecondaryValues="true" editable="{DamageModel>/BookingIDEditable}" selectedKey="{DamageModel>/BookingID}" valueStateText="{i18n>bookingIDValueState}">
					<core:ListItem key="{CustomerModel>BookingID}" text="{CustomerModel>BookingID}"
                additionalText="{CustomerModel>CustomerName}"/>
				</ComboBox>
				<!-- Customer Name -->
				<Label text="{i18n>customerName}" />
				<Input id="HR_id_CustomerName"
                    value="{DamageModel>/CustomerName}"
                    placeholder="{i18n>enterCustomerName}" editable="false"
                />
                <!-- Customer Email -->
                <Label text="{i18n>customerEmail}" />
                <Input id="HD_id_CustomerEmail"
                    value="{DamageModel>/CustomerEmail}"
                    placeholder="{i18n>enterCustomerEmail}" editable="false"
                />
				<!-- Room Number -->
				<Label text="{i18n>roomNo}" />
				<Input id="HD_id_RoomNo"
                    value="{DamageModel>/RoomNo}"
                    placeholder="{i18n>enterRoomNumber}" editable="false"
                />
				<!-- Bed Type Name -->
				<Label text="{i18n>bedTypeName}" />
				<Input id="HD_id_BedTypeName"
                    value="{DamageModel>/BedTypeName}"
                    placeholder="{i18n>enterBedType}" editable="false"
                />
				<!-- Branch Code -->
				<Label text="{i18n>branchCode}" />
				<Input id="HD_id_BranchCode"
                    value="{DamageModel>/BranchCode}"
                    placeholder="{i18n>enterBranchCode}" editable="false"
                />
                <!-- Type  -->
                <Label text="{i18n>type}" />
                <ComboBox  id="HD_id_Type" value="{DamageModel>/Type}" change="onchangeType"
                valueStateText="{i18n>selectType}" placeholder="{i18n>selectType_206c}">
                    <core:Item key="Damage" text="{i18n>damage}"/>
                    <core:Item key="Missing" text="{i18n>missing}"/>
                 </ComboBox>
				<!-- Item Name -->
				<Label text="{i18n>ItemName}" required="true"/>
				<Input id="HD_id_ItemName"
                    value="{DamageModel>/ItemName}"
                    placeholder="{i18n>enterDamagedItem}" maxLength="50"
                    valueStateText="{i18n>itemValueState}"
                    liveChange="onLiveChangeItemName"
                />
				<!-- Description -->
				<Label text="{i18n>description}" required="true"/>
				<TextArea id="HD_id_Description"
                    value="{DamageModel>/Description}"
                    rows="2"
                    maxLength="200"
                    width="100%"
                    placeholder="{i18n>enterDamageDescription}"
                    valueStateText="{i18n>descriptionValueState}" liveChange="onLiveChangeDescription"
                />
				<!-- Cost -->
				<Label text="{i18n>cost}" required="true"/>
				<Input id="HD_id_Cost"
                    value="{DamageModel>/Cost}" maxLength="10"
                    placeholder="{i18n>enterEstimatedCost}"
                    valueStateText="{i18n>costValueState}"
                    width="100%" liveChange="onLiveChangeCost"
                />
                <!-- Currency -->
                <Label text="{i18n>currency}"/>
                <Input id="HD_id_Currency" value="{DamageModel>/Currency}" editable="false"></Input>
				<!-- Date -->
				<Label text="{i18n>date}" required="true"/>
				<DatePicker id="HD_id_DamageDate"
                    value="{DamageModel>/Date}"
                    displayFormat="dd/MM/yyyy"
                    valueFormat="dd/MM/yyyy" 
                    valueStateText="{i18n>dateValueState}"
                    width="100%" change="onChangeDamageDate"
                />
				<!-- Status -->
				<Label text="{i18n>status}"/>
                <Input value="{DamageModel>/Status}" editable="false" id="HD_id_Status"></Input>
			</f:content>
		</f:SimpleForm>
		<beginButton>
			<Button
                text="{i18n>save}"
                tooltip="{i18n>save}"
                press="HD_onsavebuttonpress"
                id="HD_id_saveButton"
                class="marginRight myUnifiedBtn"
            />
		</beginButton>
		<endButton>
			<Button
                text="{i18n>CancelButton}"
                tooltip="{i18n>CancelButton}"
                press="HD_onCancelButtonPress"
                id="HD_id_CancelButton"
                class="marginRight myUnifiedBtn"
            />
		</endButton>
	</Dialog>
</c:FragmentDefinition>
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="videoDialog"
        title="{dialog>/title}"
        contentWidth="800px"
        contentHeight="500px"
     >

        <content>

           <core:HTML
    id="videoFrameHtml_Manual"
    content="&lt;div style='position:relative;width:100%;padding-top:56.25%;overflow:hidden;background:#000;'&gt;

        &lt;video
            id='umPlayer'
            controls
            muted
            playsinline
            style='position:absolute;top:0;left:0;width:100%;height:100%;object-fit:contain;border:none;background:#000;'&gt;

            &lt;source
                id='umVideoSource'
                src=''
                type='video/mp4'&gt;

            Your browser does not support the video tag.

        &lt;/video&gt;

    &lt;/div&gt;" />

        </content>

        <endButton>

            <Button
                text="{i18n>close}"
                press="onCloseVideoDialog" />

        </endButton>

    </Dialog>

</core:FragmentDefinition>
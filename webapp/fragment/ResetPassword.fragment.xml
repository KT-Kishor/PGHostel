<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="RP_id_dialog"
        title="{i18n>resetPasswordsTitle}"
        draggable="true"
        resizable="true"
        contentWidth="900px"
        class="resetPasswordDialog"
        afterClose="onRPAfterClose"
    >
        <content>
            <VBox
                width="100%"
                class="resetPasswordContent"
            >
                <HBox
                    width="100%"
                    wrap="Wrap"
                    alignItems="Start"
                    class="resetPasswordColumns"
                >
                    <!-- ================= LEFT COLUMN ================= -->
                    <VBox
                        width="100%"
                        class="resetPasswordColumn"
                    >
                        <layoutData>
                            <FlexItemData
                                growFactor="3"
                                shrinkFactor="1"
                                baseSize="0"
                            />
                        </layoutData>
                        <MessageStrip
                            id="RP_id_infoStrip"
                            text="{i18n>resetPasswordInfoStrip}"
                            type="Information"
                            showIcon="true"
                            class="resetPasswordStrip"
                        />

                        <Panel
                            headerText="{i18n>resetPasswordFilterGroup}"
                            class="resetPasswordFilterPanel"
                            expandable="false"
                        >
                            <f:SimpleForm
                                editable="true"
                                layout="ResponsiveGridLayout"
                                labelSpanXL="3"
                                labelSpanL="3"
                                labelSpanM="3"
                                labelSpanS="12"
                                columnsXL="1"
                                columnsL="1"
                                columnsM="1"
                                adjustLabelSpan="false"
                                class="resetPasswordFilterForm"
                            >
                                <Label
                                    text="{i18n>resetPasswordEmailFilter}"
                                    required="true"
                                />
                                <ComboBox
                                    id="RP_id_email"
                                    width="100%"
                                    showSecondaryValues="true"
                                    filterSecondaryValues="true"
                                    selectedKey="{RPModel>/selectedEmail}"
                                    placeholder="{i18n>resetPasswordEmailPlaceholder}"
                                    valueStateText="{i18n>resetPasswordSelectUser}"
                                    selectionChange="onRPEmailSelect"
                                    change="onRPEmailChange"
                                    items="{RPModel>/users}"
                                >
                                    <core:ListItem
                                        key="{RPModel>EmailID}"
                                        text="{RPModel>EmailID}"
                                        additionalText="{RPModel>UserName}"
                                    />
                                </ComboBox>
                            </f:SimpleForm>
                        </Panel>

                        <Panel
                            headerText="{i18n>resetPasswordUserDetails}"
                            class="resetPasswordSectionPanel"
                            expandable="false"
                            visible="{RPModel>/hasSelection}"
                        >
                            <VBox class="resetPasswordDetailsList">
                                <HBox
                                    alignItems="Center"
                                    class="resetPasswordDetailRow"
                                >
                                    <Label
                                        text="{i18n>fullname}"
                                        width="8rem"
                                        class="resetPasswordDetailLabel"
                                    />
                                    <Text
                                        text="{= (((${RPModel>/selected/Salutation} || '') + ' ' + (${RPModel>/selected/UserName} || '')).trim()) || '-' }"
                                        class="resetPasswordDetailValue"
                                    />
                                </HBox>

                                <HBox
                                    alignItems="Center"
                                    class="resetPasswordDetailRow"
                                >
                                    <Label
                                        text="{i18n>resetPasswordColUserId}"
                                        width="8rem"
                                        class="resetPasswordDetailLabel"
                                    />
                                    <Text
                                        text="{= ${RPModel>/selected/UserID} || '-' }"
                                        class="resetPasswordDetailValue"
                                    />
                                </HBox>

                                <HBox
                                    alignItems="Center"
                                    class="resetPasswordDetailRow"
                                >
                                    <Label
                                        text="{i18n>email}"
                                        width="8rem"
                                        class="resetPasswordDetailLabel"
                                    />
                                    <Text
                                        text="{= ${RPModel>/selected/EmailID} || '-' }"
                                        class="resetPasswordDetailValue"
                                    />
                                </HBox>

                                <HBox
                                    alignItems="Center"
                                    class="resetPasswordDetailRow"
                                >
                                    <Label
                                        text="{i18n>MSmobileNo}"
                                        width="8rem"
                                        class="resetPasswordDetailLabel"
                                    />
                                    <Text
                                        text="{= (((${RPModel>/selected/STDCode} || '') + ' ' + (${RPModel>/selected/MobileNo} || '')).trim()) || '-' }"
                                        class="resetPasswordDetailValue"
                                    />
                                </HBox>

                                <HBox
                                    alignItems="Center"
                                    class="resetPasswordDetailRow"
                                >
                                    <Label
                                        text="{i18n>MVrole}"
                                        width="8rem"
                                        class="resetPasswordDetailLabel"
                                    />
                                    <Text
                                        text="{= ${RPModel>/selected/Role} || '-' }"
                                        class="resetPasswordDetailValue"
                                    />
                                </HBox>

                                <HBox
                                    alignItems="Center"
                                    class="resetPasswordDetailRow"
                                >
                                    <Label
                                        text="{i18n>resetPasswordCurrentStatus}"
                                        width="8rem"
                                        class="resetPasswordDetailLabel"
                                    />
                                    <HBox
                                        alignItems="Center"
                                        class="resetPasswordDetailValue"
                                    >
                                        <ObjectStatus
                                            text="{path: 'RPModel>/selected/Status', formatter: '.Formatter.formatAccountStatus'}"
                                            state="{path: 'RPModel>/selected/Status', formatter: '.Formatter.formatAccountStatusState'}"
                                        />
                                    </HBox>
                                </HBox>
                            </VBox>
                        </Panel>
                    </VBox>

                    <!-- ================= RIGHT COLUMN ================= -->
                    <VBox
                        width="100%"
                        class="resetPasswordColumn"
                    >
                        <layoutData>
                            <FlexItemData
                                growFactor="2"
                                shrinkFactor="1"
                                baseSize="0"
                            />
                        </layoutData>

                        <Panel
                            headerText="{i18n>resetPasswordChangeStatusSection}"
                            class="resetPasswordSectionPanel"
                            expandable="false"
                        >
                            <VBox class="resetPasswordSectionBody">
                                <MessageStrip
                                    text="{i18n>resetPasswordInactiveWarning}"
                                    type="Warning"
                                    showIcon="false"
                                    class="resetPasswordStatusStrip"
                                />

                                <HBox
                                    alignItems="Center"
                                    width="100%"
                                    class="resetPasswordActionRow"
                                >
                                    <ComboBox
                                        id="RP_id_newStatus"
                                        width="100%"
                                        enabled="{RPModel>/hasSelection}"
                                        selectedKey="{RPModel>/newStatus}"
                                        placeholder="{i18n>resetPasswordNewStatus}"
                                        valueStateText="{i18n>resetPasswordStatusRequired}"
                                        selectionChange="onRPNewStatusChange"
                                        items="{RPModel>/statusOptions}"
                                    >
                                        <layoutData>
                                            <FlexItemData
                                                growFactor="1"
                                                shrinkFactor="1"
                                            />
                                        </layoutData>
                                        <core:Item
                                            key="{RPModel>key}"
                                            text="{RPModel>text}"
                                        />
                                    </ComboBox>
                                    <Button
                                        id="RP_id_updateStatusBtn"
                                        text="{i18n>resetPasswordUpdateStatus}"
                                        type="Emphasized"
                                        enabled="{RPModel>/hasSelection}"
                                        press="onRPUpdateStatusPress"
                                        class="myUnifiedBtn"
                                    >
                                        <layoutData>
                                            <FlexItemData
                                                growFactor="0"
                                                shrinkFactor="0"
                                            />
                                        </layoutData>
                                    </Button>
                                </HBox>
                            </VBox>
                        </Panel>

                        <Panel
                            headerText="{i18n>resetPasswordResetSection}"
                            class="resetPasswordSectionPanel"
                            expandable="false"
                        >
                            <VBox class="resetPasswordSectionBody">
                                <Text
                                    text="{i18n>resetPasswordRule}"
                                    class="resetPasswordRule"
                                />

                                <Input
                                    id="RP_id_password"
                                    type="Password"
                                    width="100%"
                                    maxLength="40"
                                    enabled="{RPModel>/hasSelection}"
                                    value="{RPModel>/password}"
                                    placeholder="{i18n>resetPasswordNew}"
                                    liveChange="onRPPasswordLiveChange"
                                    change="onRPPasswordChange"
                                    showValueStateMessage="false"
                                    showValueHelp="true"
                                    valueHelpIconSrc="sap-icon://show"
                                    valueHelpRequest="onRPTogglePasswordVisibility"
                                />

                                <Text
                                    id="RP_id_pwdStrength"
                                    text=""
                                    class="resetPasswordStrength pwdMinFail"
                                />

                                <Input
                                    id="RP_id_confirmPassword"
                                    type="Password"
                                    width="100%"
                                    maxLength="40"
                                    enabled="{RPModel>/hasSelection}"
                                    value="{RPModel>/confirmPassword}"
                                    placeholder="{i18n>resetPasswordConfirm}"
                                    liveChange="onRPConfirmPasswordLiveChange"
                                    change="onRPConfirmPasswordChange"
                                    valueStateText="{i18n>nopasswordmatch}"
                                    showValueHelp="true"
                                    valueHelpIconSrc="sap-icon://show"
                                    valueHelpRequest="onRPTogglePasswordVisibility"
                                />

                                <Button
                                    id="RP_id_resetPasswordBtn"
                                    text="{i18n>resetPasswordResetSection}"
                                    type="Emphasized"
                                    enabled="{RPModel>/hasSelection}"
                                    press="onRPResetPasswordPress"
                                    class="myUnifiedBtn sapUiSmallMarginTop"
                                />
                            </VBox>
                        </Panel>
                    </VBox>
                </HBox>
            </VBox>
        </content>

        <buttons>
            <Button
                id="RP_id_closeBtn"
                text="{i18n>close}"
                press="onRPCancel"
                class="myUnifiedBtn"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>

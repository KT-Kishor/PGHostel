<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="DepositDialog"
        title="{i18n>DepositHeader}"
        contentWidth="35rem"
        contentHeight="auto"
        draggable="true"
        resizable="true"
        afterClose="onEditDialogAfterClose"
        escapeHandler=".onEditDialogEscape">

        <f:SimpleForm
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="4"
            labelSpanM="6"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="2"
            columnsL="2"
            columnsM="1">

            <f:content>

                <!-- Booking ID -->
                <Label text="{i18n>bookingID}"/>
                <Text id="depositBookingID" text="{DepositModel>BookingID}"/>

                <!-- Customer Name -->
                <Label text="{i18n>customerName}"/>
                <Text id="depositCustomerName" text="{DepositModel>CustomerName}"/>

                <!-- Deposit Date -->
                <Label text="{i18n>DdepositDate}" required="true"/>
                <DatePicker
                    id="depositDate"
                    value="{DepositModel>DepositDate}"
                    displayFormat="dd/MM/yyyy"
                    change="ondepositdate"
                    valueFormat="yyyy-MM-dd"
                    valueStateText="{i18n>enterDepositDate}"
                    />

                <!-- Deposit Amount -->
                <Label text="{i18n>depositAmount}" required="true"/>
                <Input
                    id="depositAmount"
                    value="{DepositModel>DepositAmount}"
                    type="Number"
                    maxLength="10"
                    placeholder="{i18n>enterDepositAmount}"/>

                <!-- Deposit Mode -->
                <Label text="{i18n>depositMode}" required="true"/>
                 <ComboBox
                    id="depositModeTxn"
                    selectedKey="{DepositModel>DepositMode}"
                     change="onDepositmodeChange"
                    placeholder="{i18n>cashUpiTransaction}"
                    valueStateText="{i18n>selectDepositMode}"
                    >
                    <core:ListItem
                        key="UPI"
                        text="{i18n>uPI}"
                    />
                      <core:ListItem
                        key="Cash"
                        text="{i18n>cash_3910}"
                    />

                    </ComboBox>
                <Label text="{i18n>invoiceTransactionID}"/>
                <Input
                    id="depositTransactionID"
                    value="{DepositModel>DepositTransactionID}"
                    placeholder="{i18n>enterTransactionId_eac2}"
                    enabled="{= ${DepositModel>DepositMode} === 'UPI' || ${DepositModel>DepositMode} === 'Card' }"/>


                <!-- Received By -->
                <Label text="{i18n>depositTakenBy}"/>
                <Input
                    id="takenBy"
                    value="{DepositModel>DepositTakenBy}"
                    placeholder="{i18n>enterStaffName}" editable="false"/>

                <!-- Return Date -->
                <Label text="{i18n>returnDate}" required="true"/>
                <DatePicker
                    id="returnDate"
                    visible="{=${DepositModel>Status} === 'Returned'}"
                    change="onreturndate"
                    value="{DepositModel>ReturnDepositDate}"
                    displayFormat="dd/MM/yyyy"
                    valueFormat="yyyy-MM-dd"
                    valueStateText="{i18n>enterReturnDate}"
                    />

                <!-- Return Amount -->
                <Label text="{i18n>returnAmount}" required="true"/>
                <Input
                visible="{=${DepositModel>Status} === 'Returned'}"
                    id="returnAmount"
                    type="Number"
                    maxLength="10"
                    value="{DepositModel>ReturnDepositAmount}"
                    placeholder="{i18n>enterReturnAmount_1265}"/>

                <!-- Return Mode -->
                <Label text="{i18n>returnMode}" required="true"/>
                <ComboBox
                visible="{=${DepositModel>Status} === 'Returned'}"
                    id="returnModeTxn"
                    change="onreturnModechange"
                    valueStateText="{i18n>selectReturnMode}"
                    selectedKey="{DepositModel>ReturnDepositMode}"
                    placeholder="{i18n>cashUpiTransaction}">
                    <core:ListItem
                        key="UPI"
                        text="{i18n>uPI}"
                    />
                      <core:ListItem
                        key="Cash"
                        text="{i18n>cash_3910}"
                    />
            

                    </ComboBox>
                <Label text="{i18n>invoiceTransactionID}"/>
                <Input
                    id="returnTransactionID"
                    visible="{=${DepositModel>Status} === 'Returned'}"
                    value="{DepositModel>ReturnDepositTransactionID}"
                    placeholder="{i18n>enterTransactionId_eac2}"
                    enabled="{= ${DepositModel>ReturnDepositMode} === 'UPI' || ${DepositModel>ReturnDepositMode} === 'Card' }"/>

                <!-- Return By -->
                <Label text="{i18n>returnDepositBy}"/>
                <Input
                visible="{=${DepositModel>Status} === 'Returned'}"
                    id="returnBy"
                    value="{DepositModel>ReturnDepositBy}"
                    placeholder="{i18n>enterStaffName}" editable="false"/>

            </f:content>
        </f:SimpleForm>

        <beginButton>
            <Button
                text="{i18n>save}"
                class="myUnifiedBtn"
                press="onSaveDeposit"/>
        </beginButton>

        <endButton>
            <Button
                text="{i18n>CancelButton}"
                class="myUnifiedBtn"
                press="onCancelDeposit"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
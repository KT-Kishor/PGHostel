<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        title="Compare Packages"
        contentWidth="90%"
        contentHeight="70%"
        resizable="true"
        draggable="true"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <Title text="Select Packages to Compare" level="H4" class="sapUiTinyMarginBottom"/>
                <HBox items="{comparisonModel>/allPackages}" wrap="Wrap" class="sapUiSmallMarginBottom">
                    <items>
                        <CheckBox text="{comparisonModel>PackageName}" selected="{comparisonModel>Checked}" select="onToggleComparePackage" class="sapUiSmallMarginEnd"/>
                    </items>
                </HBox>
                <Table items="{comparisonModel>/rows}">
                    <columns>
                        <Column demandPopin="true">
                            <Text text="Feature" />
                        </Column>
                        <Column visible="{comparisonModel>/selectedTiers/Basic}" demandPopin="true">
                            <Text text="Basic" />
                        </Column>
                        <Column visible="{comparisonModel>/selectedTiers/Silver}" demandPopin="true" minScreenWidth="Tablet">
                            <Text text="Silver" />
                        </Column>
                        <Column visible="{comparisonModel>/selectedTiers/Gold}" demandPopin="true" minScreenWidth="Tablet">
                            <Text text="Gold" />
                        </Column>
                        <Column visible="{comparisonModel>/selectedTiers/Platinum}" demandPopin="true" minScreenWidth="Tablet">
                            <Text text="Platinum" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{comparisonModel>Application}" />
                                <core:Icon
                                    src="{= (${comparisonModel>Basic} === 1 || ${comparisonModel>Basic} === true) ? 'sap-icon://accept' : 'sap-icon://decline' }"
                                    color="{= (${comparisonModel>Basic} === 1 || ${comparisonModel>Basic} === true) ? 'Positive' : 'Negative' }"
                                />
                                <core:Icon
                                    src="{= (${comparisonModel>Silver} === 1 || ${comparisonModel>Silver} === true) ? 'sap-icon://accept' : 'sap-icon://decline' }"
                                    color="{= (${comparisonModel>Silver} === 1 || ${comparisonModel>Silver} === true) ? 'Positive' : 'Negative' }"
                                />
                                <core:Icon
                                    src="{= (${comparisonModel>Gold} === 1 || ${comparisonModel>Gold} === true) ? 'sap-icon://accept' : 'sap-icon://decline' }"
                                    color="{= (${comparisonModel>Gold} === 1 || ${comparisonModel>Gold} === true) ? 'Positive' : 'Negative' }"
                                />
                                <core:Icon
                                    src="{= (${comparisonModel>Platinum} === 1 || ${comparisonModel>Platinum} === true) ? 'sap-icon://accept' : 'sap-icon://decline' }"
                                    color="{= (${comparisonModel>Platinum} === 1 || ${comparisonModel>Platinum} === true) ? 'Positive' : 'Negative' }"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>


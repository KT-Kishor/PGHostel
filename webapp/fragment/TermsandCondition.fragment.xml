<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="termsDialog"
        contentWidth="80%"
        draggable="true"
        resizable="true"
        class="termsDialog">
         <customHeader>
        <Bar>
            <contentLeft>
                <Title text="Terms and Conditions" />
            </contentLeft>

            <contentRight>
                <Button
                    icon="sap-icon://decline"
                    press="onTermsDialogClose"
                     tooltip="{i18n>close}"
                      type="Transparent"
                    class="myUnifiedBtn" />
            </contentRight>
        </Bar>
    </customHeader>

        <content>
            <core:HTML
                id="termsPdfFrame"
                content="&lt;iframe
                    class='terms-pdf-iframe'
                    title='Terms and Conditions'
                    src='Documents/TermsAndConditions.pdf#navpanes=0'
                    frameborder='0'
                    allow='fullscreen'&gt;
                &lt;/iframe&gt;" />
        </content>
    </Dialog>

</core:FragmentDefinition>
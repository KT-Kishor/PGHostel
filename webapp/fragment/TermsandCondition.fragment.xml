<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="termsDialog"
        title="Terms and Conditions"
        contentWidth="80%"
        draggable="true"
        resizable="true"
        class="termsDialog">

        <content>
            <core:HTML
                id="termsPdfFrame"
                content="&lt;iframe
                    class='terms-pdf-iframe'
                    title='Terms and Conditions'
                    src='Documents/TermsAndConditions.pdf'
                    frameborder='0'
                    allow='fullscreen'&gt;
                &lt;/iframe&gt;" />
        </content>

        <buttons>
            <Button
                text="Download"
                icon="sap-icon://download"
                type="Emphasized"
                press="onDownloadTerms" class="myUnifiedBtn" />

            <Button
                text="Close"
                press="onTermsDialogClose" class="myUnifiedBtn" />
        </buttons>

    </Dialog>

</core:FragmentDefinition>
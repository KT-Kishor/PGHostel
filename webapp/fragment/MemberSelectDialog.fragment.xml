<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="memberSelectDialog"
        class="memberSelectDialog"
        contentWidth="64rem"
        contentHeight="32rem"
        stretchOnPhone="true"
        draggable="true"
        resizable="true"
    >
        <customHeader>
            <OverflowToolbar class="memberDialogHeader">
                <Title text="{i18n>SelectMembers}" />
                <ToolbarSpacer />
                <Button
                    text="{i18n>AddNewMember}"
                    icon="sap-icon://add"
                    press="onAddNewMemberFromDialog"
                    class="myUnifiedBtn"
                />
            </OverflowToolbar>
        </customHeader>

        <content>
            <VBox class="sapUiSmallMargin">
                <SearchField
                    id="memberSearchField"
                    width="100%"
                    placeholder="{i18n>Searchbynamerelationship}"
                    liveChange="onMemberSearch"
                    search="onMemberSearch"
                    class="sapUiTinyMarginBottom"
                />

                <Table
                    id="memberSelectTable"
                    mode="MultiSelect"
                    items="{BookingView>/MasterMembers}"
                    noDataText="{i18n>Nosavedmembersavailable}"
                    growing="true"
                    growingScrollToLoad="true"
                    updateFinished="onMemberDialogTableUpdateFinished"
                    selectionChange="onMemberSelectionChange"
                >
                    <columns>
                        <Column width="{= ${device>/system/phone} ? '50%' : 'auto'}"><Text text="{i18n>MVDname}" /></Column>
                        <Column ><Text text="{i18n>age}" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>MVgender}" /></Column>
                        <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>Relationship}" /></Column>
                        <!-- <Column minScreenWidth="Desktop" demandPopin="true"><Text text="Document Type" /></Column> -->
                        <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>document}" /></Column>
<Column
>
</Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{= (${BookingView>Salutation} ? ${BookingView>Salutation} + ' ' : '') + (${BookingView>Name} || '')}" />
                                <Text text="{path: 'BookingView>Age', formatter: '.Formatter.formatAgeFromDOBOrAge'}" />
                                <Text text="{BookingView>Gender}" />
                                <Text text="{BookingView>Relation}" />
                                <!-- <Text text="{BookingView>DocumentType}"  emptyIndicatorMode="On"/> -->
                                <!-- <Text text="{BookingView>DocumentName}" /> -->
                                <Link
                                text="{i18n>view}"
                                press="MS_viewimage"
                                class="documentLink"
                            />
                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    tooltip="{i18n>editMember}"
                                    press="onEditMemberFromDialog"
                                    class="myUnifiedBtn"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>

        <beginButton>
            <Button
                text="{i18n>AddSelected}"
                press="onConfirmMemberSelection"
                class="myUnifiedBtn"
            />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>actionCancel}"
                press="onCloseMemberSelectionDialog"
                class="myUnifiedBtn"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

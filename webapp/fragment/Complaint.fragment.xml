<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:u="sap.ui.unified"
>
	<Dialog
        title="{i18n>raiseNewComplaint}"
        contentWidth="450px"
        afterClose="onCloseComplaintDialog"
    >
		<content>
			<f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
            >
				<f:content>
					<Label
                        text="{i18n>CDBranch}"
                        required="true"
                    />
					<ComboBox
                        id="idBranchCombo"
                        placeholder="{i18n>selectBranch_ae4f}"
                        selectedKey="{complaintTemp>/BranchCode}"
                        items="{
        path: 'profileData>/BranchCombo'
    }"
                        required="true"
                        width="100%"
                        valueStateText="{i18n>PselectBranch}"
                        change="onComBranch"
                    >
						<core:Item
                            key="{profileData>BranchCode}"
                            text="{profileData>BranchName}"
                        />
					</ComboBox>
					<Label
                        text="{i18n>roomNo}"
                        required="true"
                    />
					<ComboBox
                        id="idComplaintRoom"
                        placeholder="{i18n>MB_selectRoomNo}"
                        selectedKey="{complaintTemp>/RoomNo}"
                        items="{
                            path: 'complaintTemp>/RoomCombo'
                        }"
                        required="true"
                        change="onComplaintRoomChange"
                        valueStateText="{i18n>selectRoomNo}"
                    >
						<core:Item
                            key="{complaintTemp>RoomNo}"
                            text="{complaintTemp>RoomNo}"
                        />
					</ComboBox>
					<Label text="{i18n>customerName}" required="true"/>
					<ComboBox
    change="onChangeAddCustomer"
    id="MP_id_AddCustComboBox"
    showButton="true"
    items="{customerbookingdata>/}"
    valueStateText="{i18n>selectCustomer}"
    showSecondaryValues="true"
    selectedKey="{complaintTemp>/CustomerName}"
>
						<core:ListItem
        key="{customerbookingdata>CustomerName}"
        text="{customerbookingdata>CustomerName}"
        additionalText="{customerbookingdata>BookingID}"
    />
					</ComboBox>
					<Label text="{i18n>bookingID}" required="true"/>
					<ComboBox
    change="onChangeBookingID"
    id="MP_id_AddBooking"
    showButton="true"
    items="{customerbookingdata>/}"
    valueStateText="{i18n>selectBookingID}"
    showSecondaryValues="true"
    selectedKey="{complaintTemp>/BookingID}"
>
						<core:ListItem
        key="{customerbookingdata>BookingID}"
        text="{customerbookingdata>BookingID}"
        additionalText="{customerbookingdata>Status}"
    />
					</ComboBox>
					<!-- <Label text="Complaint Type" required="true" /><ComboBox
                        id="idComplaintType"
                        required="true"
                        valueStateText="Please select complaint type"
                    ><items><core:Item key="Bathroom Issue" text="Bathroom Issue"/><core:Item key="Electrical Issue" text="Electrical Issue"/><core:Item key="Room Cleaning" text="Room Cleaning"/></items></ComboBox> -->
					<Label
                        text="{i18n>ComplaintType}"
                        required="true"
                    />
					<ComboBox
                        id="idComplaintType"
                        placeholder="{i18n>selectComplaintType}"
                        width="100%"
                        required="true"
                        selectedKey="{complaintTemp>/ComplaintType}"
                        value="{complaintTemp>/ComplaintType}"
                        valueStateText="{i18n>MB_selectComplaintType}"
                        change="onComplaintTypeChange"
                        items="{
        path: 'ComplaintTypeModel>/'
    }"
                    >
						<core:Item
                            key="{ComplaintTypeModel>key}"
                            text="{ComplaintTypeModel>text}"
                        />
					</ComboBox>
					<Label
                        text="{i18n>description}"
                        required="true"
                    />
					<TextArea
                        id="idComplaintDesc"
                        rows="4"
                        growing="true"
                        width="100%"
                        placeholder="{i18n>MB_describeIssue}"
                        value="{complaintTemp>/Description}"
                        liveChange="onComplaintDescLiveChange"
                        valueStateText="{i18n>enterComplaint}"
                        maxLength="200"
                    />
					<Label text="{i18n>uploadImage}" />
					<VBox width="100%">
						<MessageStrip
                            text="{i18n>messageComplaintAttachment}"
                            showIcon="true"
                            type="Warning"
                        />
						<Table
                            id="idComplaintAttachmentTable"
                            items="{complaintTemp>/Documents}"
                            width="100%"
                            noDataText="{i18n>noDocumentUploaded}"
                        >
							<headerToolbar>
								<OverflowToolbar>
									<Title text="{i18n>image}" />
									<ToolbarSpacer />
									<u:FileUploader
                                        id="idComplaintFileUploader"
                                        buttonOnly="true"
                                        buttonText="{i18n>MVDupload}"
                                        uploadOnChange="false"
                                        fileType="jpg,jpeg,png"
                                        change="onComplaintFileChange"
                                        class="myUnifiedBtn"
                                    />
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column>
									<Text text="{i18n>filename}" />
								</Column>
								<!-- <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>image}" /></Column> -->
								<Column
                                    minScreenWidth="Tablet"
                                    demandPopin="true"
                                    popinDisplay="Inline"
                                >
									<Text text="{i18n>size}" />
								</Column>
								<Column
                                    hAlign="Center"
                                    width="3rem"
                                >
									<Text text="" />
								</Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<HBox>
											<BusyIndicator
                                                visible="{= ${complaintTemp>ProcessingActive} === true }"
                                            />
											<Link
                                                visible="{= ${complaintTemp>ProcessingActive} !== true }"
                                                text="{complaintTemp>FileName}"
                                                press="onComplaintPreviewDoc"
                                                tooltip="{path:'complaintTemp>', formatter:'.Formatter.fileTooltip'}"
                                                wrapping="true"
                                                class="tealTextLink"
                                            />
										</HBox>
										<Text
                                            visible="{= ${complaintTemp>ProcessingActive} !== true }"
                                            text="{path:'complaintTemp>size', formatter:'.Formatter.formatFileSize'}"
                                        />
										<Button
                                            visible="{= ${complaintTemp>ProcessingActive} !== true }"
                                            icon="sap-icon://delete"
                                            class="myUnifiedBtn"
                                            press="onComplaintDeleteDoc"
                                            tooltip="{i18n>Remove}"
                                        />
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</VBox>
				</f:content>
			</f:SimpleForm>
		</content>
		<beginButton>
			<Button
                text="{= ${complaintTemp>/isEditMode} ? 'Update' : 'Submit' }"
                class="myUnifiedBtn"
                press="onSaveComplaint"
            />
		</beginButton>
		<endButton>
			<Button
                text="{i18n>actionCancel}"
                class="myUnifiedBtn"
                press="onCloseComplaintDialog"
            />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
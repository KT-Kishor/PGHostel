<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
>
    <Dialog
        id="editFacilityDialog"
        afterClose=".onEditDialogClose"
        contentWidth="28rem"
        contentHeight="auto"
        draggable="true"   
    >
        <customHeader>
            <Bar class="barheader">
                <contentMiddle>
                    <Title text="{i18n>editFacility}" />
                </contentMiddle>
            </Bar>
        </customHeader>
        <f:SimpleForm
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="3"
            labelSpanM="4"
            labelSpanS="12"
            columnsXL="2"
            columnsL="2"
            columnsM="1"
        >
            <f:content>
                <!-- Facility Name -->
                
                <Label
                    text="{i18n>facilityname}"
                    required="true"
                />
                <ComboBox
                    id="editFacilityName"
                    placeholder="{i18n>selectFacility}"
                    items="{Facilities>/}"
                    selectedKey="{edit>/FacilityName}"
                    selectionChange="onFacilityChange"
                    width="100%"
                    valueStateText="{i18n>pleaseSelectFacilityName}"
                    showSecondaryValues="true"
                >
                    <core:ListItem
                        key="{Facilities>FacilityName}"
                        text="{Facilities>FacilityName}"
                        additionalText="{Facilities>FacilityChargeType}"
                    />
                </ComboBox>

                  <Label
                    text="Name"
                    required="true"
                />
                <ComboBox
                    id="editMembername"
                    placeholder="Select Name"
                    items="{CustomerData>/AllMembers}"
                    value="{edit>/MemberName}"
                    change="onMemberNameChange"
                    width="100%"
                    valueStateText="Please Select Name"
                >
                    <core:Item
                        key="{CustomerData>Name}"
                        text="{CustomerData>Name}"
                    />
                </ComboBox>

                <!-- Unit Type -->
                <Label
                    text="{i18n>unitType}"
                    required="true"
                />
                <ComboBox
                    id="idUnitType"
                    visible="false"
                    placeholder="{i18n>selectUnitType}"
                    items="{RateType>/}"
                    value="{edit>/UnitText}"
                    change="onUnitTextChange"
                    width="100%"

                    valueStateText="{i18n>plaeseSelectUnit}"
                >
                    <core:Item
                        key="{RateType>RateType}"
                        text="{RateType>RateType}"
                    />
                </ComboBox>

                 
                <Label text="{i18n>quantity}"
                   required="true" />
                <Input
                    id="editquantity"
                    value="{edit>/quantity}"
                    maxLength="2"
                    visible="{= ${edit>/UnitText} === 'Unit Price' }"
                    placeholder="Enter Quantity"
                    valueStateText="Enter Quantity"
                    liveChange=".onQuantityLiveChange"

                />
                    <RadioButtonGroup id="id_Period" columns="2" select=".onPeriodTypeSelect" 
                        visible="{= ${edit>/UnitText} === 'Unit Price' || ${edit>/UnitText} === 'Package Price' }"
                        editable="false"
                          >
                                <buttons>
                                    <RadioButton text="Daily" />
                                    <RadioButton text="Entire Booking" />
                                </buttons>
                            </RadioButtonGroup> 

                <!-- Facility Price -->
                <Label text="{i18n>faciltyprice}" />
                <Input
                    id="editPrice"
                    value="{edit>/Price}"
                    type="Number"
                    editable="false"
                />

                <!-- Currency -->
                <Label text="{i18n>currency}" />
                <ComboBox
                    enabled="false"
                    id="FU_id_Currency"
                    selectedKey="{edit>/Currency}"
                    items="{CurrencyModel>/}"
                    valueStateText="{i18n>selectCurrency}"
                    width="100%"
                    change=".onCurrecnyChange"
                    placeholder="{i18n>selectCurrency}"
                >
                    <core:Item
                        key="{CurrencyModel>currency}"
                        text="{CurrencyModel>currency}"
                    />
                </ComboBox>

                <!-- Start Date -->
                <Label
                    text="{i18n>startDate}"
                    required="true"
                />
                <DatePicker
                    id="editStartDate"
                    value="{edit>/StartDate}"
                    displayFormat="dd/MM/yyyy"
                    valueFormat="yyyy-MM-dd"
                    change="onEditDateChange"
                    minDate="{CustomerData>/minStartDate}"
                    maxDate="{CustomerData>/minEndDate}"
                    valueStateText="{i18n>plaeseSelectDate}"
                />

                <Label
                    text="{i18n>howmany}"
                    visible="{= ${edit>/UnitText} !== 'Per Day' &amp;&amp; ${edit>/UnitText} !== 'Per Hour' &amp;&amp; ${edit>/UnitText} !== 'Unit Price' }"
                />
<Select
    id="idMonthYearSelectFragment"
    width="100%"
    visible="{= ${edit>/UnitText} !== 'Per Day'
        &amp;&amp; ${edit>/UnitText} !== 'Per Hour'
        &amp;&amp; ${edit>/UnitText} !== 'Unit Price'
        &amp;&amp; ${edit>/SelectionMode} !== 'PERSON_QTY'}"
    selectedKey="{edit>/TotalUnits}"
    change=".onMonthYearChange"
    items="{MonthYear>/values}"
>
    <core:Item
        key="{MonthYear>key}"
        text="{MonthYear>text}"
    />

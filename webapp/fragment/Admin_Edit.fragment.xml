                <!-- End Date -->
                <Label
                    text="{i18n>endDate}"
                    required="true"
                />
                <DatePicker
                    id="editEndDate"
                    editable="{= ${edit>/UnitText} !== 'Per Month' &amp;&amp; ${edit>/UnitText} !== 'Per Year' }"
                    value="{path:'edit>/EndDate'}"
                    displayFormat="dd/MM/yyyy"
                    valueFormat="dd/MM/yyyy"
                    change="onEditDateChange"
                    maxDate="{CustomerData>/minEndDate}"

                    valueStateText="{i18n>plaeseSelectDate}"
                />
                <!-- Days -->
                <Label text="{i18n>days}" />
                <Input
                    id="editDays"
                    value="{edit>/TotalDays}"
                    editable="false"
                />
                <Label
                    text="{i18n>startTime}"
                    required="true"
                />

                <TimePicker
                    id="editStartTime"
                    value="{edit>/StartTime}"
                    change="onEditTimeChange"
                    displayFormat="HH"
                    valueFormat="HH"
                    valueStateText="{i18n>pleaseselectTime}"
                    visible="{= ${edit>/UnitText} === 'Per Hour'}"
                    class="Time"
                />
                <Label
                    text="{i18n>endTime}"
                    required="true"
                />

                <TimePicker
                    id="editEndTime"
                    value="{edit>/EndTime}"
                    displayFormat="HH"
                    valueFormat="HH"
                    change="onEditTimeChange"
                    valueStateText="{i18n>pleaseselectTime}"
                    visible="{= ${edit>/UnitText} === 'Per Hour'}"
                />
                <Label text="{i18n>hours}" />
                <Input
                    id="editHours"
                    value="{edit>/TotalHour}"
                    editable="false"
                    visible="{= ${edit>/UnitText} === 'Per Hour'}"
                />
                  <Label
        text="Add CouponCode"
        class="sapUiSmallMarginEnd" visible="false"
    />
                  <HBox
    alignItems="Center"
    justifyContent="SpaceEvenly" visible="false"
>
  

    <Input
        id="ID_editCouponCode"
        value="{edit>/CouponCode}"
        placeholder="Enter Coupon Code"
        width="200px"
        class="sapUiSmallMarginEnd"
        showValueHelp="true"
        valueHelpIconSrc="sap-icon://decline"
        valueHelpRequest="oncancelFacilityCoupon"
        liveChange="onCouponLiveChange"
    />

    <Button
        id="idApplyNowButton"
        text="{i18n>applyNow}"
        tooltip="{i18n>applyCoupon}"
        press=".onEditCouponCodeLiveChange"
        class="myUnifiedBtn"
     
    />
</HBox>

                 <Label text="Discount Value" visible="false"/>
                <Input
                    id="idD_editDiscountValue"
                    value="{edit>/CouponDiscount}"
                    editable="false" visible="false"
                />

            </f:content>
        </f:SimpleForm>
        <beginButton>
            <Button
                text="{i18n>save}"
                tooltip="{i18n>save}"
                press=".onEditFacilitySave"
                class="myUnifiedBtn"
            />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>CancelButton}"
                tooltip="{i18n>CancelButton}"
                press="onEditDialogClose"
                class="myUnifiedBtn"
            />
        </endButton>
    </Dialog>

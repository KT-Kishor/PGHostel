<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog
        id="advertisementPreviewDialog"
        title="{i18n>advertisements}"
        contentWidth="80vw"
        contentHeight="70vh"
        stretch="{device>/system/phone}"
        draggable="true"
        resizable="true"
        horizontalScrolling="false"
        verticalScrolling="false"
        afterOpen=".onAdvertisementPreviewAfterOpen"
        afterClose=".onAdvertisementPreviewAfterClose"
        class="advertisementPreviewDialog">
        <content>
            <Carousel
                id="advertisementPreviewCarousel"
                width="100%"
                height="100%"
                showPageIndicator="false"
                arrowsPlacement="Content"
                loop="true"
                pages="{path:'AdvertisementModel>/Advertisements', templateShareable:false}">
                <pages>
                    <Image
                        src="{AdvertisementModel>image}"
                        alt="{AdvertisementModel>title}"
                        tooltip="{AdvertisementModel>title}"
                        width="100%"
                        height="100%"
                        decorative="false"
                        densityAware="false"
                        class="advertisementPreviewImage"
                        press=".onAdvertisementPreviewImagePress"/>
                </pages>
            </Carousel>
        </content>
        <endButton>
            <Button
                text="{i18n>close}"
                press=".onCloseAdvertisementPreview"
                class="myUnifiedBtn"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>

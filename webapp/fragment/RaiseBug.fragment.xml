<c:FragmentDefinition
	xmlns="sap.m"
	xmlns:c="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified">

	<Dialog id="RG_id_Dialog"
		type="Message"
		class="sapUiContentPadding"
		contentWidth="28rem"
		resizable="true"
		draggable="true">

		<customHeader>
			<Bar class="barheader">
				<contentMiddle>
					<Title text="{i18n>raisebug}"/>
				</contentMiddle>
			</Bar>
		</customHeader>

		<f:SimpleForm
			editable="true"
			layout="ResponsiveGridLayout"
			labelSpanXL="4"
			labelSpanL="3"
			labelSpanM="4"
			labelSpanS="12"
			columnsXL="2"
			columnsL="2"
			columnsM="1">

			<f:content>

				<!-- Issue Name -->
				<!-- <Label text="{i18n>issuename}" required="true"/>
				<Input
					id="RB_id_"
					placeholder="{i18n>enterissuename}"
					value="{SupportModel>/IssueName}"
                    liveChange="onIssuenamechanges"
					maxLength="100"/> -->

				<!-- Issue Type -->
				<Label text="{i18n>appname}" required="true"/>
				<ComboBox
					id="RB_id_appname"
                    valueStateText="{i18n>enterappname}"
					placeholder="{i18n>selectIssueType}"
                    value="{RaiseBugModel>/AppName}"
                    change="onAppnamechanges"
                     items="{ApplicationName>/}">
					<core:Item key="{ApplicationName>ID}" text="{ApplicationName>AppName}"/>
					
				</ComboBox>

				<!-- Issue Description -->
				<Label text="{i18n>bugdetails}" required="true"/>
				<TextArea
					id="RB_id_bugDescription"
					rows="4"
                    liveChange="onBugdescriptionchnages"
                    valueStateText="{i18n>describeIssue}"
					placeholder="{i18n>enterBugDescription}"
					value="{RaiseBugModel>/BugDescription}"
					maxLength="500"/>

				<!-- Raised By -->
				<Label text="{i18n>raisedby}"/>
				<Input
					id="RB_id_RaisedBy"
                    liveChange="onBugRaisedby"
					value="{RaiseBugModel>/RaisedBy}"
					editable="false"
					placeholder="{i18n>enterName}"/>

				<!-- Email -->
				<Label text="{i18n>contactemail}" />
				<Input
					id="RB_id_Email"
					type="Email"
					class="sapUiSmallMarginBottom"
					editable="false"
					value="{RaiseBugModel>/Email}"
					placeholder="{i18n>enterEmail}"/>

				 <!-- Upload Image -->
				<Label id="idAddImageLabel" text="{i18n>addImage}" />

			<VBox id="RB_id_ImageBox" alignItems="Start" width="100%" renderType="Bare">

    <!-- Upload Button -->
    <HBox width="100%">
        <u:FileUploader
            id="RB_id_FileUploader1"
            fileType="jpg,jpeg,png"
            change="onSupportrequestChange"
            buttonOnly="true"
			class="myUnifiedBtn"
            iconFirst="true"
            buttonText="{i18n>UploadImages}"
            multiple="true"
            uploadOnChange="false"/>
    </HBox>

    <!-- Tokens (stacked vertically) -->
    <List
        id="RB_id_TokenList1"
        width="100%"
        class="sapUiSmallMarginTop myUnifiedBtn"
        items="{tokenModel>/tokens}"
        mode="Delete"
        delete="onTokenDelete">
        <StandardListItem
            title="{tokenModel>text}"
            type="Active"/>
    </List>

</VBox>
	<Label text="{i18n>comments}" required="true"/>
				<TextArea
					id="RB_id_comments"
					rows="4"
                    liveChange="onCommentsChange"
                    valueStateText="{i18n>enterTheComments}"
					placeholder="{i18n>enterComments}"
					value="{RaiseBugModel>/Comments}"
					maxLength="300"/>

			</f:content>
		</f:SimpleForm>

		<footer>
			<Toolbar>
				<ToolbarSpacer/>
				<Button
					text="{i18n>submit}"
					press="onBugSubmit"
					class="marginRight myUnifiedBtn"/>
				<Button
					text="{i18n>actionCancel}"
					press="RB_onCancelButtonPress"
					class="marginRight myUnifiedBtn"/>
			</Toolbar>
		</footer>

	</Dialog>

</c:FragmentDefinition>
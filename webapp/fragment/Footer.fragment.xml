<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox
        id="footerWrapper"
        class="footer-wrapper">

        <OverflowToolbar class="footer-shell">

            <!-- Developer text -->
            <HBox
                class="footer-scroll-text footer-inner"
                alignItems="Center">

                <core:HTML
                    content="&lt;div class='footer-marquee'&gt;
                        &lt;a href='https://www.kalpavrikshatechnologies.com/'
                        class='footer-text'
                        target='_blank'&gt;
                        Developed by Kalpavriksha Technologies
                        &lt;/a&gt;
                        &lt;/div&gt;" />

            </HBox>

            <ToolbarSpacer />

            <!-- Desktop Terms -->
            <Link
                id="desktopTermsLink"
                text="Terms and Conditions"
                class="_link desktopFooterItem"
                press="onPrivacyPolicyPress" />

            <!-- Desktop Vendor Registration -->
            <Button
                id="desktopVendorButton"
                text="Vendor Registration"
                icon="sap-icon://employee"
                tooltip="{i18n>adminVendorRegistration}"
                press="onAdminSIGNUP"
                class="fa-admin-btn desktopFooterItem" />

            <!-- Instagram -->
            <core:HTML
                content="&lt;a href='https://www.instagram.com/stayvriksha/'
                target='_blank'&gt;
                &lt;i class='fab fa-instagram social-icon'&gt;&lt;/i&gt;
                &lt;/a&gt;" />

            <!-- Mobile 3-dot -->
            <Button
                id="mobileFooterMenuButton"
                icon="sap-icon://overflow"
                type="Transparent"
                press="onFooterMenuPress"
                class="mobileFooterMenu _link" />

        </OverflowToolbar>

    </VBox>

</core:FragmentDefinition>
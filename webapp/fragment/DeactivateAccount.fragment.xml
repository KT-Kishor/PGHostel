<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="deactivateAccountDialog"
        title="{i18n>deactivateAccount}"
        contentWidth="680px"
        stretch="false"
        class="deactivateAccountDialog"
        afterClose="onDeactivateAccountAfterClose"
        escapeHandler=".onDeactivateAccountEscape"
    >
        <content>
            <VBox class="deactivateDialogContent">
                <HBox
                    justifyContent="Center"
                    class="deactivateIconBox"
                >
                    <core:Icon
                        src="sap-icon://warning"
                        class="deactivateWarningIcon"
                    />
                </HBox>

                <Title
                    text="{i18n>deactivateAccount}"
                    level="H3"
                    class="deactivateDialogTitle"
                />

                <MessageStrip
                    text="{i18n>deactivateAccountWarning}"
                    type="Warning"
                    showIcon="true"
                    class="deactivateMessageStrip"
                />

                <Text
                    text="{i18n>deactivateConsequenceIntro}"
                    class="deactivateIntroText"
                />

                <VBox class="deactivateConsequenceList">
                    <HBox
                        alignItems="Start"
                        class="deactivateConsequenceItem"
                    >
                        <core:Icon
                            src="sap-icon://log"
                            class="deactivateConsequenceIcon"
                        />
                        <Text
                            text="{i18n>deactivateConsequenceAccess}"
                            wrapping="true"
                            class="deactivateConsequenceText"
                        />
                    </HBox>

                    <HBox
                        alignItems="Start"
                        class="deactivateConsequenceItem"
                    >
                        <core:Icon
                            src="sap-icon://delete"
                            class="deactivateConsequenceIcon"
                        />
                        <Text
                            text="{i18n>deactivateConsequenceDeleted}"
                            wrapping="true"
                            class="deactivateConsequenceText deactivateConsequenceStrong"
                        />
                    </HBox>

                    <HBox
                        alignItems="Start"
                        class="deactivateConsequenceItem"
                    >
                        <core:Icon
                            src="sap-icon://database"
                            class="deactivateConsequenceIcon"
                        />
                        <Text
                            text="{i18n>deactivateConsequenceInaccessible}"
                            wrapping="true"
                            class="deactivateConsequenceText"
                        />
                    </HBox>

                    <HBox
                        alignItems="Start"
                        class="deactivateConsequenceItem"
                    >
                        <core:Icon
                            src="sap-icon://locked"
                            class="deactivateConsequenceIcon"
                        />
                        <Text
                            text="{i18n>deactivateConsequenceRecovery}"
                            wrapping="true"
                            class="deactivateConsequenceText"
                        />
                    </HBox>
                </VBox>

                <HBox
                    width="100%"
                    alignItems="Start"
                    class="deactivateAckRow"
                >
                    <CheckBox
                        id="id_deactivateAck"
                        selected="{deactivateModel>/acknowledged}"
                        class="deactivateAckCheckBox"
                    >
                        <layoutData>
                            <FlexItemData
                                growFactor="0"
                                shrinkFactor="0"
                            />
                        </layoutData>
                    </CheckBox>
                    <Label
                        text="{i18n>deactivateAcknowledgement}"
                        labelFor="id_deactivateAck"
                        wrapping="true"
                        class="deactivateAckLabel"
                    >
                        <layoutData>
                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                            />
                        </layoutData>
                    </Label>
                </HBox>
            </VBox>
        </content>

        <buttons>
            <Button
                id="id_deactivateConfirmBtn"
                text="{i18n>deactivateAccount}"
                type="Reject"
                enabled="{= ${deactivateModel>/acknowledged} }"
                press="onDeactivateAccountConfirm"
                class="deactivateConfirmBtn"
            />
            <Button
                id="id_deactivateCancelBtn"
                text="{i18n>CancelButton}"
                press="onDeactivateAccountCancel"
                class="myUnifiedBtn"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>

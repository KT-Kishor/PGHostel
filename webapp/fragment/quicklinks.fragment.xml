<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <VBox class="svFooter" width="100%">

        <!-- Insurance Banner -->
        <HBox
            class="svInsuranceBanner"
            alignItems="Center"
            justifyContent="SpaceBetween"
            wrap="Wrap">

            <VBox class="svInsuranceText">
                <Title
                    text="Protect your health and your trips"
                    level="H4"
                    class="svInsuranceTitle"/>

                <Text
                    text="Insurance is offered by our licensed partners. StayVriksha is not an insurer."/>
            </VBox>

            <HBox
                alignItems="Center"
                wrap="Wrap"
                class="svInsuranceButtons">

                <Button
                    text="Buy health insurance"
                    icon="sap-icon://heart"
                    press="onBuyHealthInsurance"
                    class="myUnifiedBtn insuranceBuyBtn insuranceIconGap"/>

                <Button
                    text="Buy travel insurance"
                    icon="sap-icon://shield"
                    press="onBuyTravelInsurance"
                    class="myUnifiedBtn insuranceBuyBtn insuranceIconGap"/>
            </HBox>
        </HBox>

        <!-- Main Footer -->
        <HBox
            class="svFooterMain"
            width="100%"
            wrap="Wrap"
            justifyContent="SpaceBetween"
            alignItems="Start">

            <!-- Company Information -->
            <VBox class="svFooterColumn svBrandColumn">
                <HBox
                    class="svBrandLogo"
                    alignItems="Center">

                  
<Image
        src="../image/Tree.png" 
        width="40px" 
        height="30px"
        class="svBrandIcon" />
                    <FormattedText
                        htmlText="&lt;strong&gt;&lt;span style='color:#ff8c18'&gt;Stay&lt;/span&gt;&lt;span style='color:#008b96'&gt;Vriksha&lt;/span&gt;&lt;/strong&gt;"
                        class="svBrandName"/>
                        
                </HBox>

                <Text
                    text="Find hostels, hotels, PGs and apartments you can trust."
                    class="svBrandDescription"/>

                <Title text="Follow us" level="H5"/>

             <HBox
    renderType="Bare"
    class="svSocialLinks kvSocial"
    alignItems="Center"
    wrap="Wrap"
>
  <core:HTML content="&lt;a href='https://www.linkedin.com/company/kalpavriksha-technologies/' target='_blank' rel='noopener noreferrer' aria-label='LinkedIn'&gt;&lt;i class='fa-brands fa-linkedin-in'&gt;&lt;/i&gt;&lt;/a&gt;" />
<core:HTML content="&lt;a href='https://www.youtube.com/@KalpavrikshaTechnologies' target='_blank' rel='noopener noreferrer' aria-label='YouTube'&gt;&lt;i class='fa-brands fa-youtube'&gt;&lt;/i&gt;&lt;/a&gt;" />
<core:HTML content="&lt;a href='https://wa.me/919686145959?text=Hello%20Kalpavriksha%20Technologies' target='_blank' rel='noopener noreferrer' aria-label='WhatsApp'&gt;&lt;i class='fa-brands fa-whatsapp'&gt;&lt;/i&gt;&lt;/a&gt;" />
<core:HTML content="&lt;a href='https://www.whatsapp.com/channel/0029Vb9zvuvHAdNa1W6yDX1u' target='_blank' rel='noopener noreferrer' aria-label='WhatsApp Channel'&gt;&lt;i class='fa-solid fa-bullhorn'&gt;&lt;/i&gt;&lt;/a&gt;" />
<core:HTML content="&lt;a href='https://www.instagram.com/kalpavrikshatechnologies/' target='_blank' rel='noopener noreferrer' aria-label='Instagram'&gt;&lt;i class='fa-brands fa-instagram'&gt;&lt;/i&gt;&lt;/a&gt;" />
</HBox>
            </VBox>

            <!-- Quick Links -->
            <VBox class="svFooterColumn">
                <Title text="Quick links" level="H5"/>
                <Link text="Home" press="onfooterhometabselect"/>
                <Link text="Rooms" press="onfootertabselect"/>
                <Link text="Contact" press="onfootercontacttabselect"/>
                <Link text="User Manual" press="onUsermanualPress"/>
                <Link text="Vendor Registration" press="onAdminSIGNUP"/>
            </VBox>

            <!-- Policies -->
            <VBox class="svFooterColumn">
                <Link
                    text="Policies"
                    press="onPoliciesPress"
                    class="svFooterColumnTitle"/>
                <Link text="Terms &amp; Conditions" press="onPolicyLinkPress">
                    <customData>
                        <core:CustomData
                            key="policyId"
                            value="terms"
                            writeToDom="true"/>
                    </customData>
                </Link>
                <Link text="Privacy Policy" press="onPolicyLinkPress">
                    <customData>
                        <core:CustomData
                            key="policyId"
                            value="privacy"
                            writeToDom="true"/>
                    </customData>
                </Link>
                <Link text="Cancellation &amp; Refund" press="onPolicyLinkPress">
                    <customData>
                        <core:CustomData
                            key="policyId"
                            value="refund"
                            writeToDom="true"/>
                    </customData>
                </Link>
                <Link text="Vendor Policy" press="onPolicyLinkPress">
                    <customData>
                        <core:CustomData
                            key="policyId"
                            value="vendor"
                            writeToDom="true"/>
                    </customData>
                </Link>
                <Link text="Grievance Redressal" press="onPolicyLinkPress">
                    <customData>
                        <core:CustomData
                            key="policyId"
                            value="grievance"
                            writeToDom="true"/>
                    </customData>
                </Link>
            </VBox>

            <!-- Contact Information -->
            <VBox class="svFooterColumn svContactColumn">
                <Title text="Contact us" level="H5"/>

                <HBox alignItems="Start" class="svContactRow">
                    <core:Icon src="sap-icon://email" size="1rem" class="globecss"/>
                    <VBox>
                        <Text text="Email"/>
                        <Link
                            text="admin@stayvriksha.in"
                            href="mailto:admin@stayvriksha.in"/>
                    </VBox>
                </HBox>

                <HBox alignItems="Start" class="svContactRow">
                    <core:Icon src="sap-icon://map" size="1rem" class="globecss"/>
                    <VBox>
                        <Text text="Address"/>
                        <Text
                            text="111, Kalpavriksha Karekal Layout, Near Railway Bridge, Kalaburagi, Karnataka – 585102"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- Copyright Bar -->
        <HBox
            class="svFooterBottom"
            alignItems="Center"
            justifyContent="SpaceBetween"
            wrap="Wrap">

            <Text text="© 2026 StayVriksha. All rights reserved." class="bottomtextcolor"/>
<!-- 
            <FormattedText
                htmlText="Developed by &lt;strong&gt;Kalpavriksha Technologies&lt;/strong&gt;"/> -->
                
                <core:HTML
                    content="&lt;div class='myUnifiedBtn'&gt;
                        &lt;a href='https://www.kalpavrikshatechnologies.com/'
                        class='footer-text'
                        target='_blank'&gt;
                        {i18n&gt;devlopby}
                        &lt;/a&gt;
                        &lt;/div&gt;" />

            <HBox alignItems="Center" class="svLanguageSelector">
                <core:Icon src="sap-icon://globe" size="1.5rem" class="globecss"/>
                <ComboBox
                    selectedKey="en"
                    width="7rem"
                    change="onLanguagePress"
                    class="comboBoxcss"
                    >
                    <core:Item key="en" text="English"/>
                    <core:Item key="kn" text="ಕನ್ನಡ"/>
                    <core:Item key="hi" text="हिन्दी"/>
                </ComboBox>
            </HBox>
            
        </HBox>

    </VBox>
</core:FragmentDefinition>
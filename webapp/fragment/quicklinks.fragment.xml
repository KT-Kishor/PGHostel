<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <VBox class="svFooter" width="100%">

        <!-- Insurance Banner -->
        <HBox
            class="svInsuranceBanner"
            alignItems="Center"
            justifyContent="SpaceBetween"
            wrap="Wrap">

            <VBox class="svInsuranceText">
                <Title
                    text="{i18n>Protectyourhealthandyourtrips}"
                    level="H4"
                    class="svInsuranceTitle"/>

                <Text
                    text="{i18n>InsuranceisofferedbyourlicensedpartnersStayVrikshaisnotaninsurer}"/>
            </VBox>

            <HBox
                alignItems="Center"
                wrap="Wrap"
                class="svInsuranceButtons">

                <Button
                    text="{i18n>Buyhealthinsurance}"
                    icon="sap-icon://heart"
                    press="onBuyHealthInsurance"
                    class="myUnifiedBtn insuranceBuyBtn insuranceIconGap"/>

                <Button
                    text="{i18n>Buytravelinsurance}"
                    icon="sap-icon://shield"
                    press="onBuyTravelInsurance"
                    class="insuranceBuyBtn insuranceIconGap traveltest"/>
            </HBox>
        </HBox>

        <!-- Main Footer -->
        <HBox
            class="svFooterMain"
            width="100%"
            wrap="Wrap"
            justifyContent="SpaceBetween"
            alignItems="Start">

            <!-- Company Information -->
            <VBox class="svFooterColumn svBrandColumn">
                <HBox
                    class="svBrandLogo"
                    alignItems="Center">

                  
<Image
        src="../image/Tree.png" 
        width="40px" 
        height="30px"
        class="svBrandIcon" />
                 <FormattedText
    htmlText="{i18n>stayVrikshaBrand}"
    class="svBrandName"/>
                        
                </HBox>

                <Text
                    text="{i18n>FindhostelshotelsPGsandapartmentsyoucantrust}"
                    class="svBrandDescription"/>

                <Title text="{i18n>Followus}" level="H5"/>

             <HBox
    renderType="Bare"
    class="svSocialLinks kvSocial"
    alignItems="Center"
    wrap="Wrap"
>
  <core:HTML content="&lt;a href='https://www.linkedin.com/company/kalpavriksha-technologies/' target='_blank' rel='noopener noreferrer' aria-label='LinkedIn'&gt;&lt;i class='fa-brands fa-linkedin-in'&gt;&lt;/i&gt;&lt;/a&gt;" />
<core:HTML content="&lt;a href='https://www.youtube.com/@KalpavrikshaTechnologies' target='_blank' rel='noopener noreferrer' aria-label='YouTube'&gt;&lt;i class='fa-brands fa-youtube'&gt;&lt;/i&gt;&lt;/a&gt;" />
<core:HTML content="&lt;a href='https://wa.me/919686145959?text=Hello%20Kalpavriksha%20Technologies' target='_blank' rel='noopener noreferrer' aria-label='WhatsApp'&gt;&lt;i class='fa-brands fa-whatsapp'&gt;&lt;/i&gt;&lt;/a&gt;" />
<core:HTML content="&lt;a href='https://www.whatsapp.com/channel/0029Vb9zvuvHAdNa1W6yDX1u' target='_blank' rel='noopener noreferrer' aria-label='WhatsApp Channel'&gt;&lt;i class='fa-solid fa-bullhorn'&gt;&lt;/i&gt;&lt;/a&gt;" />
<core:HTML content="&lt;a href='https://www.instagram.com/StayVriksha/' target='_blank' rel='noopener noreferrer' aria-label='Instagram'&gt;&lt;i class='fa-brands fa-instagram'&gt;&lt;/i&gt;&lt;/a&gt;" />
</HBox>
            </VBox>

            <!-- Quick Links -->
            <VBox class="svFooterColumn">
                <Title text="{i18n>Quicklinks}" level="H5"/>
                <Link text="{i18n>quickHome}" press="onfooterhometabselect" class="tealTextLink svFooterWhiteLink"/>
                <Link text="{i18n>rooms}" press="onfootertabselect" class="tealTextLink svFooterWhiteLink"/>
                <Link text="{i18n>contact}" press="onfootercontacttabselect" class="tealTextLink svFooterWhiteLink"/>
                <Link text="{i18n>userManualTitle}" press="onUsermanualPress" class="tealTextLink svFooterWhiteLink"/>
                <Link text="{i18n>adminVendorRegistration}" press="onAdminSIGNUP" class="tealTextLink svFooterWhiteLink"/>
            </VBox>

            <!-- Policies -->
            <VBox class="svFooterColumn">
                <Link
                    text="{i18n>policiesTitle}"
                    press="onPoliciesPress"
                    class="svFooterColumnTitle tealTextLink svFooterWhiteLink"  />
                <Link text="{i18n>policyLinkTerms}" press="onPolicyLinkPress" class="tealTextLink svFooterWhiteLink">
                    <customData>
                        <core:CustomData
                            key="policyId"
                            value="terms"
                            writeToDom="true"/>
                    </customData>
                </Link>
                <Link text="{i18n>policyLinkPrivacy}" press="onPolicyLinkPress" class="tealTextLink svFooterWhiteLink">
                    <customData>
                        <core:CustomData
                            key="policyId"
                            value="privacy"
                            writeToDom="true"/>
                    </customData>
                </Link>
                <Link text="{i18n>policyLinkRefund}" press="onPolicyLinkPress" class="tealTextLink svFooterWhiteLink">
                    <customData>
                        <core:CustomData
                            key="policyId"
                            value="refund"
                            writeToDom="true"/>
                    </customData>
                </Link>
                <Link text="{i18n>policyLinkVendor}" press="onPolicyLinkPress" class="tealTextLink svFooterWhiteLink">
                    <customData>
                        <core:CustomData
                            key="policyId"
                            value="vendor"
                            writeToDom="true"/>
                    </customData>
                </Link>
                <Link text="{i18n>policyLinkGrievance}" press="onPolicyLinkPress" class="tealTextLink svFooterWhiteLink">
                    <customData>
                        <core:CustomData
                            key="policyId"
                            value="grievance"
                            writeToDom="true"/>
                    </customData>
                </Link>
            </VBox>

            <!-- Contact Information -->
            <VBox class="svFooterColumn svContactColumn">
                <Title text="{i18n>Contactus}" level="H5"/>

                <HBox alignItems="Start" class="svContactRow">
                    <core:Icon src="sap-icon://email" size="1rem" class="globecss"/>
                    <VBox>
                        <Text text="{i18n>resetPasswordEmailFilter}"/>
                        <Link
                            text="admin@stayvriksha.in"
                            href="mailto:admin@stayvriksha.in" class="tealTextLink svFooterWhiteLink"/>
                    </VBox>
                </HBox>

                <HBox alignItems="Start" class="svContactRow">
                    <core:Icon src="sap-icon://map" size="1rem" class="globecss"/>
                    <VBox>
                        <Text text="{i18n>adminBookingECAddress}"/>
                        <Text
                            text="{i18n>companyadrress}"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- Copyright Bar -->
        <HBox
            class="svFooterBottom"
            alignItems="Center"
            justifyContent="SpaceBetween"
            wrap="Wrap">

            <Text text="{i18n>2026StayVriksharightsreserved}" class="bottomtextcolor"/>
<!-- 
            <FormattedText
                htmlText="Developed by &lt;strong&gt;Kalpavriksha Technologies&lt;/strong&gt;"/> -->
           <HBox class="imagelinkcss">

    <Image
        src="../image/HPFooter1.png"
        width="30px"
        height="30px"
            class="treeLogoUp"
    />

   <core:HTML
                    content="&lt;div class='myUnifiedBtn'&gt;
                        &lt;a href='https://www.kalpavrikshatechnologies.com/'
                        class='footer-text'
                        target='_blank'&gt;
                        {i18n&gt;devlopby}
                        &lt;/a&gt;
                        &lt;/div&gt;" 
                         />

</HBox>

            <HBox alignItems="Center" class="svLanguageSelector">
                <core:Icon src="sap-icon://globe" size="1.5rem" class="globecss"/>
                <ComboBox
                    selectedKey="{langageModel>/key}"
                    width="7rem"
                    change="onLanguagePress"
                    class="comboBoxcss"
                    >
                    <core:Item key="en" text="English"/>
                    <core:Item key="kn" text="ಕನ್ನಡ"/>
                    <core:Item key="hi" text="हिन्दी"/>
                </ComboBox>
            </HBox>
            
        </HBox>

    </VBox>
</core:FragmentDefinition>
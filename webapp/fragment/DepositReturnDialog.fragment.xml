<!-- In DepositReturnDialog.fragment.xml -->
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="depositReturnDialog"
        title="{i18n>returnDeposit}"
        contentWidth="500px"
        stretch="false"
        afterClose="onDialogAfterClose"
        escapeHandler=".onDialogEscape"
    >
        <content>
            <form:SimpleForm
                id="returnForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
            >
                <!-- Booking ID (Read-only) -->
                <Label text="{i18n>bookingID}" />
                <Text
                    id="inBookingID"
                    text="{DepositView>/CurrentDeposit/BookingID}"
                />

                <!-- Customer Name (Read-only) -->
                <Label text="{i18n>customerName}" />
                <Text
                    id="inCustomerName"
                    text="{DepositView>/CurrentDeposit/CustomerName}"
                />

                <!-- Deposit Amount (Read-only) -->
                <Label text="{i18n>depositAmount}" />
                <Text
                    id="inDepositAmount"
                    text="{
                        parts: [
                            {path: 'DepositView>/CurrentDeposit/DepositAmount'},
                            {path: 'DepositView>/CurrentDeposit/DepositCurrency'}
                        ],
                        formatter: '.Formatter.formatCurrency'
                    }"
                />

                <!-- Deposit Taken By (Read-only) -->
                <Label text="{i18n>depositReceived}" />
                <Text
                    id="inDepositTakenBy"
                    text="{DepositView>/CurrentDeposit/DepositTakenBy}"
                />

                <!-- Return Amount -->
                <Label
                    text="{i18n>returnAmount}"
                    required="true"
                />
                <Input
                    id="inReturnAmount"
                    value="{
                        path: 'DepositView>/CurrentDeposit/ReturnDepositAmount'
                    }"
                    placeholder="{i18n>enterReturnAmount_dc9f}"
                    change="_validateReturnAmount"
                    liveChange="_validateReturnAmount"
                    maxLength="12"
                />

                <!-- Return Mode -->
                <Label
                    text="{i18n>returnMode}"
                    required="true"
                />
<ComboBox
    id="inReturnMode"
    selectedKey="{DepositView>/CurrentDeposit/ReturnDepositMode}"
    placeholder="{i18n>selectReturnMode}"
    change="_onReturnModeChange"
    valueStateText="{i18n>SelValid}"
>
                    <core:Item
                        key="CASH"
                        text="{i18n>cash}"
                    />
                    <core:Item
                        key="UPI"
                        text="{i18n>uPI}"
                    />
             

                </ComboBox>

                <!-- Return Transaction ID -->
                <Label
                    text="{i18n>invoiceTransactionID}"
                    required="false"
                />
                <Input
                    id="inReturnTransactionID"
                    value="{DepositView>/CurrentDeposit/ReturnDepositTransactionID}"
                    placeholder="{i18n>enterTransactionId}"
                    change="_validateTransactionID"
                    liveChange="_validateTransactionID"
                    valueStateText="{i18n>TRNTS}"
                    maxLength="30"
                />

                <!-- Return Deposit By (Auto-filled from login) -->
                <Label text="{i18n>returning}" />
                <Text
                    id="inReturnDepositBy"
                    text="{
                        path: 'LoginModel>/EmployeeName'
                    }"
                />
            </form:SimpleForm>
        </content>

        <buttons>
            <Button
                text="{i18n>returnDeposit}"
                class="myUnifiedBtn"
                press="onSaveReturn"
            />

            <Button
                text="{i18n>CancelButton}"
                press="onDialogClose"
                class="myUnifiedBtn"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>

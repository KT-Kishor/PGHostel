<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <VBox id="adminSignupForm" class="svForm" renderType="Bare"
          busy="{AdminSignupModel>/Submitting}" busyIndicatorDelay="0">
        <VBox class="svSec" renderType="Bare">
            <HBox class="svSecTitle" renderType="Bare" alignItems="Center">
                <core:Icon src="sap-icon://employee" class="svSecIcon"/>
                <Title text="{i18n>vrSecPersonal}" level="H3" wrapping="true"/>
            </HBox>
            <HBox class="svFormGrid" renderType="Bare">
                <VBox class="svFld svSpan2" renderType="Bare">
                    <Label text="{i18n>vrFullName}" required="true" labelFor="adminVendorName"/>
                    <HBox class="svPair" renderType="Bare">
                        <ComboBox id="adminSalutation" selectedKey="{AdminSignupModel>/Salutation}"
                                  width="100%" placeholder="Mr." tooltip="{i18n>vrTitleLabel}"
                                  change="onAdminChangeSalutation" valueStateText="{i18n>MVDsalutation}">
                            <core:ListItem key="Mr." text="Mr."/>
                            <core:ListItem key="Ms." text="Ms."/>
                            <core:ListItem key="Mrs." text="Mrs."/>
                            <core:ListItem key="Dr." text="Dr."/>
                        </ComboBox>
                        <HBox class="svInputShell" renderType="Bare">
                            <core:Icon src="sap-icon://employee" class="svFieldIcon"/>
                            <Input id="adminVendorName" value="{AdminSignupModel>/VendorName}"
                                   width="100%" valueLiveUpdate="true" maxLength="50"
                                   placeholder="{i18n>vrFullNamePlaceholder}"
                                   liveChange="onAdminLiveValidate" change="onAdminLiveValidate"
                                   valueStateText="{i18n>MSenterValidName}"/>
                        </HBox>
                    </HBox>
                </VBox>
                <VBox class="svFld" renderType="Bare">
                    <Label text="{i18n>vrDob}" required="true" labelFor="adminDOB"/>
                    <HBox class="svInputShell" renderType="Bare">
                        <core:Icon src="sap-icon://calendar" class="svFieldIcon"/>
                        <DatePicker id="adminDOB" value="{AdminSignupModel>/DOB}" width="100%"
                                    placeholder="DD/MM/YYYY" displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd"
                                    initialFocusedDateValue="{controller>/focusedDate}"
                                    minDate="{AdminSignupModel>/DOBMin}" maxDate="{AdminSignupModel>/DOBMax}"
                                    change="ADMIN_onChangeDOB"
                                    valueStateText="{i18n>agediff}"/>
                    </HBox>
                </VBox>
                <VBox class="svFld" renderType="Bare">
                    <Label text="{i18n>vrGender}" required="true" labelFor="adminGender"/>
                    <HBox class="svInputShell" renderType="Bare">
                        <core:Icon src="sap-icon://group" class="svFieldIcon"/>
                        <Select id="adminGender" selectedKey="{AdminSignupModel>/Gender}" width="100%"
                                forceSelection="true" change="ADMIN_onChangeGender"
                                valueStateText="{i18n>pleaseselectGender}">
                            <core:Item key="" text="{i18n>vrGenderPlaceholder}"/>
                            <core:Item key="Male" text="{i18n>vrGenderMale}"/>
                            <core:Item key="Female" text="{i18n>vrGenderFemale}"/>
                            <core:Item key="Other" text="{i18n>vrGenderOther}"/>
                        </Select>
                    </HBox>
                </VBox>
                <VBox class="svFld svSpan2" renderType="Bare">
                    <Label text="{i18n>vrEmail}" required="true" labelFor="adminEmail"/>
                    <HBox class="svInputShell" renderType="Bare">
                        <core:Icon src="sap-icon://email" class="svFieldIcon"/>
                        <Input id="adminEmail" value="{AdminSignupModel>/Email}" width="100%" type="Email"
                               valueLiveUpdate="true" maxLength="50" placeholder="{i18n>vrEmailPlaceholder}"
                               liveChange="onAdminLiveValidate" change="onAdminLiveValidate"
                               valueStateText="{i18n>MSenterValidEmail}"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>

        <VBox class="svSec" renderType="Bare">
            <HBox class="svSecTitle" renderType="Bare" alignItems="Center">
                <core:Icon src="sap-icon://map" class="svSecIcon"/>
                <Title text="{i18n>vrSecContact}" level="H3" wrapping="true"/>
            </HBox>
            <VBox renderType="Bare" visible="{= !!${AdminSignupModel>/LocationsError} }" class="sapUiSmallMarginBottom">
                <MessageStrip text="{AdminSignupModel>/LocationsError}" type="Warning" showIcon="true"/>
                <Link text="{i18n>vrRetryLocations}" press="onAdminLoadLocations" class="sapUiTinyMarginTop"/>
            </VBox>
            <HBox class="svFormGrid" renderType="Bare">
                <VBox class="svFld" renderType="Bare">
                    <Label text="{i18n>vrCountry}" required="true" labelFor="adminsignUpCountry"/>
                    <HBox class="svInputShell" renderType="Bare">
                        <core:Icon src="sap-icon://world" class="svFieldIcon"/>
                        <ComboBox id="adminsignUpCountry" width="100%"
                                  busy="{AdminSignupModel>/LocationsLoading}" busyIndicatorDelay="0"
                                  selectedKey="{AdminSignupModel>/Country}" value="{AdminSignupModel>/Country}"
                                  selectionChange="ADMIN_onChangeCountry" change="ADMIN_onChangeCountry"
                                  placeholder="{i18n>selectCountry}" valueStateText="{i18n>MVDselectcountry}"
                                  items="{path:'CountryModel>/', length:1000}" showSecondaryValues="true">
                            <core:ListItem key="{CountryModel>countryName}" text="{CountryModel>countryName}"
                                           additionalText="{CountryModel>code}"/>
                        </ComboBox>
                    </HBox>
                </VBox>
                <VBox class="svFld" renderType="Bare">
                    <Label text="{i18n>vrState}" required="true" labelFor="adminsignUpState"/>
                    <HBox class="svInputShell" renderType="Bare">
                        <core:Icon src="sap-icon://map" class="svFieldIcon"/>
                        <ComboBox id="adminsignUpState" width="100%"
                                  busy="{AdminSignupModel>/LocationsLoading}" busyIndicatorDelay="0"
                                  selectedKey="{AdminSignupModel>/State}" value="{AdminSignupModel>/State}"
                                  change="ADMIN_onChangeState" selectionChange="ADMIN_onChangeState"
                                  placeholder="{i18n>vrStatePlaceholder}" valueStateText="{i18n>MSselectState}"
                                  items="{path:'StateModel>/filtered', length:1000}">
                            <core:ListItem key="{StateModel>stateName}" text="{StateModel>stateName}"/>
                        </ComboBox>
                    </HBox>
                </VBox>
                <VBox class="svFld" renderType="Bare">
                    <Label text="{i18n>vrCity}" required="true" labelFor="adminsignUpCity"/>
                    <HBox class="svInputShell" renderType="Bare">
                        <core:Icon src="sap-icon://building" class="svFieldIcon"/>
                        <ComboBox id="adminsignUpCity" width="100%"
                                  busy="{AdminSignupModel>/LocationsLoading}" busyIndicatorDelay="0"
                                  selectedKey="{AdminSignupModel>/City}" value="{AdminSignupModel>/City}"
                                  change="ADMIN_onChangeCity" selectionChange="ADMIN_onChangeCity"
                                  placeholder="{i18n>vrCityPlaceholder}" valueStateText="{i18n>MSselectCity}"
                                  items="{path:'CityModel>/filtered', length:1000}" showSecondaryValues="true">
                            <core:ListItem key="{CityModel>cityName}" text="{CityModel>cityName}"
                                           additionalText="{CityModel>branchCode}"/>
                        </ComboBox>
                    </HBox>
                </VBox>
                <VBox class="svFld" renderType="Bare">
                    <Label text="{i18n>vrMobile}" required="true" labelFor="adminMobileNo"/>
                    <HBox class="svPairWide" renderType="Bare">
                        <ComboBox id="adminsignUpSTD" value="{AdminSignupModel>/STDCode}"
                                  width="100%" change="ADMIN_onChangeSTD" placeholder="{i18n>iSD}"
                                  tooltip="{i18n>vrCountryCode}" showSecondaryValues="true"
                                  items="{path:'CountryModel>/', length:1000}" filterSecondaryValues="true">
                            <core:ListItem key="{CountryModel>stdCode}" text="{CountryModel>stdCode}"
                                           additionalText="{CountryModel>code}"/>
                        </ComboBox>
                        <HBox class="svInputShell" renderType="Bare">
                            <core:Icon src="sap-icon://phone" class="svFieldIcon"/>
                            <Input id="adminMobileNo" value="{AdminSignupModel>/Mobile}" width="100%"
                                   type="Tel" valueLiveUpdate="true" maxLength="18" autocomplete="false"
                                   placeholder="{i18n>enterMobileNumber}" liveChange="ADMIN_onMobileLiveChange"
                                   change="ADMIN_onMobileLiveChange" valueStateText="{i18n>vrErrMobile}"/>
                        </HBox>
                    </HBox>
                </VBox>
                <VBox class="svFld svSpan2" renderType="Bare">
                    <Label text="{i18n>vrAddress}" required="true" labelFor="adminAddress"/>
                    <HBox class="svInputShell svAddressShell" renderType="Bare">
                        <core:Icon src="sap-icon://home" class="svFieldIcon"/>
                        <TextArea id="adminAddress" value="{AdminSignupModel>/Address}" width="100%"
                                  rows="3" valueLiveUpdate="true" maxLength="120"
                                  placeholder="{i18n>vrAddressPlaceholder}" liveChange="ADMIN_onAddressChange"
                                  change="ADMIN_onAddressChange"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>

        <VBox class="svSec" renderType="Bare">
            <HBox class="svSecTitle" renderType="Bare" alignItems="Center">
                <core:Icon src="sap-icon://document" class="svSecIcon"/>
                <Title text="{i18n>vrSecDocuments}" level="H3" wrapping="true"/>
                <Text text="*" class="svReqMark"/>
            </HBox>
            <HBox class="svNotice" renderType="Bare" alignItems="Center">
                <core:Icon src="sap-icon://warning" class="svNoticeIcon"/>
                <Text text="{i18n>vrDocNotice}"/>
            </HBox>
            <VBox class="svFld" renderType="Bare">
                <Label text="{i18n>vrDocStep1}" labelFor="adminDocType"/>
                <HBox class="svInputShell" renderType="Bare">
                    <core:Icon src="sap-icon://document-text" class="svFieldIcon"/>
                    <ComboBox id="adminDocType" width="100%" selectedKey="{AdminSignupModel>/CurrentDocType}"
                              enabled="{AdminSignupModel>/DocTypeEnabled}" change="onAdminDocTypeChange"
                              selectionChange="onAdminDocTypeChange" placeholder="{i18n>vrDocPlaceholder}">
                        <core:ListItem key="Government-issued Identity Proof" text="Government-issued Identity Proof"/>
                        <core:ListItem key="Property Ownership Authorisation Proof" text="Property Ownership Authorisation Proof"/>
                        <core:ListItem key="Company Registration Certificate" text="Company Registration Certificate"/>
                        <core:ListItem key="Trade Licence" text="Trade Licence"/>
                        <core:ListItem key="PG Registration" text="PG Registration"/>
                        <core:ListItem key="GST Registration Certificate" text="GST Registration Certificate"/>
                        <core:ListItem key="Bank Account Details" text="Bank Account Details"/>
                        <core:ListItem key="Organization PAN " text="Organization PAN"/>
                        <core:ListItem key="Others" text="Others"/>
                    </ComboBox>
                </HBox>
            </VBox>
            <VBox id="adminDropZone" class="svDrop" renderType="Bare" alignItems="Center">
                <customData>
                    <core:CustomData key="vendor-disabled" writeToDom="true"
                                     value="{= !${AdminSignupModel>/CurrentDocType} || ${AdminSignupModel>/ProcessingActive} || ${AdminSignupModel>/Submitting} ? 'true' : 'false' }"/>
                </customData>
                <core:Icon src="sap-icon://upload" class="svDropIcon"/>
                <Text text="{= ${AdminSignupModel>/CurrentDocType} ? ${i18n>vrDocStep2}.replace('{0}', ${AdminSignupModel>/CurrentDocType}) : ${i18n>vrDocStepBlocked} }"
                      textAlign="Center" class="svDropTitle"/>
                <Text text="{= ${AdminSignupModel>/CurrentDocType} ? ${i18n>vrDocStep2Hint} : ${i18n>vrDocStepBlockedHint} }"
                      textAlign="Center" class="svDropSub"/>
                <u:FileUploader id="adminFileUploader" class="svUploader" buttonOnly="true"
                                buttonText="{i18n>vrDocBrowse}" tooltip="{i18n>vrDocBrowse}"
                                width="100%" uploadOnChange="false" multiple="false"
                                enabled="{= !!${AdminSignupModel>/CurrentDocType} &amp;&amp; !${AdminSignupModel>/ProcessingActive} &amp;&amp; !${AdminSignupModel>/Submitting} }"
                                change="onAdminFileSelect" typeMissmatch="onAdminFileTypeMismatch"
                                fileType="jpg,jpeg,png,pdf"/>
            </VBox>
            <Text text="{AdminSignupModel>/DocumentError}" class="svErrText"
                  visible="{= !!${AdminSignupModel>/DocumentError} }"/>
            <List id="adminAttachmentTable" items="{AdminSignupModel>/Documents}" class="svFiles"
                  showSeparators="None" showNoData="false" width="100%">
                <CustomListItem>
                    <HBox class="svFileRow" renderType="Bare" alignItems="Center">
                        <BusyIndicator size="1.5rem" visible="{= !!${AdminSignupModel>isProcessing} }"/>
                        <core:Icon src="sap-icon://document-text" class="svFileIcon"
                                   visible="{= !${AdminSignupModel>isProcessing} }"/>
                        <VBox class="svFileMeta" renderType="Bare">
                            <Text text="{AdminSignupModel>FileName}" tooltip="{AdminSignupModel>FileName}"
                                  wrapping="false" class="svFileName"/>
                            <Text text="{path:'AdminSignupModel>size', formatter:'.Formatter.formatFileSize'}"
                                  class="svFileSub" visible="{= !${AdminSignupModel>isProcessing} }"/>
                        </VBox>
                        <Link text="{i18n>vrDocView}" tooltip="{i18n>vrDocView}"
                              class="tealTextLink svDocView"
                              press="onAdminPreviewDoc" visible="{= !${AdminSignupModel>isProcessing} }"/>
                        <Button icon="sap-icon://delete" tooltip="{i18n>vrDocRemove}"
                                type="Transparent" class="svDocAction svRemoveBtn myUnifiedBtn"
                                press="onAdminDeleteDoc" visible="{= !${AdminSignupModel>isProcessing} }"
                                enabled="{= !${AdminSignupModel>/ProcessingActive} &amp;&amp; !${AdminSignupModel>/Submitting} }"/>
                    </HBox>
                </CustomListItem>
            </List>
            <Text text="{i18n>vrDocEmpty}" textAlign="Center" class="svEmpty"
                  visible="{= !${AdminSignupModel>/HasDocuments} }"/>
        </VBox>

        <HBox class="svConsent" renderType="Bare" alignItems="Start">
            <CheckBox id="adminConsent" selected="{AdminSignupModel>/Consent}" select="onAdminConsentChange"
                      valueState="{= ${AdminSignupModel>/ConsentError} ? 'Error' : 'None' }"
                      ariaLabelledBy="vendorConsentText" tooltip="{i18n>vrConsentLabel}"/>
            <FormattedText id="vendorConsentText" htmlText="{i18n>vrConsentHtml}" class="svConsentText"/>
        </HBox>
        <Text text="{AdminSignupModel>/ConsentError}" class="svErrText"
              visible="{= !!${AdminSignupModel>/ConsentError} }"/>
        <HBox class="svActions" renderType="Bare" justifyContent="End" wrap="Wrap">
            <Button text="{i18n>vrBtnClear}" class="svBtn svBtnGhost" press="onClearAdminSignup"
                    enabled="{= !${AdminSignupModel>/ProcessingActive} &amp;&amp; !${AdminSignupModel>/Submitting} }"/>
            <Button id="adminRegisterButton" class="svBtn" type="Emphasized" press="onSubmitAdminSignup"
                    text="{i18n>vrBtnRegister}"
                    enabled="{= !${AdminSignupModel>/ProcessingActive} &amp;&amp; !${AdminSignupModel>/Submitting} }"/>
        </HBox>
    </VBox>
</core:FragmentDefinition>

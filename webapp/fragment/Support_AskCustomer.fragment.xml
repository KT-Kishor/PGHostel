<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="SupportAskCustomerID"
        class="sapUiContentPadding"
        contentWidth="44rem"
        stretch="{device>/system/phone}"
        initialFocus="SP_id_CustomerQuestion"
        ariaLabelledBy="SP_id_AskCustomerTitle"
    >
        <customHeader>
            <Bar class="barheader">
                <contentMiddle>
                    <Title id="SP_id_AskCustomerTitle" text="{i18n>askCustomer}" />
                </contentMiddle>
            </Bar>
        </customHeader>

        <f:SimpleForm
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="3"
            labelSpanL="3"
            labelSpanM="4"
            labelSpanS="12"
            columnsXL="1"
            columnsL="1"
            columnsM="1"
        >
            <f:content>
                <Label text="{i18n>TicketID}" />
                <Text text="{AskSupportModel>/Ticket/TicketID}" />

                <Label text="{i18n>RaisedBy}" />
                <Text text="{parts: [{path: 'AskSupportModel>/Ticket/RaisedBy'}, {path: 'AskSupportModel>/Ticket/Email'}], formatter: '.Formatter.formatAssignedNameAndEmail'}" />

                <Label text="{i18n>Issuename}" />
                <Text text="{AskSupportModel>/Ticket/IssueName}" />

                <Label text="{i18n>IssueType}" />
                <Text text="{AskSupportModel>/Ticket/IssueType}" />

                <Label text="{i18n>askCustomerQuestion}" required="true" labelFor="SP_id_CustomerQuestion" />
                <TextArea
                    id="SP_id_CustomerQuestion"
                    value="{AskSupportModel>/Question}"
                    valueLiveUpdate="true"
                    rows="5"
                    width="100%"
                    maxLength="2000"
                    placeholder="{i18n>askCustomerQuestionPlaceholder}"
                    valueStateText="{i18n>askCustomerQuestionRequired}"
                    liveChange="onDescInputLiveChange"
                />
            </f:content>
        </f:SimpleForm>

        <beginButton>
            <Button
                text="{i18n>submit}"
                tooltip="{i18n>submit}"
                press="supportAskSave"
                class="myUnifiedBtn"
            />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>CancelButton}"
                tooltip="{i18n>CancelButton}"
                press="supportAskCancel"
                class="myUnifiedBtn"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
